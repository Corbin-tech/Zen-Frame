---
import Footer from '../components/footer.astro';
import DarkModeToggle from '../components/darkModeToggle.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');
				
				document.documentElement.classList.toggle('dark', initialTheme === 'dark');
				document.documentElement.setAttribute('data-theme', initialTheme);
			})();
		</script>
		
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Initialize stores -->
		<script>
			import { initThemeStore } from '../stores/themeStore';
			import { initStores } from '../stores/todoStore';
			import { registerTaskDragDrop } from '../scripts/taskDragDrop.js';
			import { dates } from '../lib/dates';
			import JSConfetti from 'js-confetti';

			window.jsConfetti = new JSConfetti();

			document.addEventListener('alpine:init', () => {
				window.Alpine.store('theme', initThemeStore());
				initStores();
				registerTaskDragDrop(window.Alpine);
				// $dates in templates: date and time helpers from src/lib/dates.ts
				window.Alpine.magic('dates', () => dates);
			});
		</script>
		
		<style is:global>
			[x-cloak] {
				display: none !important;
			}

			/* While the theme switches, every color changes together at the same speed */
			.theme-transition,
			.theme-transition * {
				transition: background-color 150ms ease-out, 
							color 150ms ease-out, 
							border-color 150ms ease-out,
							stroke 150ms ease-out !important;
			}
			
			/* SVG consistent styling */
			svg {
				stroke: currentColor;
				fill: none;
			}
		</style>
		
		<style is:global>
			:root {
				--accent: 136, 58, 234;
				--accent-light: 224, 204, 250;
				--accent-dark: 49, 10, 101;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					white 60%
				);
				--bg-color: rgb(245 245 244);
				--card-bg: rgb(255, 255, 255);
				--cluster-bg: rgb(255, 255, 255);
				--task-bg: rgb(255, 255, 255);
				--border-color: rgb(229, 231, 235);
				--teal-primary: #0d9488;
				--teal-light: #5eead4;

				/* Cluster colors (see CLUSTER_COLORS in todoStore.ts) */
				--c-teal: #14b8a6;
				--c-indigo: #6366f1;
				--c-amber: #f59e0b;
				--c-sky: #0ea5e9;
				--c-rose: #f43f5e;
				--c-violet: #8b5cf6;
				--c-emerald: #10b981;
				--c-orange: #f97316;
				--c-none: #94a3b8;
			}
			
			:root.dark {
				--bg-color: rgb(15 23 42);
				--card-bg: rgb(30, 41, 59);
				--cluster-bg: rgb(51, 65, 85);
				--task-bg: rgb(30, 41, 59);
				--border-color: rgb(71, 85, 105);
				--teal-primary: #14b8a6;
				--teal-light: #2dd4bf;

				/* Darker steps keep the cluster colors in a readable band on dark surfaces */
				--c-teal: #0d9488;
				--c-amber: #d97706;
				--c-sky: #0284c7;
				--c-emerald: #059669;
				--c-orange: #ea580c;
				--c-none: #64748b;
			}

			html, body {
				min-height: 100vh;
				margin: 0;
				padding: 0;
				background-color: var(--bg-color);
			}
			
			html {
				font-family: system-ui, sans-serif;
			}
			code {
				font-family:
					Menlo,
					Monaco,
					Lucida Console,
					Liberation Mono,
					DejaVu Sans Mono,
					Bitstream Vera Sans Mono,
					Courier New,
					monospace;
			}
		</style>
	</head>
	<body>
		<div class="min-h-screen flex flex-col">
			<!-- Content Wrapper -->
			<div class="flex-1">
				<main class="px-3 py-4 sm:p-6">
					<div class="flex justify-end mb-4">
						<DarkModeToggle />
					</div>
					<slot />
				</main>
			</div>
			<Footer />
		</div>
	</body>
</html>