---
import Footer from '../components/footer.astro';
import '@fontsource-variable/inter';
import '../styles/preferences.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');
				
				document.documentElement.classList.toggle('dark', initialTheme === 'dark');
				document.documentElement.setAttribute('data-theme', initialTheme);

				// Accent, font, and text size from Settings, applied before the first paint
				try {
					const settings = JSON.parse(localStorage.getItem('settings') || '{}');
					if (settings.accent) document.documentElement.dataset.accent = settings.accent;
					if (settings.font) document.documentElement.dataset.font = settings.font;
					if (settings.textSize) document.documentElement.dataset.textSize = settings.textSize;
					if (settings.navLayout) document.documentElement.dataset.nav = settings.navLayout;
					document.documentElement.dataset.sidebar = settings.sidebarCollapsed ? 'collapsed' : 'open';
				} catch (e) {}
			})();
		</script>
		
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Initialize stores -->
		<script>
			import { initThemeStore } from '../stores/themeStore';
			import { initStores } from '../stores/todoStore';
			import { initSettingsStore } from '../stores/settingsStore';
			import { initGoalsStore } from '../stores/goalsStore';
			import { notify, startReminders } from '../lib/notifications';
			import { registerTaskDragDrop } from '../scripts/taskDragDrop.js';
			import { dates } from '../lib/dates';
			import JSConfetti from 'js-confetti';

			window.jsConfetti = new JSConfetti();

			document.addEventListener('alpine:init', () => {
				window.Alpine.store('theme', initThemeStore());
				window.Alpine.store('settings', initSettingsStore());
				window.Alpine.store('goals', initGoalsStore());
				initStores();
				registerTaskDragDrop(window.Alpine);
				// $dates in templates: date and time helpers from src/lib/dates.ts
				window.Alpine.magic('dates', () => dates);
			});

			// Block and due-date reminders, once every store is ready
			document.addEventListener('alpine:initialized', () => {
				window.notify = (kind, title, body) => notify(window.Alpine, kind, title, body);
				startReminders(window.Alpine);
			});
		</script>
		
		<style is:global>
			[x-cloak] {
				display: none !important;
			}

			/* While the theme switches, every color changes together at the same speed */
			.theme-transition,
			.theme-transition * {
				transition: background-color 150ms ease-out, 
							color 150ms ease-out, 
							border-color 150ms ease-out,
							stroke 150ms ease-out !important;
			}
			
			/* SVG consistent styling */
			svg {
				stroke: currentColor;
				fill: none;
			}
		</style>
		
		<style is:global>
			:root {
				--bg-color: rgb(245 245 244);
				--card-bg: rgb(255, 255, 255);
				--cluster-bg: rgb(255, 255, 255);
				--task-bg: rgb(255, 255, 255);
				--teal-primary: rgb(var(--accent-600));

				/* Ambient page glow and the frosted header */
				--glow-1: rgb(var(--accent-400) / 0.16);
				--glow-2: rgb(99 102 241 / 0.10);
				--grid-dot: rgb(15 23 42 / 0.07);
				--glass: rgb(245 245 244 / 0.72);

				/* Cluster colors (see CLUSTER_COLORS in todoStore.ts) */
				--c-teal: #14b8a6;
				--c-indigo: #6366f1;
				--c-amber: #f59e0b;
				--c-sky: #0ea5e9;
				--c-rose: #f43f5e;
				--c-violet: #8b5cf6;
				--c-emerald: #10b981;
				--c-orange: #f97316;
				--c-pink: #ec4899;
				--c-lime: #84cc16;
				--c-cyan: #06b6d4;
				--c-fuchsia: #d946ef;
				--c-none: #94a3b8;
			}
			
			:root.dark {
				--bg-color: rgb(15 23 42);
				--card-bg: rgb(30, 41, 59);
				--cluster-bg: rgb(51, 65, 85);
				--task-bg: rgb(30, 41, 59);
				--teal-primary: rgb(var(--accent-500));

				--glow-1: rgb(var(--accent-500) / 0.16);
				--glow-2: rgb(99 102 241 / 0.14);
				--grid-dot: rgb(255 255 255 / 0.05);
				--glass: rgb(15 23 42 / 0.7);

				/* Darker steps keep the cluster colors in a readable band on dark surfaces */
				--c-teal: #0d9488;
				--c-amber: #d97706;
				--c-sky: #0284c7;
				--c-emerald: #059669;
				--c-orange: #ea580c;
				--c-pink: #db2777;
				--c-lime: #65a30d;
				--c-cyan: #0891b2;
				--c-fuchsia: #c026d3;
				--c-none: #64748b;
			}

			html, body {
				min-height: 100vh;
				margin: 0;
				padding: 0;
			}

			/* Only the root paints the page color, so the glows on body::before show above it */
			html {
				background-color: var(--bg-color);
			}
			
			html {
				font-family: 'Inter Variable', system-ui, sans-serif;
				font-feature-settings: 'cv11', 'ss01';
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			/* Soft color glows and a fading dot grid behind everything */
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(40rem 28rem at 8% -6%, var(--glow-1), transparent 70%),
					radial-gradient(36rem 26rem at 96% 4%, var(--glow-2), transparent 70%);
			}
			body::after {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
				background-size: 22px 22px;
				mask-image: linear-gradient(to bottom, black, transparent 60%);
				-webkit-mask-image: linear-gradient(to bottom, black, transparent 60%);
			}

			::selection {
				background-color: rgb(var(--accent-400) / 0.3);
			}

			:focus-visible {
				outline: 2px solid var(--teal-primary);
				outline-offset: 2px;
			}

			* {
				scrollbar-width: thin;
				scrollbar-color: rgb(148 163 184 / 0.5) transparent;
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
			code {
				font-family:
					Menlo,
					Monaco,
					Lucida Console,
					Liberation Mono,
					DejaVu Sans Mono,
					Bitstream Vera Sans Mono,
					Courier New,
					monospace;
			}
		</style>
	</head>
	<body>
		<div class="min-h-screen flex flex-col">
			<!-- Content Wrapper -->
			<div class="flex-1">
				<main class="px-3 pb-8 sm:px-6">
					<slot />
				</main>
			</div>
			<Footer />
		</div>
	</body>
</html>