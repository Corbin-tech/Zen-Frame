<div x-data="{ text: '' }">
    <div class="flex flex-wrap sm:flex-nowrap gap-3 sm:gap-4">
        <input id="new-task" name="new-task" aria-label="New task"
            type="text"
            x-model="text"
            x-on:keyup.enter="if (text.trim()) { $store.todos.addTodo(text.trim()); text = '' }"
            placeholder="Add a new task..."
            class="w-full sm:w-auto sm:flex-1 min-w-0 px-4 py-2 bg-gray-50 dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 dark:text-white"
        />
        <button 
            x-on:click="$dispatch('open-quick-add', { mode: 'task', text: text.trim() }); text = ''"
            class="flex flex-1 sm:flex-none items-center justify-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors whitespace-nowrap"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Task
        </button>
        <button 
            x-on:click="$dispatch('open-quick-add', { mode: 'cluster' })"
            class="flex flex-1 sm:flex-none items-center justify-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors whitespace-nowrap"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            New Cluster
        </button>
    </div>
</div>
