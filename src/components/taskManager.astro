---
import QuickTaskInput from './QuickTaskInput.astro';
import TaskRow from './TaskRow.astro';
---

<div 
  class="w-full max-w-4xl mx-auto rounded-2xl bg-white/80 dark:bg-slate-800/70 backdrop-blur-sm shadow-sm ring-1 ring-black/5 dark:ring-white/10 p-4 sm:p-8"
>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-6 sm:mb-8 text-gray-900 dark:text-white">Task Manager</h1>
    
    <!-- Quick Task Input -->
    <div class="mb-8">
        <QuickTaskInput />
    </div>
    
    <!-- Action Buttons -->
    <div class="flex justify-end mb-6">
        <button 
            x-on:click="$store.todos.deleteCompleted()"
            x-show="$store.todos.hasCompletedTasks"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 transform scale-90"
            x-transition:enter-end="opacity-100 transform scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 transform scale-100"
            x-transition:leave-end="opacity-0 transform scale-90"
            class="flex items-center gap-2 px-4 py-2 bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/40 text-red-600 dark:text-red-400 rounded-lg transition-colors duration-200"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Delete Completed
        </button>
    </div>
    
    <!-- Clusters and Tasks -->
    <div class="space-y-6 mb-8">
        <!-- Clusters -->
        <template x-for="cluster in $store.todos.clusters" :key="cluster.id">
            <div 
                class="cluster-card group rounded-xl shadow-sm border-2 border-l-4 border-gray-100 dark:border-slate-600 hover:border-teal-200 dark:hover:border-teal-800 transition-all duration-300 ease-in-out"
                x-bind:style="`background-color: var(--cluster-bg); border-left-color: ${$store.todos.clusterColor(cluster.id)};`"
                x-task-drop="$store.todos.moveTask($taskId, cluster.id)"
                x-bind:id="`item-${cluster.id}`"
            >
                <!-- Cluster Header -->
                <div class="flex items-center justify-between gap-2 p-3 sm:p-4 border-b border-gray-100 dark:border-slate-600 transition-colors duration-300 ease-in-out"
                     x-bind:class="{'bg-teal-50 dark:bg-teal-900/20': cluster.isPinned}">
                    <div class="flex items-center gap-2 sm:gap-3 flex-1 min-w-0">
                        <!-- Cluster color: the icon opens a swatch picker -->
                        <div class="relative" x-data="{ open: false }" x-on:click.outside="open = false" x-on:keydown.escape="open = false">
                            <button
                                type="button"
                                x-on:click="open = !open"
                                class="p-1.5 rounded-lg transition-colors duration-300 ease-in-out"
                                x-bind:class="{'ring-2 ring-teal-300 dark:ring-teal-700': cluster.isPinned}"
                                x-bind:style="`color: ${$store.todos.clusterColor(cluster.id)}; background-color: color-mix(in srgb, ${$store.todos.clusterColor(cluster.id)} 15%, transparent);`"
                                aria-label="Change cluster color"
                                title="Change color"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2v-12a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                            </button>
                            <div
                                x-show="open"
                                x-transition.opacity.duration.150ms
                                x-cloak
                                class="absolute left-0 top-full mt-2 z-30 p-2 rounded-xl bg-white dark:bg-slate-800 shadow-lg ring-1 ring-black/5 dark:ring-white/10 grid grid-cols-6 gap-2"
                            >
                                <template x-for="color in $store.todos.palette" :key="color">
                                    <button
                                        type="button"
                                        x-on:click="$store.todos.setClusterColor(cluster.id, color); open = false"
                                        class="w-6 h-6 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-slate-800 hover:scale-110 transition-transform"
                                        x-bind:class="[
                                            $store.todos.clusterColorKey(cluster.id) === color ? 'ring-2 ring-gray-400 dark:ring-gray-300' : '',
                                            $store.todos.colorTaken(color, cluster.id) ? 'opacity-35' : ''
                                        ]"
                                        x-bind:style="`background-color: var(--c-${color});`"
                                        x-bind:title="$store.todos.colorTaken(color, cluster.id) ? `${color}, used by another cluster` : color"
                                        x-bind:aria-label="$store.todos.colorTaken(color, cluster.id) ? `Use ${color}, already used by another cluster` : `Use ${color}`"
                                        x-bind:aria-pressed="$store.todos.clusterColorKey(cluster.id) === color"
                                    ></button>
                                </template>
                            </div>
                        </div>
                        <input name="cluster-name" aria-label="Cluster name"
                            type="text"
                            x-model="cluster.todo"
                            x-on:input="$store.todos.saveTodos()"
                            x-on:keydown.enter="$event.target.blur()"
                            x-on:blur="$store.todos.updateTask(cluster.id, { todo: cluster.todo })"
                            class="flex-1 min-w-0 text-lg font-medium bg-transparent border-none focus:ring-0 dark:text-white"
                            placeholder="Cluster Name"
                        />
                        <!-- Completed / total tasks -->
                        <span
                            x-show="$store.todos.items.some(t => t.parentId === cluster.id)"
                            class="hidden sm:inline text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 tabular-nums whitespace-nowrap"
                            x-text="`${$store.todos.items.filter(t => t.parentId === cluster.id && t.completed).length}/${$store.todos.items.filter(t => t.parentId === cluster.id).length} done`"
                        ></span>
                        <!-- Pin indicator/button -->
                        <button 
                            x-on:click="$store.todos.togglePinCluster(cluster.id)"
                            class="p-1.5 rounded-lg transition-all"
                            x-bind:class="cluster.isPinned ? 'text-teal-500 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300' : 'text-gray-400 hover:text-teal-500 hover:bg-teal-50 dark:hover:bg-teal-900/20'"
                            x-bind:title="cluster.isPinned ? 'Unpin this cluster' : 'Pin this cluster'"
                        >
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-bind:class="{'fill-current': cluster.isPinned}">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                            </svg>
                        </button>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <!-- Cluster ordering controls -->
                        <div class="flex flex-col space-y-1">
                            <button 
                                @click="$store.todos.shiftCluster(cluster.id, -1)"
                                class="p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
                                :disabled="$store.todos.isFirstCluster(cluster.id)"
                                :class="$store.todos.isFirstCluster(cluster.id) ? 'opacity-30 cursor-not-allowed' : ''"
                                aria-label="Move cluster up"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                </svg>
                            </button>
                            <button 
                                @click="$store.todos.shiftCluster(cluster.id, 1)"
                                class="p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
                                :disabled="$store.todos.isLastCluster(cluster.id)"
                                :class="$store.todos.isLastCluster(cluster.id) ? 'opacity-30 cursor-not-allowed' : ''"
                                aria-label="Move cluster down"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>
                        
                        <!-- Delete button -->
                        <button 
                            x-on:click="$store.todos.deleteTodo(cluster.id)"
                            class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg opacity-100 transition-all"
                            aria-label="Delete cluster"
                        >
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Cluster Content -->
                <div class="p-2 sm:p-4">
                    <div class="p-1 sm:p-3 space-y-2 transition-colors duration-300 ease-in-out">
                        <template x-for="task in $store.todos.items.filter(t => t.parentId === cluster.id)" :key="task.id">
                            <TaskRow />
                        </template>
                    </div>
                    <button
                        type="button"
                        x-on:click="$dispatch('open-quick-add', { mode: 'task', parentId: cluster.id })"
                        class="mt-1 ml-1 sm:ml-3 flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-sm text-gray-500 hover:text-gray-800 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-slate-700/50 transition-colors"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        <span x-text="`Add a task to ${cluster.todo}`"></span>
                    </button>
                </div>
            </div>
        </template>
        
        <!-- Main Container - All Non-Clustered Tasks -->
        <div class="flex-1 p-1 sm:p-4">
            <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                Tasks
            </h2>
            
            <div class="space-y-2 transition-colors duration-300 ease-in-out" id="mainContainer">
                <template x-for="task in $store.todos.items.filter(t => !t.parentId && !t.isCluster)" :key="task.id">
                    <TaskRow />
                </template>
            </div>
        </div>
    </div>
</div>

<style>
    #mainContainer {
        position: relative;
        padding-top: 20px;
        padding-bottom: 16px;
    }

    /* A task is being dragged over this cluster */
    .cluster-card[data-drop-active] {
        border-style: dashed;
        border-color: var(--teal-primary);
        background-color: color-mix(in srgb, var(--teal-primary) 5%, transparent) !important;
    }
</style>
