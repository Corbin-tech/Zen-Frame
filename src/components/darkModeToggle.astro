<button
    id="theme-toggle"
    type="button"
    class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-800 dark:hover:text-gray-200 transition-colors duration-300 rounded-lg text-sm p-2.5"
    x-data
    @click="$store.theme.toggle()"
    aria-label="Toggle dark mode"
>
    <svg
        id="theme-toggle-dark-icon"
        class="w-5 h-5 transition-opacity duration-300"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
        x-show="$store.theme.current === 'light'"
        x-cloak
        aria-hidden="true"
    >
        <path fill="currentColor" stroke="none" d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
    </svg>
    <svg
        id="theme-toggle-light-icon"
        class="w-5 h-5 transition-opacity duration-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        x-show="$store.theme.current === 'dark'"
        x-cloak
        aria-hidden="true"
    >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
    </svg>
</button>
