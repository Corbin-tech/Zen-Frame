---
// Kanban board: the same tasks as the Task Manager, in To do, In progress, and Done columns.
// Drag a card between columns or within one; the arrow buttons do the same from the keyboard.
const iconButton = 'p-1 rounded-md text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:text-gray-500 dark:hover:text-gray-200 dark:hover:bg-slate-700 transition-colors disabled:opacity-30 disabled:pointer-events-none';
---

<div x-data="board" class="space-y-5">
    <!-- Header -->
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-sm font-medium text-teal-700 dark:text-teal-400">Board</p>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">What's moving</h1>
            <p class="mt-1 text-gray-500 dark:text-gray-400" x-text="summary"></p>
        </div>

        <!-- Sort: list order, or by due date with overdue tasks on top -->
        <div class="inline-flex p-1 rounded-full bg-gray-900/[0.04] dark:bg-white/[0.06] ring-1 ring-black/5 dark:ring-white/10" role="group" aria-label="Sort cards">
            <template x-for="option in sortOptions" :key="option.id">
                <button
                    type="button"
                    x-on:click="sortBy = option.id"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all"
                    x-bind:class="sortBy === option.id
                        ? 'bg-white text-gray-900 shadow-sm ring-1 ring-black/5 dark:bg-white/[0.14] dark:text-white dark:ring-white/10'
                        : 'text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200'"
                    x-bind:aria-pressed="sortBy === option.id"
                >
                    <span x-text="option.label"></span>
                    <span
                        x-show="option.id === 'due' && overdueCount"
                        class="min-w-[1.25rem] px-1.5 py-0.5 rounded-full text-[11px] font-semibold tabular-nums bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300"
                        x-text="overdueCount"
                        x-bind:aria-label="`${overdueCount} overdue`"
                    ></span>
                </button>
            </template>
        </div>
    </header>

    <!-- Cluster filter -->
    <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1" role="group" aria-label="Show tasks from">
        <template x-for="chip in filterChips" :key="chip.id">
            <button
                type="button"
                x-on:click="clusterFilter = chip.id"
                class="shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium ring-1 transition-all"
                x-bind:class="clusterFilter === chip.id
                    ? 'bg-gray-900 text-white ring-gray-900 dark:bg-white dark:text-slate-900 dark:ring-white shadow-sm'
                    : 'bg-white text-gray-600 ring-black/10 hover:ring-black/20 dark:bg-slate-800 dark:text-gray-300 dark:ring-white/10 dark:hover:ring-white/20'"
                x-bind:aria-pressed="clusterFilter === chip.id"
            >
                <span x-show="chip.color" class="w-2 h-2 rounded-full" x-bind:style="`background-color: ${chip.color};`"></span>
                <span x-text="chip.label"></span>
                <span class="text-xs tabular-nums opacity-60" x-text="chip.count"></span>
            </button>
        </template>
    </div>

    <!-- Columns: side by side from md up, swipeable on small screens -->
    <div class="board-scroller flex md:grid md:grid-cols-3 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-2 -mx-1 px-1">
        <template x-for="column in columns" :key="column.id">
            <section
                class="board-column snap-start shrink-0 w-[85%] sm:w-[60%] md:w-auto min-w-0 flex flex-col rounded-2xl bg-gray-100/80 dark:bg-slate-800/50 ring-1 ring-black/5 dark:ring-white/5 p-3 transition-colors"
                x-task-drop="move($taskId, column.id)"
                x-bind:aria-label="`${column.title}, ${tasksIn(column.id).length} tasks`"
            >
                <!-- Column header -->
                <div class="flex items-center gap-2 px-1 pb-3">
                    <span class="w-2.5 h-2.5 rounded-full" x-bind:class="column.dot"></span>
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white" x-text="column.title"></h2>
                    <span class="text-xs font-medium tabular-nums px-1.5 py-0.5 rounded-md bg-white dark:bg-slate-700 text-gray-500 dark:text-gray-300 ring-1 ring-black/5 dark:ring-white/5" x-text="tasksIn(column.id).length"></span>
                    <button
                        type="button"
                        x-show="column.id !== 'done'"
                        x-on:click="startAdding(column.id)"
                        class={`${iconButton} ml-auto`}
                        x-bind:aria-label="`Add a task to ${column.title}`"
                        title="Add a task"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    </button>
                </div>

                <!-- Cards -->
                <ol class="flex-1 space-y-2 min-h-[7rem]">
                    <template x-for="task in visibleTasksIn(column.id)" :key="task.id">
                        <li
                            x-data="{ edge: null, editing: false }"
                            class="board-card group/card relative rounded-xl bg-white dark:bg-slate-700/70 shadow-sm ring-1 ring-black/5 dark:ring-white/5 hover:shadow-md hover:ring-black/10 dark:hover:ring-white/10 transition-all"
                            x-bind:class="[
                                edge && sortBy === 'manual' ? `drop-${edge}` : '',
                                isOverdue(task) ? '!ring-red-500/40 dark:!ring-red-400/40' : ''
                            ]"
                            x-drag-task="task.id"
                            x-task-drop="dropOnCard($taskId, column.id, task.id, $clientY > $el.getBoundingClientRect().top + $el.offsetHeight / 2)"
                            x-on:task-dragover="edge = $event.detail.clientY > $el.getBoundingClientRect().top + $el.offsetHeight / 2 ? 'bottom' : 'top'"
                            x-on:task-dragleave="edge = null"
                        >
                            <!-- Cluster color along the left edge -->
                            <span class="absolute left-0 top-3 bottom-3 w-1 rounded-r-full" x-bind:style="`background-color: ${$store.todos.clusterColor(task.parentId)};`"></span>

                            <div data-drag-handle class="cursor-grab active:cursor-grabbing p-3 pl-4">
                                <div class="flex items-start gap-2.5">
                                    <!-- Done toggle -->
                                    <button
                                        type="button"
                                        x-on:click="toggleDone(task)"
                                        class="mt-0.5 w-[18px] h-[18px] shrink-0 grid place-items-center rounded-full ring-[1.5px] transition-colors"
                                        x-bind:class="task.completed
                                            ? 'bg-teal-600 text-white ring-teal-600 dark:bg-teal-500 dark:ring-teal-500'
                                            : 'text-transparent ring-gray-300 hover:ring-teal-500 hover:text-teal-500 dark:ring-slate-500'"
                                        x-bind:aria-label="`Mark ${task.todo || 'task'} ${task.completed ? 'not done' : 'done'}`"
                                    >
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                    </button>

                                    <!-- Title: double-click to rename -->
                                    <div class="min-w-0 flex-1">
                                        <p
                                            x-show="!editing"
                                            x-on:dblclick="editing = true; $nextTick(() => $refs.title.focus())"
                                            class="text-sm font-medium leading-snug break-words"
                                            x-bind:class="task.completed ? 'line-through text-gray-400 dark:text-gray-500' : 'text-gray-900 dark:text-gray-100'"
                                            x-text="task.todo || 'Untitled task'"
                                            title="Double-click to rename"
                                        ></p>
                                        <textarea
                                            x-show="editing"
                                            x-cloak
                                            x-ref="title"
                                            name="board-task-name"
                                            aria-label="Task name"
                                            rows="2"
                                            x-model="task.todo"
                                            x-on:keydown.enter.prevent="$el.blur()"
                                            x-on:keydown.escape="$el.blur()"
                                            x-on:blur="editing = false; $store.todos.updateTask(task.id, { todo: task.todo })"
                                            class="block w-full p-0 text-sm font-medium leading-snug bg-transparent border-none resize-none focus:ring-0 text-gray-900 dark:text-gray-100"
                                        ></textarea>
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="mt-2.5 pl-7 flex flex-wrap items-center gap-1.5 text-xs">
                                    <span
                                        x-show="task.parentId"
                                        class="inline-flex items-center gap-1 max-w-[10rem] px-1.5 py-0.5 rounded-md font-medium"
                                        x-bind:style="`color: ${$store.todos.clusterColor(task.parentId)}; background-color: color-mix(in srgb, ${$store.todos.clusterColor(task.parentId)} 12%, transparent);`"
                                    >
                                        <span class="truncate" x-text="$store.todos.clusterName(task.parentId)"></span>
                                    </span>
                                    <span
                                        x-show="task.dueDate"
                                        class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md font-medium"
                                        x-bind:class="task.dueDate ? $dates.dueClass(task.dueDate, task.completed) : ''"
                                        x-text="task.dueDate ? $dates.dueLabel(task.dueDate) : ''"
                                    ></span>
                                    <span x-show="repeats(task.id)" class="inline-flex items-center text-gray-400 dark:text-gray-500" title="Repeats on the schedule">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                        <span class="sr-only">Repeats</span>
                                    </span>
                                    <span x-show="column.id === 'doing' && task.startedAt" class="text-gray-400 dark:text-gray-500" x-text="task.startedAt ? `Started ${$dates.daysAgoText($dates.toDateKey(new Date(task.startedAt)))}` : ''"></span>
                                    <span x-show="column.id === 'done' && task.completedAt" class="text-gray-400 dark:text-gray-500" x-text="task.completedAt ? `Done ${$dates.daysAgoText($dates.toDateKey(new Date(task.completedAt)))}` : ''"></span>
                                </div>
                            </div>

                            <!-- Card actions: shown on hover or keyboard focus -->
                            <div class="absolute top-2 right-2 flex items-center gap-0.5 rounded-lg bg-white/90 dark:bg-slate-700/90 backdrop-blur-sm opacity-0 group-hover/card:opacity-100 focus-within:opacity-100 transition-opacity">
                                <button type="button" class={iconButton} x-on:click="step(task, -1)" x-bind:disabled="column.id === 'todo'" x-bind:aria-label="`Move ${task.todo || 'task'} left`" title="Move left">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                                </button>
                                <button type="button" class={iconButton} x-on:click="step(task, 1)" x-bind:disabled="column.id === 'done'" x-bind:aria-label="`Move ${task.todo || 'task'} right`" title="Move right">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                </button>
                                <button type="button" class={`${iconButton} hover:!text-red-500`} x-on:click="$store.todos.deleteTodo(task.id)" x-bind:aria-label="`Delete ${task.todo || 'task'}`" title="Delete">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                </button>
                            </div>
                        </li>
                    </template>

                    <!-- Empty column -->
                    <li
                        x-show="!tasksIn(column.id).length && adding !== column.id"
                        class="board-empty h-full min-h-[7rem] grid place-items-center rounded-xl border-2 border-dashed border-gray-200 dark:border-slate-700 px-4 text-center text-sm text-gray-400 dark:text-gray-500"
                        x-text="column.empty"
                    ></li>
                </ol>

                <!-- New card -->
                <form
                    x-show="adding === column.id"
                    x-cloak
                    x-on:submit.prevent="addTask(column.id)"
                    class="mt-2 rounded-xl bg-white dark:bg-slate-700/70 shadow-sm ring-1 ring-teal-500/40 p-2"
                >
                    <textarea
                        x-bind:id="`board-new-${column.id}`"
                        x-bind:name="`board-new-${column.id}`"
                        aria-label="New task"
                        rows="2"
                        x-model="newTask"
                        x-on:keydown.enter.prevent="addTask(column.id)"
                        x-on:keydown.escape="adding = null"
                        placeholder="What needs doing?"
                        class="block w-full p-1 text-sm bg-transparent border-none resize-none focus:ring-0 text-gray-900 dark:text-white placeholder-gray-400"
                    ></textarea>
                    <div class="flex items-center justify-end gap-2 pt-1">
                        <button type="button" x-on:click="adding = null" class="px-2.5 py-1 text-xs font-medium rounded-md text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-slate-600">Cancel</button>
                        <button type="submit" class="px-2.5 py-1 text-xs font-medium rounded-md bg-teal-600 text-white hover:bg-teal-700 shadow-sm">Add</button>
                    </div>
                </form>

                <button
                    type="button"
                    x-show="column.id !== 'done' && adding !== column.id"
                    x-on:click="startAdding(column.id)"
                    class="mt-2 flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-sm text-gray-500 hover:text-gray-800 hover:bg-white/70 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-slate-700/50 transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Add a task
                </button>

                <button
                    type="button"
                    x-show="column.id === 'done' && tasksIn('done').length > doneLimit"
                    x-on:click="doneLimit = Infinity"
                    class="mt-2 px-2 py-1.5 rounded-lg text-sm font-medium text-teal-700 dark:text-teal-400 hover:bg-white/70 dark:hover:bg-slate-700/50 transition-colors"
                    x-text="`Show ${tasksIn('done').length - doneLimit} more`"
                ></button>
            </section>
        </template>
    </div>
</div>

<script>
    // Columns in order. A task's column comes from $store.todos.boardColumn().
    const COLUMNS = [
        { id: 'todo', title: 'To do', dot: 'bg-slate-400', empty: 'Nothing waiting. Add a task or drag one here.' },
        { id: 'doing', title: 'In progress', dot: 'bg-amber-500', empty: 'Drag a task here when you start it.' },
        { id: 'done', title: 'Done', dot: 'bg-teal-500', empty: 'Finished tasks land here.' }
    ];
    const ORDER = COLUMNS.map(column => column.id);
    const DONE_LIMIT = 8;
    const FILTER_KEY = 'boardCluster';
    const SORT_KEY = 'boardSort';

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('board', () => ({
            columns: COLUMNS,
            clusterFilter: localStorage.getItem(FILTER_KEY) || 'all',
            adding: null,
            newTask: '',
            doneLimit: DONE_LIMIT,
            sortOptions: [
                { id: 'manual', label: 'My order' },
                { id: 'due', label: 'Overdue first' }
            ],
            sortBy: localStorage.getItem(SORT_KEY) === 'due' ? 'due' : 'manual',

            init() {
                this.$watch('clusterFilter', (value) => localStorage.setItem(FILTER_KEY, value));
                this.$watch('sortBy', (value) => localStorage.setItem(SORT_KEY, value));
            },

            // A saved filter for a cluster that was deleted shows everything
            get activeFilter() {
                const { clusterFilter } = this;
                if (clusterFilter === 'all' || clusterFilter === 'none') return clusterFilter;
                return this.$store.todos.find(clusterFilter)?.isCluster ? clusterFilter : 'all';
            },

            get tasks() {
                const filter = this.activeFilter;
                return this.$store.todos.items.filter(item => !item.isCluster && (
                    filter === 'all' || (filter === 'none' ? !item.parentId : item.parentId === filter)
                ));
            },

            // Chip counts are open tasks
            get filterChips() {
                const open = this.$store.todos.openTasks;
                const chips = [
                    { id: 'all', label: 'All', color: '', count: open.length },
                    ...this.$store.todos.clusters.map(cluster => ({
                        id: cluster.id,
                        label: cluster.todo,
                        color: this.$store.todos.clusterColor(cluster.id),
                        count: open.filter(task => task.parentId === cluster.id).length
                    }))
                ];
                const loose = open.filter(task => !task.parentId).length;
                if (loose) chips.push({ id: 'none', label: 'No cluster', color: 'var(--c-none)', count: loose });
                return chips;
            },

            get summary() {
                const doing = this.tasksIn('doing').length;
                const todo = this.tasksIn('todo').length;
                if (!doing && !todo) return 'Everything here is done. Nice work.';
                const parts = [`${doing} in progress`, `${todo} to do`];
                if (this.overdueCount) parts.push(`${this.overdueCount} overdue`);
                return parts.join(' · ');
            },

            isOverdue(task) {
                return !task.completed && Boolean(task.dueDate) && this.$dates.dueTone(task.dueDate) === 'overdue';
            },

            get overdueCount() {
                return this.tasks.filter(task => this.isOverdue(task)).length;
            },

            // Done shows the most recently finished first. The other columns follow list order,
            // or with "Overdue first" go by due date (most overdue on top, undated last).
            tasksIn(column) {
                const tasks = this.tasks.filter(task => this.$store.todos.boardColumn(task) === column);
                if (column === 'done') {
                    return tasks.sort((a, b) => (b.completedAt ?? '').localeCompare(a.completedAt ?? ''));
                }
                if (this.sortBy !== 'due') return tasks;
                return tasks.sort((a, b) => (a.dueDate || '9999-12-31').localeCompare(b.dueDate || '9999-12-31'));
            },

            visibleTasksIn(column) {
                const tasks = this.tasksIn(column);
                return column === 'done' ? tasks.slice(0, this.doneLimit) : tasks;
            },

            repeats(taskId) {
                return this.$store.todos.scheduledItems.some(item => item.taskId === taskId && item.repeat);
            },

            // Dropped on a card: land just above or below it. Sorted views only change the column.
            // The column underneath also gets the drop; by then the task is already in it.
            dropOnCard(taskId, column, targetId, after) {
                const placed = column !== 'done' && this.sortBy === 'manual';
                this.move(taskId, column, placed ? targetId : undefined, after);
            },

            // Dropped on a column's empty space (no target): change column, keep list position
            move(taskId, column, targetId, after = false) {
                const task = this.$store.todos.find(taskId);
                if (!task) return;
                const finishing = column === 'done' && !task.completed;
                this.$store.todos.moveToColumn(taskId, column, targetId, after);
                if (finishing) this.celebrate();
            },

            step(task, direction) {
                const next = ORDER[ORDER.indexOf(this.$store.todos.boardColumn(task)) + direction];
                if (next) this.move(task.id, next);
            },

            toggleDone(task) {
                if (task.completed) {
                    this.$store.todos.toggleTodo(task.id);
                } else {
                    this.move(task.id, 'done');
                }
            },

            startAdding(column) {
                this.adding = column;
                this.newTask = '';
                this.$nextTick(() => document.getElementById(`board-new-${column}`)?.focus());
            },

            // New tasks join the cluster being shown
            addTask(column) {
                const text = this.newTask.trim();
                if (!text) return;
                const filter = this.activeFilter;
                this.$store.todos.addTodo(text, {
                    parentId: filter === 'all' || filter === 'none' ? null : filter,
                    ...(column === 'doing' ? { startedAt: new Date().toISOString() } : {})
                });
                this.newTask = '';
            },

            celebrate() {
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                window.jsConfetti?.addConfetti({
                    confettiColors: ['#0d9488', '#14b8a6', '#2dd4bf', '#f59e0b', '#FFFFFF'],
                    confettiNumber: 60
                });
            }
        }));
    });
</script>

<style>
    /* A task is being dragged over this column */
    .board-column[data-drop-active] {
        background-color: color-mix(in srgb, var(--teal-primary) 8%, transparent);
        box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--teal-primary) 45%, transparent);
    }

    /* Where a dropped card will land */
    .board-card.drop-top::before,
    .board-card.drop-bottom::after {
        content: '';
        position: absolute;
        left: 0.5rem;
        right: 0.5rem;
        height: 3px;
        border-radius: 9999px;
        background-color: var(--teal-primary);
    }
    .board-card.drop-top::before { top: -6px; }
    .board-card.drop-bottom::after { bottom: -6px; }

    /* The card being dragged */
    .board-card[data-drag-active="true"] {
        opacity: 0.5;
    }

    .board-scroller {
        scrollbar-width: thin;
    }
</style>
