            <path d="M0 600 C220 570 420 615 620 592 S880 580 1000 600 L1000 700 L0 700 Z" class="fill-[#aebfe9] dark:fill-[#1a173a]" opacity="0.9" />

            <!-- Flocks: each bird flaps at its own pace -->
            <g fill="none" class="stroke-slate-600 dark:stroke-slate-300" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.6">
                {flocks.map(group => (
                    <g>
                        <animateMotion path={group.path} dur={`${group.duration}s`} begin={`${group.delay}s`} repeatCount="indefinite" />
