                    </circle>
                    <circle cx={x} cy={y} r="3" class="fill-white dark:fill-[#fefce8]" />
                </g>
            ))}

            <!-- Moon, low enough to survive the crop on wide cards -->
            <circle cx="830" cy="175" r="95" fill="url(#zb-glow)">
                <animate attributeName="r" values="88; 102; 88" dur="10s" repeatCount="indefinite" />
            </circle>
            <circle cx="830" cy="175" r="42" class="fill-[#f6b93b] dark:fill-[#fde68a]" mask="url(#zb-crescent)" />

            <!-- Rolling hills -->
            <path d="M0 550 C150 510 300 570 460 538 S760 490 1000 546 L1000 700 L0 700 Z" class="fill-[#97a4ea] dark:fill-[#101b45]" />
            <path d="M0 592 C200 562 380 610 560 582 S860 558 1000 592 L1000 700 L0 700 Z" class="fill-[#7a89dd] dark:fill-[#0a1230]" />
        </svg>
