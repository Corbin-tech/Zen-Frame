---
// Moving scenes behind Zen mode, picked in Settings (zenBackground in settingsStore.ts).
// Each is an SVG that fills the card and animates with SMIL, slowly enough not to pull focus.
// Under reduced motion the scenes are drawn but paused. Only the chosen one is rendered (x-if).

// A fixed seed, so the stars and swirls sit in the same places on every build
let seed = 7;
const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

// Swirly night: stars, and spirals that turn slowly
const stars = Array.from({ length: 70 }, () => ({
    x: random() * 1000,
    y: random() * 520,
    r: 0.8 + random() * 1.6,
    duration: 2.5 + random() * 4,
    delay: -random() * 6
}));
const brightStars = [[140, 90], [470, 70], [700, 260], [930, 420], [60, 330], [380, 440], [560, 360], [250, 520]];
const spiral = (cx: number, cy: number, radius: number, turns: number) => {
    const steps = 140;
    return Array.from({ length: steps + 1 }, (_, i) => {
        const t = i / steps;
        const angle = t * turns * Math.PI * 2;
        return `${i ? 'L' : 'M'}${(cx + Math.cos(angle) * radius * t).toFixed(1)} ${(cy + Math.sin(angle) * radius * t).toFixed(1)}`;
    }).join(' ');
};
const swirls = [
    { cx: 300, cy: 240, radius: 170, turns: 2.6, duration: 440 },
    { cx: 640, cy: 170, radius: 120, turns: 2.2, duration: 380 },
    { cx: 850, cy: 330, radius: 95, turns: 2, duration: 320 }
];
// Three strands per spiral: light-mode color first, then dark
const strands = [
    { turn: 0, width: 7, class: 'stroke-[#4338ca] [stroke-opacity:0.26] dark:stroke-[#93c5fd] dark:[stroke-opacity:0.45]' },
    { turn: 120, width: 4, class: 'stroke-[#6d7fe6] [stroke-opacity:0.24] dark:stroke-[#bfdbfe] dark:[stroke-opacity:0.3]' },
    { turn: 240, width: 3, class: 'stroke-[#d97706] [stroke-opacity:0.32] dark:stroke-[#fde68a] dark:[stroke-opacity:0.3]' }
];
const winds = [
    { y: 300, width: 12, duration: 130, class: 'stroke-[#4f5fd1] [stroke-opacity:0.14] dark:stroke-[#93c5fd] dark:[stroke-opacity:0.22]' },
    { y: 420, width: 6, duration: 160, class: 'stroke-[#d97706] [stroke-opacity:0.2] dark:stroke-[#fde68a] dark:[stroke-opacity:0.18]' },
    { y: 520, width: 12, duration: 190, class: 'stroke-[#4f5fd1] [stroke-opacity:0.14] dark:stroke-[#93c5fd] dark:[stroke-opacity:0.22]' }
];

// Koi pond: lily pads are circles with a wedge cut out
const pad = (cx: number, cy: number, r: number, cut: number) => {
    const a = cut, b = cut + 0.45;
    return `M${cx} ${cy} L${(cx + Math.cos(a) * r).toFixed(1)} ${(cy + Math.sin(a) * r).toFixed(1)} A${r} ${r} 0 1 0 ${(cx + Math.cos(b) * r).toFixed(1)} ${(cy + Math.sin(b) * r).toFixed(1)} Z`;
};
const pads = [
    { cx: 90, cy: 110, r: 62, cut: 0.6 },
    { cx: 170, cy: 60, r: 38, cut: 2.2 },
    { cx: 905, cy: 600, r: 70, cut: 3.6 },
    { cx: 820, cy: 655, r: 40, cut: 5.1 },
    { cx: 940, cy: 150, r: 34, cut: 1.4 }
];
const koi = [
    { body: 'koi-kohaku', path: 'M120 520 C300 380 520 620 760 470 S980 200 700 160 S300 260 120 520 Z', duration: 46, delay: -8, scale: 1.25, swim: 1.8 },
    { body: 'koi-ogon', path: 'M880 600 C640 640 420 420 260 300 S120 90 380 120 S820 380 880 600 Z', duration: 58, delay: -30, scale: 1.05, swim: 2.1 },
    { body: 'koi-showa', path: 'M500 650 C300 600 200 450 330 380 S620 420 640 560 S600 680 500 650 Z', duration: 36, delay: -12, scale: 0.85, swim: 1.6 }
];
// A drop lands and its rings spread and fade, then the spot rests until its next drop.
// Each kind of drop differs: how many rings, how far apart, how wide, how flat, how often.
const RIPPLE_KINDS = {
    triple: { size: 100, rings: 3, gap: 1.1, flat: 0.42, cycle: 38, width: 2.4 },
    double: { size: 78, rings: 2, gap: 1.5, flat: 0.45, cycle: 33, width: 2.2 },
    wide: { size: 125, rings: 1, gap: 0, flat: 0.36, cycle: 44, width: 2 },
    cluster: { size: 62, rings: 4, gap: 0.6, flat: 0.5, cycle: 32, width: 1.8 },
    drizzle: { size: 26, rings: 2, gap: 0.5, flat: 0.48, cycle: 21, width: 1.4 }
};
const rippleSpots: { x: number; y: number; delay: number; kind: keyof typeof RIPPLE_KINDS }[] = [
    { x: 260, y: 190, delay: 0, kind: 'triple' },
    { x: 720, y: 560, delay: -9, kind: 'wide' },
    { x: 520, y: 330, delay: -19, kind: 'double' },
    { x: 150, y: 600, delay: -25, kind: 'cluster' },
    { x: 860, y: 300, delay: -4, kind: 'double' },
    { x: 400, y: 560, delay: -5, kind: 'drizzle' },
    { x: 640, y: 120, delay: -12, kind: 'drizzle' },
    { x: 340, y: 90, delay: -17, kind: 'drizzle' },
    { x: 960, y: 470, delay: -2, kind: 'drizzle' }
];
// Rings take about 20% longer to spread than before; small drops spread a little faster
const ripples = rippleSpots.map(spot => {
    const kind = RIPPLE_KINDS[spot.kind];
    const grow = 9.6 * (0.7 + 0.3 * kind.size / 80);
    return {
        ...spot,
        ...kind,
        grow,
        keyTimes: `0; ${(grow / kind.cycle).toFixed(3)}; 1`,
        lags: Array.from({ length: kind.rings }, (_, i) => i * kind.gap)
    };
});

// Birds: two loose flocks and a straggler
const flock = [[0, 0, 1.6, 0], [-28, -13, 1.75, -0.3], [-28, 13, 1.5, -0.6], [-56, -24, 1.85, -0.2], [-56, 24, 1.65, -0.9], [-86, -6, 1.7, -0.5]];
const flocks = [
    { path: 'M-150 250 C250 210 600 300 1150 220', duration: 75, delay: -20, scale: 1 },
    { path: 'M-150 150 C300 120 700 190 1150 130', duration: 100, delay: -70, scale: 0.65 },
    { path: 'M-150 340 C350 320 650 360 1150 310', duration: 120, delay: -45, scale: 0.5 }
];
const clouds = [
    { y: 120, scale: 1.2, duration: 220, delay: -60 },
    { y: 200, scale: 0.8, duration: 260, delay: -170 },
    { y: 80, scale: 0.6, duration: 300, delay: -20 },
    { y: 260, scale: 1, duration: 240, delay: -120 }
];
// Rainy window: a street blurred behind the glass, water running down it, a sill inside
const rainStreaks = Array.from({ length: 30 }, () => ({
    x: random() * 1060 - 30,
    length: 16 + random() * 22,
    duration: 4.2 + random() * 2.6,
    delay: -random() * 6,
    opacity: 0.08 + random() * 0.12
}));
const STREET_LIGHTS = [
    'fill-[#fde68a] dark:fill-[#fbbf24]',
    'fill-[#fecaca] dark:fill-[#fb7185]',
    'fill-[#e0f2fe] dark:fill-[#fef3c7]',
    'fill-[#fed7aa] dark:fill-[#f97316]'
];
const streetLights = Array.from({ length: 14 }, (_, i) => ({
    x: 30 + i * 70 + random() * 30,
    y: 430 + random() * 90,
    r: 10 + random() * 24,
    tone: STREET_LIGHTS.at(i % STREET_LIGHTS.length),
    duration: 7 + random() * 9,
    delay: -random() * 9
}));
// Rooftops across the street, and the windows lit in them at night
const buildings: { x: number; width: number; top: number }[] = [];
for (let x = -20; x < 1020;) {
    const width = 50 + random() * 70;
    buildings.push({ x, width, top: 250 + random() * 140 });
    x += width;
}
const skyline = `M-20 540 ${buildings.map(b => `L${b.x.toFixed(0)} ${b.top.toFixed(0)} L${(b.x + b.width).toFixed(0)} ${b.top.toFixed(0)}`).join(' ')} L1020 540 Z`;
const litWindows = buildings.flatMap(b => Array.from({ length: 3 }, () => ({
    x: b.x + 8 + random() * (b.width - 22),
    y: b.top + 14 + random() * (500 - b.top - 30),
    opacity: 0.35 + random() * 0.5
})));
// Water on the glass: beads, and trails that drops run down, stopping where the glass holds them
const beads = Array.from({ length: 46 }, () => ({ x: random() * 1000, y: 70 + random() * 500, r: 1.4 + random() * 3.8 }));
const rivulets = Array.from({ length: 6 }, (_, i) => {
    let x = 70 + i * 165 + random() * 50;
    const start = 40 + random() * 160;
    let d = `M${x.toFixed(0)} ${start.toFixed(0)}`;
    for (let y = start + 40; y <= 570; y += 40) {
        const next = x + (random() - 0.5) * 16;
        d += ` Q${(x + (random() - 0.5) * 10).toFixed(0)} ${(y - 20).toFixed(0)} ${next.toFixed(0)} ${y.toFixed(0)}`;
        x = next;
    }
    return { d, duration: 20 + random() * 12, delay: -random() * 30, r: 3.6 + random() * 2 };
});

// Fireflies: wandering loops around a home spot, each glowing on its own beat
const fireflies = Array.from({ length: 26 }, () => {
    const x = 60 + random() * 880, y = 200 + random() * 340, dx = 30 + random() * 50, dy = 20 + random() * 40;
    return {
        path: `M${x.toFixed(0)} ${y.toFixed(0)} C${(x + dx).toFixed(0)} ${(y - dy).toFixed(0)} ${(x + dx * 1.6).toFixed(0)} ${(y + dy).toFixed(0)} ${x.toFixed(0)} ${(y + dy * 0.6).toFixed(0)} S${(x - dx * 1.4).toFixed(0)} ${(y - dy * 0.8).toFixed(0)} ${x.toFixed(0)} ${y.toFixed(0)} Z`,
        duration: 16 + random() * 14,
        delay: -random() * 20,
        glow: 2.5 + random() * 3,
        glowDelay: -random() * 5,
        r: 1.6 + random() * 1.4
    };
});
const grass = Array.from({ length: 90 }, (_, i) => ({ x: i * 11.5 + random() * 8, height: 30 + random() * 60, lean: -10 + random() * 20 }));
const duskStars = Array.from({ length: 24 }, () => ({ x: random() * 1000, y: 70 + random() * 260, r: 0.6 + random() * 1.1 }));

// Aurora: curtains of light. Each one steps through four quarter-phases of the same wave and back
// to the first, so the ripple travels sideways without a seam. The bright hems sit high, in the
// strip of sky above the task card.
const curtain = (base: number, height: number, amp: number, phase: number) => {
    const points = Array.from({ length: 9 }, (_, i) => ({
        x: -60 + i * 140,
        top: base - height + Math.sin(i * 0.8 + phase) * amp * 0.6,
        bottom: base + Math.sin(i * 0.55 + phase + 1) * amp
    }));
    const edge = (key: 'top' | 'bottom', list: typeof points) => list.slice(1).map((point, i) => {
        const prev = list.at(i)!;
        const pull = (point.x - prev.x) / 3;
        return `C${(prev.x + pull).toFixed(0)} ${prev[key].toFixed(0)} ${(point.x - pull).toFixed(0)} ${point[key].toFixed(0)} ${point.x.toFixed(0)} ${point[key].toFixed(0)}`;
    }).join(' ');
    const reversed = [...points].reverse();
    return `M${points[0].x} ${points[0].top.toFixed(0)} ${edge('top', points)} L${reversed[0].x} ${reversed[0].bottom.toFixed(0)} ${edge('bottom', reversed)} Z`;
};
const auroraBands = [
    { id: 'zb-band-1', gradient: 'zb-aurora-green', base: 150, height: 190, amp: 30, phase: 0, duration: 30, opacity: 1 },
    { id: 'zb-band-2', gradient: 'zb-aurora-teal', base: 122, height: 160, amp: 24, phase: 2.1, duration: 38, opacity: 0.8 },
    { id: 'zb-band-3', gradient: 'zb-aurora-violet', base: 96, height: 140, amp: 20, phase: 4, duration: 46, opacity: 0.65 }
].map(band => {
    const shapes = [0, 1, 2, 3, 4].map(step => curtain(band.base, band.height, band.amp, band.phase + step * Math.PI / 2));
    return { ...band, shape: shapes[0], shapes: shapes.join('; ') };
});

// Sakura: petals drifting down and tumbling, past a flowering branch
const petals = Array.from({ length: 26 }, () => {
    const x = random() * 1100 - 150, drift = 180 + random() * 260;
    return {
        path: `M${x.toFixed(0)} -40 C${(x + drift * 0.3).toFixed(0)} 180 ${(x + drift * 0.6).toFixed(0)} 400 ${(x + drift).toFixed(0)} 760`,
        duration: 18 + random() * 14,
        delay: -random() * 32,
        spin: 5 + random() * 6,
        flip: 1.8 + random() * 1.8,
        scale: 0.7 + random() * 0.7,
        light: random() < 0.5
    };
});
// The branch stays in the top-left corner, clear of the "Zen Mode" title
const blossoms = [[60, 95, 1], [110, 112, 0.9], [150, 121, 1.1], [200, 141, 0.9], [245, 168, 1.1], [300, 192, 1], [345, 203, 0.8], [150, 86, 0.8], [205, 70, 1], [250, 72, 0.8], [272, 118, 1], [322, 108, 0.9], [95, 80, 0.7], [182, 129, 0.7]];

const wingUp = 'M-12 0 Q-6 -7 0 0 Q6 -7 12 0';
const wingDown = 'M-12 2 Q-6 4 0 0 Q6 4 12 2';
---

<!-- Held still under reduced motion, while Settings is open, or when another tab is active; eases in when returning to Zen Mode -->
<div
    class="absolute inset-0 -z-10 pointer-events-none transform-gpu transition-opacity duration-500 ease-out"
    aria-hidden="true"
    x-data="{
        still: matchMedia('(prefers-reduced-motion: reduce)').matches,
        settingsOpen: false,
        // activeTab belongs to the tabs component this sits inside
        phase: activeTab === 'zenmode' ? 'active' : 'inactive',
        resumeTimer: null,
        get paused() {
            return this.still || this.settingsOpen || this.phase !== 'active';
        },
        sync() {
            this.$el.querySelectorAll('svg').forEach(svg => this.paused ? svg.pauseAnimations() : svg.unpauseAnimations());
        },
        setSettings(open) {
            this.settingsOpen = open;
            if (open) clearTimeout(this.resumeTimer);
            this.sync();
        },
        setTab(active) {
            clearTimeout(this.resumeTimer);
            if (!active) {
                this.phase = 'inactive';
                this.sync();
                return;
            }
            this.phase = 'warming';
            this.$nextTick(() => {
                // Unpause while still opacity-0 so SMIL places birds, clouds, and petals before fading in
                if (!this.still && !this.settingsOpen) {
                    this.$el.querySelectorAll('svg').forEach(svg => svg.unpauseAnimations());
                }
                this.resumeTimer = setTimeout(() => {
                    if (this.phase === 'warming') this.phase = 'active';
                    this.sync();
                }, 180);
            });
        }
    }"
    x-init="$watch('activeTab', tab => setTab(tab === 'zenmode'))"
    x-bind:class="[paused && 'zen-backdrop-held', phase === 'active' ? 'opacity-100' : 'opacity-0']"
    x-on:settings-panel.window="setSettings($event.detail.open)"
>
    <!-- Soft glow: three blurred lights drifting -->
    <template x-if="$store.settings.zenBackground === 'glow'">
        <div class="absolute inset-0">
            <span class="zen-orb absolute -top-24 -left-16 w-80 h-80 rounded-full bg-teal-400/25 blur-3xl"></span>
            <span class="zen-orb zen-orb-2 absolute -bottom-28 -right-10 w-96 h-96 rounded-full bg-indigo-400/20 blur-3xl"></span>
            <span class="zen-orb zen-orb-3 absolute top-1/3 left-1/2 w-64 h-64 rounded-full bg-fuchsia-400/10 blur-3xl"></span>
        </div>
    </template>

    <!-- Koi pond: koi circling under lily pads, light through the water, the odd ripple -->
    <template x-if="$store.settings.zenBackground === 'koi'">
        <svg class="absolute inset-0 w-full h-full stroke-none" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" x-init="(still || paused) && $el.pauseAnimations()">
            <defs>
                <linearGradient id="zb-water" x1="0" y1="0" x2="0.4" y2="1">
                    <stop offset="0" class="[stop-color:#d5f1ec] dark:[stop-color:#0c3d48]" />
                    <stop offset="1" class="[stop-color:#a8dcd5] dark:[stop-color:#05252e]" />
                </linearGradient>
                <radialGradient id="zb-caustic">
                    <stop offset="0" stop-color="#fff" stop-opacity="0.45" />
                    <stop offset="1" stop-color="#fff" stop-opacity="0" />
                </radialGradient>
                <filter id="zb-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
                <clipPath id="zb-koi-clip"><path d="M32 0 C26 -11 4 -13 -16 -7 C-24 -5 -30 -3 -34 0 C-30 3 -24 5 -16 7 C4 13 26 11 32 0 Z" /></clipPath>
                <g id="koi-fins">
                    <path d="M-32 0 L-50 -12 C-45 -4 -45 4 -50 12 Z" fill-opacity="0.85" />
                    <ellipse cx="8" cy="-12" rx="8" ry="3" transform="rotate(-35 8 -12)" fill-opacity="0.7" />
                    <ellipse cx="8" cy="12" rx="8" ry="3" transform="rotate(35 8 12)" fill-opacity="0.7" />
                </g>
                <g id="koi-kohaku">
                    <use href="#koi-fins" fill="#fff7ed" />
                    <path d="M32 0 C26 -11 4 -13 -16 -7 C-24 -5 -30 -3 -34 0 C-30 3 -24 5 -16 7 C4 13 26 11 32 0 Z" fill="#fffaf3" />
                    <g clip-path="url(#zb-koi-clip)" fill="#e2401c">
                        <ellipse cx="20" cy="-3" rx="10" ry="8" />
                        <ellipse cx="-6" cy="4" rx="12" ry="7" />
                    </g>
                </g>
                <g id="koi-ogon">
                    <use href="#koi-fins" fill="#fb923c" />
                    <path d="M32 0 C26 -11 4 -13 -16 -7 C-24 -5 -30 -3 -34 0 C-30 3 -24 5 -16 7 C4 13 26 11 32 0 Z" fill="#f97316" />
                    <g clip-path="url(#zb-koi-clip)" fill="#fff7ed"><ellipse cx="-14" cy="-6" rx="10" ry="5" /></g>
                </g>
                <g id="koi-showa">
                    <use href="#koi-fins" fill="#1f2937" />
                    <path d="M32 0 C26 -11 4 -13 -16 -7 C-24 -5 -30 -3 -34 0 C-30 3 -24 5 -16 7 C4 13 26 11 32 0 Z" fill="#fffaf3" />
                    <g clip-path="url(#zb-koi-clip)">
                        <ellipse cx="14" cy="2" rx="12" ry="8" fill="#e2401c" />
                        <ellipse cx="-10" cy="-5" rx="10" ry="6" fill="#1f2937" />
                    </g>
                </g>
            </defs>

            <rect width="1000" height="700" fill="url(#zb-water)" />

            <!-- Light moving through the water -->
            <g opacity="0.6">
                <ellipse cx="250" cy="200" rx="220" ry="120" fill="url(#zb-caustic)">
                    <animateTransform attributeName="transform" type="translate" values="0 0; 80 40; 0 0" dur="24s" repeatCount="indefinite" />
                </ellipse>
                <ellipse cx="700" cy="420" rx="260" ry="140" fill="url(#zb-caustic)">
                    <animateTransform attributeName="transform" type="translate" values="0 0; -90 -30; 0 0" dur="30s" repeatCount="indefinite" />
                </ellipse>
                <ellipse cx="480" cy="620" rx="200" ry="90" fill="url(#zb-caustic)">
                    <animateTransform attributeName="transform" type="translate" values="0 0; 60 -40; 0 0" dur="27s" repeatCount="indefinite" />
                </ellipse>
            </g>

            <!-- Koi, each with a soft shadow on the pond floor -->
            {koi.map(fish => (
                <g>
                    <animateMotion path={fish.path} dur={`${fish.duration}s`} begin={`${fish.delay}s`} rotate="auto" repeatCount="indefinite" />
                    <g transform={`scale(${fish.scale})`}>
                        <ellipse cx="4" cy="14" rx="34" ry="9" fill="#000" opacity="0.14" filter="url(#zb-soft)" />
                        <use href={`#${fish.body}`}>
                            <animateTransform attributeName="transform" type="skewY" values="-5; 5; -5" dur={`${fish.swim}s`} repeatCount="indefinite" />
                        </use>
                    </g>
                </g>
            ))}

            <!-- Ripples: rings flattened to the water's angle, thinning as they spread, with a faint shadow -->
            {ripples.map(drop => (
                <g fill="none">
                    {drop.lags.map(lag => (
                        <Fragment>
                            <ellipse cx={drop.x} cy={drop.y + 2.5} rx="0" ry="0" class="stroke-[#0f5f63]/25 dark:stroke-black/40">
                                <animate attributeName="rx" values={`0; ${drop.size}; ${drop.size}`} keyTimes={drop.keyTimes} calcMode="spline" keySplines="0.2 0.7 0.4 1; 0 0 1 1" dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="ry" values={`0; ${drop.size * drop.flat}; ${drop.size * drop.flat}`} keyTimes={drop.keyTimes} calcMode="spline" keySplines="0.2 0.7 0.4 1; 0 0 1 1" dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="stroke-width" values={`${drop.width - 0.2}; 0.3; 0.3`} keyTimes={drop.keyTimes} dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="opacity" values="0.7; 0; 0" keyTimes={drop.keyTimes} dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                            </ellipse>
                            <ellipse cx={drop.x} cy={drop.y} rx="0" ry="0" class="stroke-white/90 dark:stroke-cyan-100/60">
                                <animate attributeName="rx" values={`0; ${drop.size}; ${drop.size}`} keyTimes={drop.keyTimes} calcMode="spline" keySplines="0.2 0.7 0.4 1; 0 0 1 1" dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="ry" values={`0; ${drop.size * drop.flat}; ${drop.size * drop.flat}`} keyTimes={drop.keyTimes} calcMode="spline" keySplines="0.2 0.7 0.4 1; 0 0 1 1" dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="stroke-width" values={`${drop.width}; 0.4; 0.4`} keyTimes={drop.keyTimes} dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                                <animate attributeName="opacity" values="0.85; 0; 0" keyTimes={drop.keyTimes} dur={`${drop.cycle}s`} begin={`${drop.delay + lag}s`} repeatCount="indefinite" />
                            </ellipse>
                        </Fragment>
                    ))}
                    <!-- The drop itself, a quick glint where it lands -->
                    <circle cx={drop.x} cy={drop.y} r="0" class="fill-white/90 dark:fill-cyan-50/70">
                        <animate attributeName="r" values={`0; ${drop.size > 40 ? 3.5 : 2}; 0; 0`} keyTimes="0; 0.02; 0.07; 1" dur={`${drop.cycle}s`} begin={`${drop.delay}s`} repeatCount="indefinite" />
                    </circle>
                </g>
            ))}

            <!-- Lily pads and a lotus, swaying a little -->
            {pads.map(p => (
                <g>
                    <animateTransform attributeName="transform" type="rotate" values={`-3 ${p.cx} ${p.cy}; 3 ${p.cx} ${p.cy}; -3 ${p.cx} ${p.cy}`} dur={`${18 + p.r / 5}s`} repeatCount="indefinite" />
                    <ellipse cx={p.cx + 5} cy={p.cy + 8} rx={p.r} ry={p.r * 0.9} fill="#000" opacity="0.12" filter="url(#zb-soft)" />
