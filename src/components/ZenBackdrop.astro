                    <circle cx={light.x.toFixed(0)} cy={light.y.toFixed(0)} r={light.r.toFixed(0)} class={light.tone}>
                        <animate attributeName="opacity" values="0.5; 1; 0.5" dur={`${light.duration.toFixed(1)}s`} begin={`${light.delay.toFixed(1)}s`} repeatCount="indefinite" />
