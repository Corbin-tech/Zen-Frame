                    <ellipse rx={trail.r.toFixed(1)} ry={(trail.r * 1.2).toFixed(1)} fill="url(#zb-lens)" />
                    <circle cx={(-trail.r * 0.35).toFixed(1)} cy={(-trail.r * 0.45).toFixed(1)} r="1.3" fill="#fff" opacity="0.9" />
