                            {flock.map(([x, y, flap, delay]) => (
                                <path d={wingUp} transform={`translate(${x} ${y})`}>
                                    <animate attributeName="d" values={`${wingUp}; ${wingDown}; ${wingUp}`} dur={`${flap}s`} begin={`${delay}s`} repeatCount="indefinite" />
