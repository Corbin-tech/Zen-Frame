                    <circle cx={bead.x.toFixed(1)} cy={bead.y.toFixed(1)} r={bead.r.toFixed(1)} fill="url(#zb-lens)" />
                    <circle cx={(bead.x - bead.r * 0.35).toFixed(1)} cy={(bead.y - bead.r * 0.4).toFixed(1)} r={(bead.r * 0.28).toFixed(1)} fill="#fff" opacity="0.85" />
