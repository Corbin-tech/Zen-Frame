---
import { START_HOUR, END_HOUR, HOUR_HEIGHT, SLOT_MINUTES } from '../lib/timeline';
import { formatTime, toTimeValue } from '../lib/dates';
import AutoPlanPanel from './AutoPlanPanel.astro';

const hours = Array.from({ length: END_HOUR - START_HOUR }, (_, i) => START_HOUR + i);
const timelineHeight = hours.length * HOUR_HEIGHT;

const timeOptions = [];
for (let minutes = START_HOUR * 60; minutes <= END_HOUR * 60; minutes += SLOT_MINUTES) {
    timeOptions.push({ value: toTimeValue(minutes), label: formatTime(minutes) });
}
const startOptions = timeOptions.slice(0, -1);
const endOptions = timeOptions.slice(1);

const weekdayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const panel = 'panel';
const iconButton = 'inline-flex items-center justify-center touch-target p-2 rounded-lg text-gray-500 hover:text-gray-800 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-slate-700 transition-colors';
---

<div
    x-data="schedule"
    class="space-y-6"
    x-on:pointermove.window="onPointerMove($event)"
    x-on:pointerup.window="onPointerUp()"
    x-on:pointercancel.window="resetDrag()"
    x-on:blur.window="resetDrag()"
    x-on:keydown.escape.window="onEscape()"
    x-on:keydown.tab.window="if (showModal) trap($event)"
    x-on:overlay-opened.window="if (showModal && $event.detail.name !== 'schedule') { $event.detail.opener = opener; closeModal(false); }"
>
    <!-- Header -->
    <header>
        <p class="text-sm font-medium text-teal-700 dark:text-teal-400">Schedule</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Give your day a shape</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Drag on the timeline to plan a block. Drag a block to move it, or its bottom edge to change its length.</p>
    </header>

    <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] items-start">

        <!-- Sidebar -->
        <aside class="order-2 lg:order-1 min-w-0 space-y-6">
            <!-- Month calendar -->
            <section class={`${panel} p-5`}>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white" x-text="viewMonthLabel"></h3>
                    <div class="flex items-center">
                        <button type="button" class={iconButton} x-on:click="shiftMonth(-1)" aria-label="Previous month">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </button>
                        <button type="button" class={iconButton} x-on:click="shiftMonth(1)" aria-label="Next month">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-7 text-center text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">
                    {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((weekDay) => <div class="py-1">{weekDay}</div>)}
                </div>

                <div class="grid grid-cols-7 gap-1">
                    <template x-for="day in calendarDays" :key="day.date">
                        <button
                            type="button"
                            x-on:click="selectDate(day.date)"
                            class="relative aspect-square rounded-lg text-sm tabular-nums flex items-center justify-center transition-colors"
                            x-bind:class="day.date === selectedDate
                                ? 'bg-teal-600 text-white font-semibold shadow-sm'
                                : day.date === todayKey
                                    ? 'text-teal-700 dark:text-teal-300 font-semibold ring-1 ring-inset ring-teal-500/50 hover:bg-teal-50 dark:hover:bg-teal-900/30'
                                    : day.isCurrentMonth
                                        ? 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-slate-700'
                                        : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-700/50'"
                            x-bind:aria-label="$dates.formatDate(day.date, { weekday: 'long', month: 'long', day: 'numeric' })"
                            x-bind:aria-pressed="day.date === selectedDate"
                        >
                            <span x-text="day.day"></span>
                            <span class="absolute bottom-1 left-1/2 -translate-x-1/2 flex gap-0.5">
                                <span x-show="plannedDays.has(day.date)" class="w-1 h-1 rounded-full" x-bind:class="day.date === selectedDate ? 'bg-white' : 'bg-teal-500'"></span>
                                <span x-show="dueDays.has(day.date)" class="w-1 h-1 rounded-full" x-bind:class="day.date === selectedDate ? 'bg-amber-200' : 'bg-amber-500'"></span>
                            </span>
                        </button>
                    </template>
                </div>

                <div class="flex items-center gap-4 mt-3 text-xs text-gray-500 dark:text-gray-400">
                    <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>Planned</span>
                    <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Due</span>
                </div>
            </section>

            <AutoPlanPanel panel={panel} />

            <!-- Tasks without a block on this day or a later one -->
            <section class={`${panel} p-5`}>
                <div class="flex items-baseline justify-between">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white">To schedule</h3>
                    <span class="text-xs font-medium tabular-nums text-gray-500 dark:text-gray-400" x-text="unscheduledTasks.length"></span>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 mb-3">Drag a task onto the timeline, or press + to pick a time.</p>

                <ul class="space-y-1.5 max-h-80 overflow-y-auto -mr-1 pr-1">
                    <template x-for="task in unscheduledTasks" :key="task.id">
                        <li
                            x-drag-task="task.id"
                            class="schedule-chip group flex items-center gap-2 rounded-lg pl-2.5 pr-1 py-1.5 bg-gray-50 dark:bg-slate-700/50 hover:bg-gray-100 dark:hover:bg-slate-700 cursor-grab transition-colors"
                        >
                            <span class="w-2 h-2 rounded-full shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor(task.parentId)};`"></span>
                            <div class="flex-1 min-w-0">
                                <p class="truncate text-sm text-gray-700 dark:text-gray-200" x-text="task.todo" x-bind:title="task.todo"></p>
                                <p x-show="task.parentId || task.dueDate" class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                                    <span class="truncate" x-text="$store.todos.clusterName(task.parentId)"></span>
                                    <span
                                        x-show="task.dueDate"
                                        class="shrink-0 font-medium px-1 rounded"
                                        x-bind:class="task.dueDate ? $dates.dueClass(task.dueDate) : ''"
                                        x-text="task.dueDate ? $dates.dueLabel(task.dueDate) : ''"
                                    ></span>
                                </p>
                            </div>
                            <button
                                type="button"
                                x-on:click="openModalFor(task.id)"
                                class="shrink-0 inline-flex items-center justify-center touch-target p-1 rounded-md text-teal-600 dark:text-teal-400 hover:bg-teal-50 dark:hover:bg-teal-900/40"
                                x-bind:aria-label="`Schedule ${task.todo}`"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" /></svg>
                            </button>
                        </li>
                    </template>
                </ul>
                <p x-show="unscheduledTasks.length === 0" class="text-sm text-gray-500 dark:text-gray-400 py-2">Every open task is on the schedule.</p>
            </section>
        </aside>

        <!-- Day view -->
        <section class={`${panel} order-1 lg:order-2 min-w-0 overflow-hidden`}>
            <header class="flex flex-wrap items-start justify-between gap-4 p-5 border-b border-gray-100 dark:border-slate-700">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400" x-text="selectedDayLabel"></p>
                    <h2 class="text-xl font-semibold text-gray-900 dark:text-white" x-text="$dates.formatDate(selectedDate, { weekday: 'long', month: 'long', day: 'numeric' })"></h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5" x-text="daySummary"></p>
                </div>
                <div class="flex items-center gap-1">
                    <button type="button" class={iconButton} x-on:click="selectDate($dates.addDays(selectedDate, -1))" aria-label="Previous day">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    </button>
                    <button
                        type="button"
                        x-on:click="selectDate(todayKey)"
                        x-show="selectedDate !== todayKey"
                        class="px-2 py-1 text-sm font-medium rounded-lg text-teal-700 dark:text-teal-400 hover:bg-teal-50 dark:hover:bg-teal-900/30 transition-colors"
                    >Today</button>
                    <button type="button" class={iconButton} x-on:click="selectDate($dates.addDays(selectedDate, 1))" aria-label="Next day">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </button>
                    <button
                        type="button"
                        x-on:click="openModalFor(null)"
                        class="ml-2 flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg bg-teal-600 text-white hover:bg-teal-700 shadow-sm transition-colors"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" /></svg>
                        Add block
                    </button>
                </div>
            </header>

            <!-- Timeline -->
            <div x-ref="scroller" tabindex="-1" class="focus:outline-none max-h-[36rem] overflow-y-auto overscroll-contain">
                <div class="flex py-3 pr-3 select-none">
                    <!-- Hour labels -->
                    <div class="relative w-16 shrink-0" style={`height: ${timelineHeight}px;`} aria-hidden="true">
                        {hours.map((hour) => (
                            <span
                                class="absolute right-3 -translate-y-1/2 text-xs font-medium text-gray-500 dark:text-gray-400"
                                style={`top: ${(hour - START_HOUR) * HOUR_HEIGHT}px;`}
                            >{formatTime(hour * 60).replace(':00', '')}</span>
                        ))}
                    </div>

                    <!-- Grid: drag here to plan a block, or drop a task -->
                    <div
                        x-ref="grid"
                        class="timeline-grid relative flex-1 border-l border-gray-100 dark:border-slate-700 cursor-crosshair"
                        style={`height: ${timelineHeight}px;`}
                        x-on:pointerdown="startCreate($event)"
                        x-task-drop="scheduleDroppedTask($taskId, $clientY)"
                        x-on:task-dragover="dropPreview = rangeAt($event.detail.clientY)"
                        x-on:task-dragleave="dropPreview = null"
                    >
                        {hours.map((hour) => (
                            <>
                                <div class="absolute inset-x-0 border-t border-gray-100 dark:border-slate-700/70 pointer-events-none" style={`top: ${(hour - START_HOUR) * HOUR_HEIGHT}px;`}></div>
                                <div class="absolute inset-x-0 border-t border-dashed border-gray-100/70 dark:border-slate-700/40 pointer-events-none" style={`top: ${(hour - START_HOUR + 0.5) * HOUR_HEIGHT}px;`}></div>
                            </>
                        ))}

                        <!-- Hours you're free to work (from Auto-plan) -->
                        <template x-for="band in availabilityBands" :key="band.start">
                            <div
                                class="absolute inset-x-0 bg-teal-500/[0.06] dark:bg-teal-400/[0.07] border-y border-teal-500/15 pointer-events-none"
                                x-bind:style="{ top: `${toY(band.start)}px`, height: `${toY(band.end) - toY(band.start)}px` }"
                                aria-hidden="true"
                            ></div>
                        </template>

                        <!-- Current time -->
                        <div
                            x-show="isNowVisible"
                            class="absolute inset-x-0 z-20 pointer-events-none"
                            x-bind:style="{ top: `${toY(nowMinutes)}px` }"
                        >
                            <div class="relative h-0.5 bg-rose-500">
                                <span class="absolute -left-1.5 -top-[5px] w-3 h-3 rounded-full bg-rose-500 ring-2 ring-white dark:ring-slate-800"></span>
                            </div>
                        </div>

                        <!-- New block preview while dragging -->
                        <div
                            x-show="preview"
                            class="absolute left-1 right-1 z-10 rounded-lg border-2 border-dashed border-teal-500 bg-teal-500/10 px-2 py-1 text-xs font-medium text-teal-700 dark:text-teal-300 pointer-events-none"
                            x-bind:style="preview ? { top: `${toY(preview.start)}px`, height: `${toY(preview.end) - toY(preview.start)}px` } : {}"
                            x-text="preview ? formatRange(preview.start, preview.end) : ''"
                        ></div>

                        <!-- Scheduled blocks -->
                        <template x-for="block in blocks" :key="block.id">
                            <div
                                class="absolute z-10 rounded-lg pl-2.5 pr-2 py-1 overflow-hidden cursor-grab active:cursor-grabbing shadow-sm hover:shadow-md touch-pan-y transition-shadow"
                                x-bind:class="{ 'opacity-60': block.completed, 'z-30 shadow-lg ring-2 ring-teal-500': drag && drag.itemId === block.id && drag.moved }"
                                x-bind:style="block.style"
                                x-on:pointerdown.stop="startMove($event, block)"
                                role="button"
                                tabindex="0"
                                x-bind:aria-label="`${block.title}, ${formatRange(block.start, block.end)}${block.repeatDays ? `, repeats ${block.repeatDays}` : ''}. Press Enter to edit.`"
                                x-on:keydown.enter="openModalFor(block.taskId, block.item)"
                            >
                                <div class="flex items-start gap-2 min-w-0">
                                    <!-- A class meeting (a cluster block) is not a to-do -->
                                    <input name="block-done"
                                        x-show="!block.isCluster"
                                        type="checkbox"
                                        class="mt-0.5 w-3.5 h-3.5 shrink-0 rounded border-gray-300 dark:border-slate-500 text-teal-600 focus:ring-teal-500 dark:bg-slate-700 cursor-pointer"
                                        x-bind:checked="block.completed"
                                        x-on:pointerdown.stop
                                        x-on:click.stop="$store.todos.toggleBlockDone(block.item, selectedDate)"
                                        x-bind:aria-label="`Mark ${block.title} ${block.completed ? 'not done' : 'done'}`"
                                    />
                                    <div class="min-w-0 leading-tight">
                                        <p class="flex items-center gap-1 text-sm font-medium text-gray-900 dark:text-white">
                                            <span class="truncate" x-bind:class="block.completed && 'line-through'" x-text="block.title"></span>
                                            <svg x-show="block.repeatDays" class="w-3 h-3 shrink-0 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                        </p>
                                        <p x-show="block.end - block.start >= 30" class="text-xs text-gray-600 dark:text-gray-300 truncate mt-0.5" x-text="block.subtitle"></p>
                                    </div>
                                </div>
                                <!-- Bottom edge resizes the block -->
                                <div class="absolute inset-x-0 bottom-0 h-2 cursor-ns-resize touch-none" x-on:pointerdown.stop="startResize($event, block)"></div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Block editor -->
    <div
        x-show="showModal"
        x-transition:leave="duration-150"
        x-cloak
        x-ref="modal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="block-editor-title"
    >
        <div
            x-show="showModal"
            x-transition.opacity.duration.200ms
            class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]"
            x-on:click="closeModal()"
        ></div>

        <div
            x-show="showModal"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-2 scale-95"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class="relative w-full max-w-md max-h-full overflow-y-auto rounded-2xl bg-white dark:bg-slate-800 shadow-2xl ring-1 ring-black/5 dark:ring-white/10"
        >
            <div class="p-5 space-y-5">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 id="block-editor-title" class="text-lg font-semibold text-gray-900 dark:text-white" x-text="editingItemId ? 'Edit block' : 'Plan a block'"></h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400" x-text="$dates.formatDate(selectedDate, { weekday: 'long', month: 'long', day: 'numeric' })"></p>
                    </div>
                    <button type="button" x-ref="closeModal" class={iconButton} x-on:click="closeModal()" aria-label="Close">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <!-- Editing: the block's task -->
                <div x-show="editingItemId" class="flex items-center gap-3 rounded-xl bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5">
                    <span class="w-2.5 h-2.5 rounded-full shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor($store.todos.clusterOf(selectedTask))};`"></span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-gray-900 dark:text-white truncate" x-text="selectedTask?.todo ?? 'Deleted task'"></p>
                        <p class="text-xs text-gray-500 dark:text-gray-400" x-text="selectedTask?.isCluster ? 'Cluster' : $store.todos.clusterName(selectedTask?.parentId ?? null) || 'No cluster'"></p>
                    </div>
                    <label x-show="editingItem && !selectedTask?.isCluster" class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300 cursor-pointer">
                        <input id="block-editor-done" name="block-editor-done"
                            type="checkbox"
                            class="w-4 h-4 rounded border-gray-300 dark:border-slate-500 text-teal-600 focus:ring-teal-500 dark:bg-slate-700"
                            x-model="blockDone"
                        />
                        Done
                    </label>
                </div>

                <!-- New block: find a task or create one -->
                <div x-show="!editingItemId" class="space-y-2">
                    <label for="block-task-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Task or cluster</label>
                    <input
                        id="block-task-search"
                        x-ref="search"
                        type="text"
                        x-model="query"
                        x-on:keydown.enter.prevent="pickFirstMatch()"
                        placeholder="Search tasks and clusters, or type a new task"
                        autocomplete="off"
                        class="block w-full rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500"
                    />
                    <ul class="max-h-44 overflow-y-auto rounded-lg border border-gray-100 dark:border-slate-700 divide-y divide-gray-100 dark:divide-slate-700" x-show="pickerTasks.length || pickerClusters.length || canCreateFromQuery">
                        <template x-for="task in pickerTasks" :key="task.id">
                            <li>
                                <button
                                    type="button"
                                    x-on:click="selectBlockTarget(task.id)"
                                    class="w-full flex items-center gap-2 px-3 py-2 text-left text-sm transition-colors"
                                    x-bind:class="taskMode === 'existing' && selectedTaskId === task.id ? 'bg-teal-50 dark:bg-teal-900/30 text-teal-800 dark:text-teal-200' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700/60'"
                                    x-bind:aria-pressed="taskMode === 'existing' && selectedTaskId === task.id"
                                >
                                    <span class="w-2 h-2 rounded-full shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor(task.parentId)};`"></span>
                                    <span class="flex-1 min-w-0 truncate" x-text="task.todo"></span>
                                    <span x-show="task.parentId" class="shrink-0 text-xs text-gray-500 dark:text-gray-400" x-text="$store.todos.clusterName(task.parentId)"></span>
                                    <!-- Picking a planned task moves it to this day -->
                                    <span
                                        x-show="plannedDateOf(task.id)"
                                        class="shrink-0 text-xs font-medium px-1 rounded bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-gray-300"
                                        x-text="plannedDateOf(task.id) ? `Planned ${$dates.formatDate(plannedDateOf(task.id))}` : ''"
                                    ></span>
                                    <svg x-show="taskMode === 'existing' && selectedTaskId === task.id" class="w-4 h-4 shrink-0 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                </button>
                            </li>
                        </template>
                        <!-- A cluster block is a class meeting, not a to-do -->
                        <template x-for="cluster in pickerClusters" :key="cluster.id">
                            <li>
                                <button
                                    type="button"
                                    x-on:click="selectBlockTarget(cluster.id)"
                                    class="w-full flex items-center gap-2 px-3 py-2 text-left text-sm transition-colors"
                                    x-bind:class="taskMode === 'existing' && selectedTaskId === cluster.id ? 'bg-teal-50 dark:bg-teal-900/30 text-teal-800 dark:text-teal-200' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700/60'"
                                    x-bind:aria-pressed="taskMode === 'existing' && selectedTaskId === cluster.id"
                                >
                                    <span class="w-2.5 h-2.5 rounded shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor(cluster.id)};`"></span>
                                    <span class="flex-1 min-w-0 truncate font-medium" x-text="cluster.todo"></span>
                                    <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">Cluster</span>
                                    <svg x-show="taskMode === 'existing' && selectedTaskId === cluster.id" class="w-4 h-4 shrink-0 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                </button>
                            </li>
                        </template>
                        <li x-show="canCreateFromQuery">
                            <button
                                type="button"
                                x-on:click="selectBlockTarget('')"
                                class="w-full flex items-center gap-2 px-3 py-2 text-left text-sm transition-colors"
                                x-bind:class="taskMode === 'new' ? 'bg-teal-50 dark:bg-teal-900/30 text-teal-800 dark:text-teal-200' : 'text-teal-700 dark:text-teal-300 hover:bg-gray-50 dark:hover:bg-slate-700/60'"
                            >
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" /></svg>
                                <span class="truncate" x-text="`Create “${query.trim()}”`"></span>
                            </button>
                        </li>
                    </ul>
                    <p x-show="!pickerTasks.length && !pickerClusters.length && !canCreateFromQuery" class="text-sm text-gray-500 dark:text-gray-400">Type a name to create a new task.</p>

                    <!-- Options for a new task -->
                    <div x-show="taskMode === 'new'" class="grid grid-cols-2 gap-3 pt-1">
                        <div>
                            <label for="new-task-cluster" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Cluster</label>
                            <select id="new-task-cluster" x-model="newTaskClusterId" class="block w-full rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500">
                                <option value="">No cluster</option>
                                <template x-for="cluster in $store.todos.clusters" :key="cluster.id">
                                    <option x-bind:value="cluster.id" x-text="cluster.todo"></option>
                                </template>
                            </select>
                        </div>
                        <!-- A one-off block's day is the task's due date, so only a routine asks for one -->
                        <div x-show="repeats">
                            <label for="new-task-due" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Due date</label>
                            <input id="new-task-due" type="date" x-model="newTaskDueDate" class="block w-full rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500" />
                        </div>
                    </div>
                </div>

                <!-- Time -->
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="block-start" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start</label>
                            <select id="block-start" x-model="startTime" x-on:change="setDuration(length)" class="block w-full rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500">
                                {startOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                            </select>
                        </div>
                        <div>
                            <label for="block-end" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End</label>
                            <select id="block-end" x-model="endTime" x-on:change="length = unestimatedLength = duration" class="block w-full rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500">
                                {endOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                            </select>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Length">
                        <template x-for="minutes in [30, 45, 60, 90, 120]" :key="minutes">
                            <button
                                type="button"
                                x-on:click="setDuration(unestimatedLength = minutes)"
                                class="px-2.5 py-1 text-xs font-medium rounded-full border transition-colors"
                                x-bind:class="duration === minutes
                                    ? 'border-teal-600 bg-teal-600 text-white'
                                    : 'border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-300 hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-300'"
                                x-text="$dates.formatDuration(minutes)"
                            ></button>
                        </template>
                    </div>
                    <p x-show="duration <= 0" class="text-sm text-red-600 dark:text-red-400">The block must end after it starts.</p>
                    <p x-show="conflicts.length" class="flex items-start gap-1.5 text-sm text-amber-700 dark:text-amber-300">
                        <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
                        <span x-text="`Overlaps ${conflicts.join(', ')}`"></span>
                    </p>
                </div>

                <!-- Weekly repeat -->
                <div class="space-y-3">
                    <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">
                        <input id="block-repeats" name="block-repeats" type="checkbox" x-model="repeats" class="w-4 h-4 rounded border-gray-300 dark:border-slate-500 text-teal-600 focus:ring-teal-500 dark:bg-slate-700" />
                        Repeats weekly
                    </label>
                    <div x-show="repeats" class="space-y-3 pl-6">
                        <div class="flex gap-1.5" role="group" aria-label="Repeat on">
                            {weekdayNames.map((name, day) => (
                                <button
                                    type="button"
                                    x-on:click={`toggleRepeatDay(${day})`}
                                    class="w-8 h-8 rounded-full text-xs font-semibold transition-colors"
                                    x-bind:class={`repeatDays.includes(${day}) ? 'bg-teal-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-slate-700 dark:text-gray-300 dark:hover:bg-slate-600'`}
                                    x-bind:aria-pressed={`repeatDays.includes(${day})`}
                                    aria-label={name}
                                >{name[0]}</button>
                            ))}
                        </div>
                        <div class="flex flex-wrap items-end gap-3">
                            <div>
                                <label for="block-repeat-until" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Ends on (optional)</label>
                                <input id="block-repeat-until" type="date" x-model="repeatUntil" x-bind:min="repeatStart" class="block rounded-lg border-gray-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white text-sm focus:border-teal-500 focus:ring-teal-500" />
                            </div>
                            <p class="pb-2 text-xs text-gray-500 dark:text-gray-400" x-text="`Starts ${$dates.formatDate(repeatStart, { weekday: 'short', month: 'short', day: 'numeric' })}`"></p>
                        </div>
                        <p x-show="repeatError" class="text-sm text-red-600 dark:text-red-400" x-text="repeatError"></p>
                    </div>
                    <p x-show="editingItem?.repeat" class="text-xs text-gray-500 dark:text-gray-400" x-text="repeats
                        ? 'Changes apply to every day this block repeats.'
                        : `Saving keeps this block on ${$dates.formatDate(selectedDate)} only and removes it from the other days.`"></p>
                </div>
            </div>

            <div class="flex items-center gap-2 px-5 py-4 border-t border-gray-100 dark:border-slate-700 bg-gray-50/60 dark:bg-slate-800/60 rounded-b-2xl">
                <button
                    type="button"
                    x-show="editingItemId"
                    x-on:click="deleteBlock()"
                    class="px-3 py-2 text-sm font-medium rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors"
                    x-text="editingItem?.repeat ? 'Remove all days' : 'Remove'"
                ></button>
                <div class="flex-1"></div>
                <button type="button" x-on:click="closeModal()" class="px-4 py-2 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">Cancel</button>
                <button
                    type="button"
                    x-on:click="saveBlock()"
                    x-bind:disabled="!canSave"
                    class="px-4 py-2 text-sm font-medium rounded-lg bg-teal-600 text-white hover:bg-teal-700 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                    x-text="editingItemId ? 'Save' : 'Add block'"
                ></button>
            </div>
        </div>
    </div>
</div>

<style>
    /* A task from the list is over the timeline */
    .timeline-grid[data-drop-active] {
        background-color: rgba(20, 184, 166, 0.04);
    }

    .schedule-chip[data-drag-active="true"] {
        opacity: 0.5;
    }
</style>

<script>
    import { dates } from '../lib/dates';
    import { blockMinutes } from '../lib/estimates';
    import { DAY_START, DAY_END, HOUR_HEIGHT, SLOT_MINUTES } from '../lib/timeline';
    import { windowsOn } from '../lib/autoPlan';
    import { trapFocus } from '../lib/focusTrap';

    const DEFAULT_LENGTH = 60;
    const DRAG_THRESHOLD_PX = 4;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
    const snap = (minutes) => Math.round(minutes / SLOT_MINUTES) * SLOT_MINUTES;

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('schedule', () => ({
            now: new Date(),
            selectedDate: dates.toDateKey(),
            viewMonth: new Date().getMonth(),
            viewYear: new Date().getFullYear(),

            // Pointer drag on the timeline: { mode: 'create' | 'move' | 'resize', start, end, moved, ... }
            drag: null,
            // Where a task from the list would land while it is dragged over the timeline
            dropPreview: null,

            // Block editor
            showModal: false,
            editingItemId: null,
            initialBlockDone: false,
            blockDone: false,
            opener: null, // Element to focus again when the editor closes
            taskMode: 'existing',
            selectedTaskId: '',
            query: '',
            newTaskClusterId: '',
            newTaskDueDate: '',
            startTime: '',
            endTime: '',
            length: DEFAULT_LENGTH, // Minutes the block keeps when its start moves
            unestimatedLength: DEFAULT_LENGTH,
            repeats: false,
            repeatDays: [],
            repeatUntil: '',

            init() {
                // Keeps the current-time line and "today" up to date
                setInterval(() => { this.now = new Date(); }, 60 * 1000);
                this.$watch('selectedDate', () => this.$nextTick(() => this.scrollToFocus()));

                // The tab can be hidden at load, where scrolling does nothing.
                // Scroll each time the timeline appears after being hidden, but not on page scroll.
                let wasHidden = true;
                new IntersectionObserver(([entry]) => {
                    if (entry.isIntersecting && wasHidden) this.scrollToFocus();
                    wasHidden = !entry.isIntersecting && this.$refs.scroller.offsetParent === null;
                }).observe(this.$refs.scroller);
            },

            get todayKey() {
                return dates.toDateKey(this.now);
            },

            get nowMinutes() {
                return dates.minutesNow(this.now);
            },

            get isNowVisible() {
                return this.selectedDate === this.todayKey && this.nowMinutes >= DAY_START && this.nowMinutes < DAY_END;
            },

            // --- Calendar ---

            get viewMonthLabel() {
                return new Date(this.viewYear, this.viewMonth, 1).toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
            },

            // Whole weeks that cover the month in view
            get calendarDays() {
                const firstDay = new Date(this.viewYear, this.viewMonth, 1);
                const lastDay = new Date(this.viewYear, this.viewMonth + 1, 0);
                const cellCount = Math.ceil((firstDay.getDay() + lastDay.getDate()) / 7) * 7;

                return Array.from({ length: cellCount }, (_, i) => {
                    const date = new Date(this.viewYear, this.viewMonth, i - firstDay.getDay() + 1);
                    return {
                        day: date.getDate(),
                        date: dates.toDateKey(date),
                        isCurrentMonth: date.getMonth() === this.viewMonth
                    };
                });
            },

            get plannedDays() {
                return new Set(this.calendarDays.map(day => day.date).filter(date => this.$store.todos.scheduledItemsOn(date).length));
            },

            get dueDays() {
                return new Set(this.$store.todos.openTasks.map(task => task.dueDate).filter(Boolean));
            },

            shiftMonth(offset) {
                const date = new Date(this.viewYear, this.viewMonth + offset, 1);
                this.viewMonth = date.getMonth();
                this.viewYear = date.getFullYear();
            },

            selectDate(key) {
                this.selectedDate = key;
                const date = dates.fromDateKey(key);
                this.viewMonth = date.getMonth();
                this.viewYear = date.getFullYear();
            },

            // --- Day ---

            get selectedDayLabel() {
                const days = dates.daysBetween(this.todayKey, this.selectedDate);
                if (days === 0) return 'Today';
                if (days === 1) return 'Tomorrow';
                if (days === -1) return 'Yesterday';
                return days > 0 ? `In ${days} days` : `${-days} days ago`;
            },

            get itemsForDay() {
                return this.$store.todos.scheduledItemsOn(this.selectedDate);
            },

            get daySummary() {
                const items = this.itemsForDay;
                const dueCount = this.$store.todos.openTasks.filter(task => task.dueDate === this.selectedDate).length;
                const parts = [];
                if (items.length) {
                    const minutes = items.reduce((sum, item) => sum + item.endTimeMinutes - item.startTimeMinutes, 0);
                    parts.push(`${items.length} ${items.length === 1 ? 'block' : 'blocks'}`, `${dates.formatDuration(minutes)} planned`);
                } else {
                    parts.push('Nothing planned yet');
                }
                if (dueCount) parts.push(`${dueCount} due`);
                return parts.join(' · ');
            },

            // Availability on this day, clipped to the timeline
            get availabilityBands() {
                return windowsOn(this.$store.todos.planning.availability, this.selectedDate)
                    .map(band => ({ start: Math.max(band.start, DAY_START), end: Math.min(band.end, DAY_END) }))
                    .filter(band => band.end > band.start);
            },

            // Open tasks without a block on this day, soonest due date first. The block editor picks
            // from these, so a task planned on another day can be found and moved here.
            get tasksOffDay() {
                const scheduled = new Set(this.itemsForDay.map(item => item.taskId));
                return this.$store.todos.openTasks
                    .filter(task => task.todo.trim() !== '' && !scheduled.has(task.id))
                    .sort((a, b) => (a.dueDate || '9999-12-31').localeCompare(b.dueDate || '9999-12-31'));
            },

            // The sidebar list: tasks off this day that are not planned yet. A task with a one-off
            // block today or later is already planned. A task whose block is in the past stays, and a drop moves it.
            get unscheduledTasks() {
                return this.tasksOffDay.filter(task => !this.plannedDateOf(task.id));
            },

            // The day of a task's one-off block today or later, or null
            plannedDateOf(taskId) {
                return this.$store.todos.scheduledItems.find(item => item.taskId === taskId && !item.repeat && item.date >= this.todayKey)?.date ?? null;
            },

            // Blocks with their position. Overlapping blocks share the width side by side.
            get blocks() {
                const items = this.itemsForDay.map(item => {
                    const dragged = this.drag && this.drag.itemId === item.id && this.drag.moved;
                    return { item, start: dragged ? this.drag.start : item.startTimeMinutes, end: dragged ? this.drag.end : item.endTimeMinutes };
                }).sort((a, b) => a.start - b.start || b.end - a.end);

                // Group blocks that overlap in a chain, then give each a column in its group
                let group = [];
                let groupEnd = -1;
                let columnEnds = [];
                const finishGroup = () => group.forEach(entry => { entry.columns = columnEnds.length; });
                items.forEach(entry => {
                    if (entry.start >= groupEnd) {
                        finishGroup();
                        group = [];
                        columnEnds = [];
                    }
                    let column = columnEnds.findIndex(end => end <= entry.start);
                    if (column === -1) column = columnEnds.length;
                    columnEnds[column] = entry.end;
                    entry.column = column;
                    group.push(entry);
                    groupEnd = Math.max(groupEnd, entry.end);
                });
                finishGroup();

                return items.map(({ item, start, end, column, columns }) => {
                    const task = this.$store.todos.find(item.taskId);
                    const isCluster = Boolean(task?.isCluster);
                    const color = this.$store.todos.clusterColor(this.$store.todos.clusterOf(task));
                    const clusterName = isCluster ? '' : this.$store.todos.clusterName(task?.parentId ?? null);
                    const top = this.toY(start);
                    const height = Math.max(this.toY(end) - top - 2, 18);
                    return {
                        id: item.id,
                        item,
                        taskId: item.taskId,
                        start,
                        end,
                        isCluster,
                        repeatDays: item.repeat ? dates.formatWeekdays(item.repeat.weekdays) : '',
                        title: task?.todo || 'Deleted task',
                        subtitle: [this.formatRange(start, end), clusterName].filter(Boolean).join(' · '),
                        completed: this.$store.todos.isBlockDone(item, this.selectedDate),
                        style: `top: ${top}px; height: ${height}px; left: calc(${(column / columns) * 100}% + 4px); width: calc(${100 / columns}% - 8px); ` +
                            `background-color: color-mix(in srgb, ${color} 16%, var(--card-bg)); border-left: 3px solid ${color};`
                    };
                });
            },

            // --- Timeline geometry ---

            toY(minutes) {
                return (minutes - DAY_START) / 60 * HOUR_HEIGHT;
            },

            // Minutes at a screen position, not snapped
            minutesAt(clientY) {
                const top = this.$refs.grid.getBoundingClientRect().top;
                return DAY_START + (clientY - top) / HOUR_HEIGHT * 60;
            },

            // The slot under a screen position
            slotAt(clientY) {
                const slot = Math.floor(this.minutesAt(clientY) / SLOT_MINUTES) * SLOT_MINUTES;
                return clamp(slot, DAY_START, DAY_END - SLOT_MINUTES);
            },

            rangeAt(clientY, length = DEFAULT_LENGTH) {
                const start = this.slotAt(clientY);
                return { start, end: Math.min(start + length, DAY_END) };
            },

            formatRange(start, end) {
                return `${dates.formatTime(start)} – ${dates.formatTime(end)}`;
            },

            get preview() {
                if (this.drag && this.drag.mode === 'create' && this.drag.moved) {
                    return { start: this.drag.start, end: this.drag.end };
                }
                return this.dropPreview;
            },

            // Show the current time on today, else the first block, else 8 AM
            scrollToFocus() {
                const scroller = this.$refs.scroller;
                if (!scroller) return;
                const first = this.itemsForDay[0];
                const focus = this.selectedDate === this.todayKey
                    ? this.nowMinutes - 60
                    : (first ? first.startTimeMinutes - 30 : 8 * 60);
                scroller.scrollTop = Math.max(0, this.toY(focus));
            },

            // First free hour-long slot: after now on today, from 9 AM on other days
            suggestedStart() {
                const earliest = this.selectedDate === this.todayKey
                    ? Math.ceil(this.nowMinutes / SLOT_MINUTES) * SLOT_MINUTES
                    : 9 * 60;
                const base = clamp(earliest, DAY_START, DAY_END - DEFAULT_LENGTH);
                const items = this.itemsForDay;
                for (let start = base; start + DEFAULT_LENGTH <= DAY_END; start += SLOT_MINUTES) {
                    const end = start + DEFAULT_LENGTH;
                    if (!items.some(item => item.startTimeMinutes < end && item.endTimeMinutes > start)) return start;
                }
                return base;
            },

            // --- Pointer dragging on the timeline ---

            startCreate(event) {
                if (event.button !== 0) return;
                event.preventDefault();
                const slot = this.slotAt(event.clientY);
                this.drag = { mode: 'create', anchor: slot, start: slot, end: slot + SLOT_MINUTES, startY: event.clientY, moved: false };
            },

            startMove(event, block) {
                if (event.button !== 0) return;
                if (event.pointerType === 'mouse') event.preventDefault();
                this.drag = {
                    mode: 'move',
                    itemId: block.id,
                    offset: this.minutesAt(event.clientY) - block.start,
                    start: block.start,
                    end: block.end,
                    startY: event.clientY,
                    moved: false
                };
            },

            startResize(event, block) {
                if (event.button !== 0) return;
                event.preventDefault();
                this.drag = { mode: 'resize', itemId: block.id, start: block.start, end: block.end, startY: event.clientY, moved: false };
            },

            onPointerMove(event) {
                const drag = this.drag;
                if (!drag) return;
                if (!drag.moved && Math.abs(event.clientY - drag.startY) < DRAG_THRESHOLD_PX) return;
                drag.moved = true;
                this.autoScroll(event.clientY);

                if (drag.mode === 'create') {
                    const slot = this.slotAt(event.clientY);
                    drag.start = Math.min(drag.anchor, slot);
                    drag.end = Math.max(drag.anchor, slot) + SLOT_MINUTES;
                } else if (drag.mode === 'move') {
                    const length = drag.end - drag.start;
                    drag.start = clamp(snap(this.minutesAt(event.clientY) - drag.offset), DAY_START, DAY_END - length);
                    drag.end = drag.start + length;
                } else {
                    drag.end = clamp(snap(this.minutesAt(event.clientY)), drag.start + SLOT_MINUTES, DAY_END);
                }
            },

            // Cancel a drag without saving and clear any drop highlight
            resetDrag() {
                this.drag = null;
                this.dropPreview = null;
            },

            // Escape cancels a drag in progress; otherwise it closes the editor
            onEscape() {
                if (this.drag || this.dropPreview) this.resetDrag();
                else if (this.showModal) this.closeModal();
            },

            onPointerUp() {
                const drag = this.drag;
                this.resetDrag();
                if (!drag) return;

                const item = drag.itemId ? this.itemsForDay.find(entry => entry.id === drag.itemId) : null;

                if (drag.mode === 'create') {
                    const end = drag.moved ? drag.end : Math.min(drag.anchor + DEFAULT_LENGTH, DAY_END);
                    this.openModal(drag.start, end);
                } else if (!drag.moved) {
                    // A click on a block opens it
                    if (item && drag.mode === 'move') this.openModal(item.startTimeMinutes, item.endTimeMinutes, item);
                } else if (item) {
                    this.$store.todos.saveScheduledItem({ ...item, startTimeMinutes: drag.start, endTimeMinutes: drag.end });
                }
            },

            // Scroll the timeline while dragging near its top or bottom edge
            autoScroll(clientY) {
                const scroller = this.$refs.scroller;
                const rect = scroller.getBoundingClientRect();
                if (clientY < rect.top + 40) scroller.scrollTop -= 12;
                else if (clientY > rect.bottom - 40) scroller.scrollTop += 12;
            },

            // A task from the list was dropped on the timeline
            scheduleDroppedTask(taskId, clientY) {
                const { start, end } = this.rangeAt(clientY);
                this.resetDrag();
                this.$store.todos.saveScheduledItem({
                    id: crypto.randomUUID(),
                    taskId,
                    date: this.selectedDate,
                    startTimeMinutes: start,
                    endTimeMinutes: end
                });
            },

            // --- Block editor ---

            get selectedTask() {
                return this.taskMode === 'existing' && this.selectedTaskId
                    ? this.$store.todos.find(this.selectedTaskId) ?? null
                    : null;
            },

            get pickerTasks() {
                const query = this.query.trim().toLowerCase();
                return this.tasksOffDay.filter(task => task.todo.toLowerCase().includes(query));
            },

            get pickerClusters() {
                const query = this.query.trim().toLowerCase();
                return this.$store.todos.clusters.filter(cluster => cluster.todo.toLowerCase().includes(query));
            },

            get canCreateFromQuery() {
                const query = this.query.trim().toLowerCase();
                return query !== '' && ![...this.pickerTasks, ...this.pickerClusters].some(item => item.todo.trim().toLowerCase() === query);
            },

            get editingItem() {
                return this.$store.todos.scheduledItems.find(item => item.id === this.editingItemId) ?? null;
            },

            // A repeating block keeps its first day when it is edited on a later day
            get repeatStart() {
                return this.repeats && this.editingItem?.repeat ? this.editingItem.date : this.selectedDate;
            },

            get repeatError() {
                if (!this.repeats) return '';
                if (!this.repeatDays.length) return 'Pick at least one day.';
                if (this.repeatUntil && this.repeatUntil < this.repeatStart) return 'The end date must be on or after the start date.';
                return '';
            },

            get startMinutes() {
                return dates.fromTimeValue(this.startTime || '00:00');
            },

            get duration() {
                return dates.fromTimeValue(this.endTime || '00:00') - this.startMinutes;
            },

            get conflicts() {
                const start = this.startMinutes;
                const end = start + this.duration;
                const overlapsTime = (item) => item.id !== this.editingItemId && item.startTimeMinutes < end && item.endTimeMinutes > start;
                const candidates = this.repeats && this.repeatDays.length
                    ? this.$store.todos.scheduledItems.filter(item => {
                        if (!overlapsTime(item)) return false;
                        if (item.repeat) {
                            const sharesDay = item.repeat.weekdays.some(day => this.repeatDays.includes(day));
                            const rangesOverlap = (!this.repeatUntil || item.date <= this.repeatUntil) && (!item.repeat.until || this.repeatStart <= item.repeat.until);
                            return sharesDay && rangesOverlap;
                        }
                        const inWindow = item.date >= this.repeatStart && (!this.repeatUntil || item.date <= this.repeatUntil);
                        return inWindow && this.repeatDays.includes(dates.fromDateKey(item.date).getDay());
                    })
                    : this.itemsForDay.filter(overlapsTime);
                return candidates.map(item => `${this.$store.todos.find(item.taskId)?.todo ?? 'a block'} (${this.formatRange(item.startTimeMinutes, item.endTimeMinutes)})`);
            },

            get canSave() {
                if (this.duration <= 0 || this.repeatError) return false;
                if (this.editingItemId) return true;
                return this.taskMode === 'new' ? this.query.trim() !== '' : Boolean(this.selectedTask);
            },

            openModal(start, end, item = null, taskId = '') {
                const opened = { name: 'schedule' };
                window.dispatchEvent(new CustomEvent('overlay-opened', { detail: opened }));
                this.opener = opened.opener || document.activeElement;
                this.editingItemId = item?.id ?? null;
                this.initialBlockDone = this.blockDone = item ? this.$store.todos.isBlockDone(item, this.selectedDate) : false;
                this.taskMode = 'existing';
                this.selectedTaskId = item?.taskId ?? '';
                this.query = '';
                this.newTaskClusterId = '';
                this.newTaskDueDate = '';
                this.startTime = dates.toTimeValue(start);
                this.endTime = dates.toTimeValue(end);
                this.length = this.unestimatedLength = end - start;
                if (!item && taskId) this.selectBlockTarget(taskId);
                this.repeats = Boolean(item?.repeat);
                this.repeatDays = item?.repeat ? [...item.repeat.weekdays] : [dates.fromDateKey(this.selectedDate).getDay()];
                this.repeatUntil = item?.repeat?.until ?? '';
                this.showModal = true;
                this.$nextTick(() => (!item && !taskId ? this.$refs.search : this.$refs.closeModal).focus());
            },

            trap(event) {
                trapFocus(event, this.$refs.modal);
            },

            // From the "To schedule" list (+) or the header button (no task)
            openModalFor(taskId, item = null) {
                if (item) {
                    this.openModal(item.startTimeMinutes, item.endTimeMinutes, item);
                    return;
                }
                const start = this.suggestedStart();
                this.openModal(start, Math.min(start + DEFAULT_LENGTH, DAY_END), null, taskId ?? '');
            },

            closeModal(restoreFocus = true) {
                const opener = this.opener;
                this.showModal = false; // editingItemId stays until the next open, so the editor doesn't change while it fades out
                this.opener = null;
                if (!restoreFocus) return;
                this.$nextTick(() => (opener?.isConnected && opener.focus ? opener : this.$refs.scroller).focus());
            },

            pickFirstMatch() {
                const match = this.pickerTasks[0] ?? this.pickerClusters[0];
                if (match) this.selectBlockTarget(match.id);
                else if (this.canCreateFromQuery) this.selectBlockTarget('');
            },

            selectBlockTarget(taskId) {
                if (taskId && this.selectedTaskId === taskId && this.taskMode === 'existing') return;
                this.taskMode = taskId ? 'existing' : 'new';
                this.selectedTaskId = taskId;
                const estimate = this.selectedTask?.estimateMinutes;
                this.setDuration(estimate ? blockMinutes(estimate) : this.unestimatedLength);
            },

            setDuration(minutes) {
                this.length = minutes;
                this.endTime = dates.toTimeValue(Math.min(this.startMinutes + minutes, DAY_END));
            },

            toggleRepeatDay(day) {
                this.repeatDays = this.repeatDays.includes(day)
                    ? this.repeatDays.filter(other => other !== day)
                    : [...this.repeatDays, day].sort((a, b) => a - b);
            },

            saveBlock() {
                if (!this.canSave) return;

                const item = this.editingItem;
                if (item && this.blockDone !== this.initialBlockDone) {
                    this.$store.todos.setBlockDone(item, this.selectedDate, this.blockDone);
                }

                let taskId = this.selectedTaskId;
                if (this.taskMode === 'new') {
                    taskId = this.$store.todos.addTodo(this.query.trim(), {
                        parentId: this.newTaskClusterId || null,
                        dueDate: this.newTaskDueDate || null
                    });
                }

                this.$store.todos.saveScheduledItem({
                    id: this.editingItemId || crypto.randomUUID(),
                    taskId,
                    date: this.repeatStart,
                    startTimeMinutes: this.startMinutes,
                    endTimeMinutes: this.startMinutes + this.duration,
                    repeat: this.repeats
                        ? { weekdays: [...this.repeatDays], until: this.repeatUntil || null, doneDates: item?.repeat?.doneDates ?? [] }
                        : undefined
                });
                this.closeModal();
            },

            deleteBlock() {
                this.$store.todos.removeScheduledItem(this.editingItemId);
                this.closeModal();
            }
        }));
    });
</script>
