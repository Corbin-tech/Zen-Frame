---
// The timeline and the time pickers cover 6:00 AM to 11:00 PM in 15-minute steps
const timeOptions: { value: string; label: string }[] = [];
for (let minutes = 6 * 60; minutes <= 23 * 60; minutes += 15) {
    const hour = Math.floor(minutes / 60);
    const minute = String(minutes % 60).padStart(2, '0');
    timeOptions.push({
        value: `${String(hour).padStart(2, '0')}:${minute}`,
        label: `${hour % 12 || 12}:${minute} ${hour < 12 ? 'AM' : 'PM'}`
    });
}
---

<div class="container mx-auto px-4" x-data="schedule">
    <div class="flex flex-col space-y-6 max-w-4xl mx-auto">
        <!-- Calendar -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-md p-6">
            <!-- Header: Month Navigation -->
            <div class="flex justify-between items-center mb-4">
                <button
                    @click="shiftMonth(-1)"
                    type="button"
                    class="p-2 rounded-full hover:bg-teal-100 dark:hover:bg-teal-800/50 text-teal-600 dark:text-teal-400 focus:outline-none focus:ring-2 focus:ring-teal-300"
                    aria-label="Previous month"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <h2 class="text-4xl mb-4 font-bold text-black dark:text-white" x-text="`${monthNames[currentMonth]} ${currentYear}`"></h2>
                <button
                    @click="shiftMonth(1)"
                    type="button"
                    class="p-2 rounded-full hover:bg-teal-100 dark:hover:bg-teal-800/50 text-teal-600 dark:text-teal-400 focus:outline-none focus:ring-2 focus:ring-teal-300"
                    aria-label="Next month"
                >
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Days of the Week Header -->
            <div class="grid grid-cols-7 gap-1.5 px-2 max-w-lg mx-auto text-center text-xs font-medium text-teal-600 dark:text-teal-400 mb-2">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((weekDay) => <div>{weekDay}</div>)}
            </div>

            <!-- Calendar Days Grid -->
            <div class="grid grid-cols-7 gap-1.5 px-2 max-w-lg mx-auto">
                <template x-for="day in days" :key="day.date">
                    <div
                        @click="selectedDate = day.date"
                        class="aspect-square flex flex-col p-0.5 rounded-2xl cursor-pointer transition-colors relative scale-95"
                        x-bind:class="selectedDate === day.date ? 'bg-teal-50 dark:bg-teal-900/30 ring-2 ring-teal-500 dark:ring-teal-600' : day.isCurrentMonth ? 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600' : 'bg-gray-200/60 dark:bg-gray-700/30 hover:bg-gray-200/80 dark:hover:bg-gray-700/40 opacity-70'"
                    >
                        <!-- Day Number -->
                        <div
                            class="text-center font-medium rounded-full w-5 h-5 flex items-center justify-center mx-auto text-xs mt-1.5"
                            x-bind:class="selectedDate === day.date
                                ? 'bg-teal-500 dark:bg-teal-600 text-white ring-1 ring-teal-400 dark:ring-teal-500'
                                : day.date === todayKey
                                    ? 'bg-gray-400 dark:bg-gray-500 text-gray-800 dark:text-gray-100 ring-1 ring-teal-200 dark:ring-teal-700'
                                    : day.isCurrentMonth
                                        ? 'text-gray-900 dark:text-white bg-gray-300 dark:bg-gray-600'
                                        : 'text-gray-500 dark:text-gray-400 bg-gray-300/80 dark:bg-gray-600/80'"
                        >
                            <span x-text="day.day"></span>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- Time Blocking -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-md p-6">
            <h3 class="text-4xl font-bold text-center mb-6 text-black dark:text-white">Schedule</h3>

            <!-- Selected date indicator -->
            <div class="flex justify-center items-center mb-6">
                <div
                    class="flex flex-col items-center px-6 py-3 rounded-lg transition-colors duration-150"
                    x-bind:class="selectedDate === todayKey
                        ? 'bg-white dark:bg-slate-800 border border-teal-200 dark:border-teal-700 shadow-sm'
                        : 'bg-gray-100 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 shadow-xs'"
                >
                    <h2 class="text-xl font-semibold text-black dark:text-white" x-text="selectedDateFormatted"></h2>
                </div>
            </div>

            <!-- Timeline Container -->
            <div class="relative h-64 mb-6">
                <!-- Scrollable container for the timeline -->
                <div class="overflow-x-auto pb-4 border border-gray-200 dark:border-gray-700 rounded-lg shadow-md relative bg-white dark:bg-slate-800 hover:shadow-lg transition-shadow duration-300">
                    <div
                        class="relative flex items-stretch p-0 min-w-full"
                        style="width: 150%; min-width: 800px; height: 180px;"
                     >
                        <!-- Timeline Hours Strip - only for display -->
                        <div class="absolute inset-0 flex pointer-events-none">
                            <template x-for="(hour, index) in hours" :key="hour">
                                <!-- Hour columns with alternating background colors for better readability -->
                                <div
                                    class="flex-1 flex flex-col justify-start h-full border-r border-gray-200 dark:border-gray-700 relative"
                                    :class="index % 2 === 0 ? 'bg-gray-50 dark:bg-slate-700/50' : 'bg-white dark:bg-slate-800'"
                                >
                                    <!-- Hour label (positioned at top) -->
                                    <div class="absolute top-0 left-0 right-0 h-8 flex items-center justify-center border-b border-gray-200 dark:border-gray-700 bg-gradient-to-b from-white dark:from-slate-700 to-transparent dark:to-transparent">
                                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300" x-text="formatHour(hour)"></span>
                                    </div>

                                    <!-- 15, 30 and 45 minute markers -->
                                    <div class="absolute inset-0 flex mt-8">
                                        <div class="w-1/4 h-full border-r border-dashed border-teal-100 dark:border-teal-900/30"></div>
                                        <div class="w-1/4 h-full border-r border-dashed border-teal-200 dark:border-teal-800/50"></div>
                                        <div class="w-1/4 h-full border-r border-dashed border-teal-100 dark:border-teal-900/30"></div>
                                        <div class="w-1/4 h-full"></div>
                                    </div>

                                    <!-- Current time indicator (only for today, and only for the correct hour) -->
                                    <div
                                        x-show="selectedDate === todayKey && hour === now.getHours()"
                                        class="absolute h-full w-0.5 bg-teal-500 dark:bg-teal-400 z-10"
                                        :style="`left: ${now.getMinutes() / 60 * 100}%;`"
                                    >
                                        <div class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-teal-500 dark:bg-teal-400"></div>
                                    </div>
                                </div>
                            </template>
                        </div>

                        <!-- Interactive Layer - For Click Handling (z-index to ensure it's above the visuals but below tasks) -->
                        <div class="absolute inset-0 flex z-10">
                            <template x-for="hour in hours" :key="hour">
                                <div
                                    class="flex-1 h-full cursor-pointer"
                                    @click.stop="openTimeBlockModal(hour * 60, hour * 60 + 60)"
                                ></div>
                            </template>
                        </div>

                        <!-- Scheduled Task Blocks -->
                        <div class="absolute inset-0 pointer-events-none z-20">
                            <template x-for="item in scheduledItemsForSelectedDate" :key="item.id">
                                <div
                                    :style="getTaskBlockStyle(item)"
                                    class="absolute flex flex-col justify-between bg-teal-100 dark:bg-teal-900/80 rounded-md overflow-hidden p-2 pointer-events-auto cursor-pointer hover:bg-teal-200 dark:hover:bg-teal-800 transition-all duration-150 shadow-sm hover:shadow-md border-l-4 border-teal-500 dark:border-teal-600"
                                    @click.stop="openTimeBlockModal(item.startTimeMinutes, item.endTimeMinutes, item)"
                                >
                                    <span class="text-sm font-medium text-teal-800 dark:text-teal-200 truncate" x-text="getTaskTitle(item.taskId)"></span>
                                    <span class="text-xs text-teal-600 dark:text-teal-400 mt-1">
                                        <span x-text="formatTime(item.startTimeMinutes)"></span> - <span x-text="formatTime(item.endTimeMinutes)"></span>
                                    </span>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- Scroll indicator with better visual cue -->
                <div class="flex items-center justify-center gap-2 text-sm text-gray-600 text-center mt-3 dark:text-gray-400 font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    <span>Scroll to see more hours</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </div>
            </div>

            <!-- Time Block Scheduling Modal -->
            <div
                x-show="showTimeBlockModal"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 transform scale-90"
                x-transition:enter-end="opacity-100 transform scale-100"
                x-transition:leave="transition ease-in duration-300"
                x-transition:leave-start="opacity-100 transform scale-100"
                x-transition:leave-end="opacity-0 transform scale-90"
                x-cloak
                class="fixed inset-0 z-50 overflow-y-auto"
                @keydown.escape.window="showTimeBlockModal && closeTimeBlockModal()"
            >
                <!-- Modal Backdrop -->
                <div class="fixed inset-0 bg-black opacity-30" @click="closeTimeBlockModal()"></div>

                <!-- Modal Content -->
                <div class="flex items-center justify-center min-h-screen p-4">
                    <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl p-5 w-full max-w-lg">
                        <!-- Close Button -->
                        <button
                            type="button"
                            @click="closeTimeBlockModal()"
                            class="absolute top-3 right-3 text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-teal-500 rounded-full p-1"
                            aria-label="Close"
                        >
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4" x-text="editingItemId ? 'Edit Scheduled Task' : 'Schedule a Task'"></h3>

                        <div class="space-y-4">
                            <!-- New block: pick a task -->
                            <div x-show="!editingItemId">
                                <label for="task-select" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Task</label>
                                <select
                                    id="task-select"
                                    x-model="selectedTaskId"
                                    class="block w-full mt-1 border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-teal-500 focus:ring-teal-500 rounded-md shadow-sm"
                                >
                                    <option value="">-- Select a Task --</option>
                                    <template x-for="task in availableTasksForScheduling" :key="task.id">
                                        <option :value="task.id" x-text="task.todo"></option>
                                    </template>
                                </select>
                                <p x-show="availableTasksForScheduling.length === 0" class="text-sm text-gray-500 dark:text-gray-400 mt-1">No unscheduled tasks available.</p>
                            </div>

                            <!-- Existing block: show its task -->
                            <p x-show="editingItemId" class="text-gray-800 dark:text-gray-200">
                                Task: <strong x-text="getTaskTitle(selectedTaskId)"></strong>
                            </p>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label for="start-time" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Time</label>
                                    <select
                                        id="start-time"
                                        x-model="startTime"
                                        class="block w-full mt-1 border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-teal-500 focus:ring-teal-500 rounded-md shadow-sm"
                                    >
                                        {timeOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                                    </select>
                                </div>
                                <div>
                                    <label for="end-time" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Time</label>
                                    <select
                                        id="end-time"
                                        x-model="endTime"
                                        class="block w-full mt-1 border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-teal-500 focus:ring-teal-500 rounded-md shadow-sm"
                                    >
                                        {timeOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-6">
                            <button
                                type="button"
                                @click="closeTimeBlockModal()"
                                class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md transition-colors"
                            >
                                Cancel
                            </button>
                            <button
                                x-show="editingItemId"
                                @click="deleteScheduledTask()"
                                class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md transition-colors"
                            >
                                Remove
                            </button>
                            <button
                                @click="saveScheduledTask()"
                                :disabled="!canSave"
                                class="px-4 py-2 text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                x-text="editingItemId ? 'Update' : 'Schedule'"
                            ></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script is:inline>
document.addEventListener('alpine:init', () => {
    const START_HOUR = 6;
    const END_HOUR = 23; // The timeline ends at 11:00 PM
    const TIMELINE_MINUTES = (END_HOUR - START_HOUR) * 60;
    const LANE_TOPS = [25, 45, 65, 85]; // Percent from the top, below the hour labels

    // Local calendar date as YYYY-MM-DD. toISOString() would use UTC and can shift the day.
    function toDateKey(date) {
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${date.getFullYear()}-${month}-${day}`;
    }

    // "HH:MM" <-> minutes after midnight
    function toTimeValue(minutes) {
        return `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
    }

    function toMinutes(timeValue) {
        const [hours, minutes] = timeValue.split(':').map(Number);
        return hours * 60 + minutes;
    }

    Alpine.data('schedule', () => {
        const today = new Date();

        return {
            monthNames: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
            hours: Array.from({ length: END_HOUR - START_HOUR }, (_, i) => START_HOUR + i),
            currentMonth: today.getMonth(),
            currentYear: today.getFullYear(),
            selectedDate: toDateKey(today),
            now: today,

            // Time block modal
            showTimeBlockModal: false,
            editingItemId: null,
            selectedTaskId: '',
            startTime: '',
            endTime: '',

            init() {
                // Keeps the current-time line and "today" up to date
                setInterval(() => { this.now = new Date(); }, 60 * 1000);
            },

            get todayKey() {
                return toDateKey(this.now);
            },

            // Six-row-or-less grid of whole weeks around the current month
            get days() {
                const firstDay = new Date(this.currentYear, this.currentMonth, 1);
                const lastDay = new Date(this.currentYear, this.currentMonth + 1, 0);
                const cellCount = Math.ceil((firstDay.getDay() + lastDay.getDate()) / 7) * 7;

                return Array.from({ length: cellCount }, (_, i) => {
                    const date = new Date(this.currentYear, this.currentMonth, i - firstDay.getDay() + 1);
                    return {
                        day: date.getDate(),
                        date: toDateKey(date),
                        isCurrentMonth: date.getMonth() === this.currentMonth
                    };
                });
            },

            shiftMonth(offset) {
                const date = new Date(this.currentYear, this.currentMonth + offset, 1);
                this.currentMonth = date.getMonth();
                this.currentYear = date.getFullYear();
            },

            get selectedDateFormatted() {
                return new Date(this.selectedDate + 'T00:00:00')
                    .toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
            },

            formatHour(hour) {
                return `${hour % 12 || 12} ${hour < 12 ? 'AM' : 'PM'}`;
            },

            formatTime(totalMinutes) {
                const hour = Math.floor(totalMinutes / 60);
                const minute = String(totalMinutes % 60).padStart(2, '0');
                return `${hour % 12 || 12}:${minute} ${hour < 12 ? 'AM' : 'PM'}`;
            },

            getTaskTitle(taskId) {
                return this.$store.todos.find(taskId)?.todo || 'Unknown Task';
            },

            get scheduledItemsForSelectedDate() {
                return this.$store.todos.scheduledItems.filter(item => item.date === this.selectedDate);
            },

            get availableTasksForScheduling() {
                const scheduledTaskIds = new Set(this.scheduledItemsForSelectedDate.map(item => item.taskId));
                return this.$store.todos.items.filter(item =>
                    !item.isCluster && !item.completed && item.todo.trim() !== '' && !scheduledTaskIds.has(item.id)
                );
            },

            // Overlapping blocks go in separate rows: each block takes the first row that is free at its start
            get laneByItemId() {
                const laneEnds = [];
                const lanes = {};
                [...this.scheduledItemsForSelectedDate]
                    .sort((a, b) => a.startTimeMinutes - b.startTimeMinutes)
                    .forEach(item => {
                        let lane = laneEnds.findIndex(end => end <= item.startTimeMinutes);
                        if (lane === -1) lane = laneEnds.length;
                        laneEnds[lane] = item.endTimeMinutes;
                        lanes[item.id] = Math.min(lane, LANE_TOPS.length - 1);
                    });
                return lanes;
            },

            getTaskBlockStyle(item) {
                const left = (item.startTimeMinutes - START_HOUR * 60) / TIMELINE_MINUTES * 100;
                const width = (item.endTimeMinutes - item.startTimeMinutes) / TIMELINE_MINUTES * 100;
                const lane = this.laneByItemId[item.id] ?? 0;
                return `left: ${left}%; width: ${Math.max(width, 3)}%; top: ${LANE_TOPS[lane]}%; height: 15%; z-index: ${30 - lane};`;
            },

            openTimeBlockModal(startMinutes, endMinutes, existingItem = null) {
                this.startTime = toTimeValue(startMinutes);
                this.endTime = toTimeValue(endMinutes);
                this.editingItemId = existingItem?.id ?? null;
                this.selectedTaskId = existingItem?.taskId ?? '';
                this.showTimeBlockModal = true;
            },

            closeTimeBlockModal() {
                this.showTimeBlockModal = false;
                this.editingItemId = null;
                this.selectedTaskId = '';
            },

            get canSave() {
                return Boolean(this.selectedTaskId) && toMinutes(this.endTime) > toMinutes(this.startTime);
            },

            saveScheduledTask() {
                if (!this.canSave) return;

                this.$store.todos.saveScheduledItem({
                    id: this.editingItemId || crypto.randomUUID(),
                    taskId: this.selectedTaskId,
                    date: this.selectedDate,
                    startTimeMinutes: toMinutes(this.startTime),
                    endTimeMinutes: toMinutes(this.endTime)
                });
                this.closeTimeBlockModal();
            },

            deleteScheduledTask() {
                this.$store.todos.removeScheduledItem(this.editingItemId);
                this.closeTimeBlockModal();
            }
        };
    });
});
</script>
