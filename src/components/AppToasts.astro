---
// In-app toasts, stacked in the bottom corner. Anything can fire one with a window
// "app-toast" CustomEvent (src/lib/notifications.ts dispatchToast(), or directly);
// they show even when browser notifications are blocked.
// Detail: { title, body?, actionLabel?, onAction? }. The optional action renders
// one quiet text button (e.g. "Undo") that runs onAction() and dismisses the toast.
---

<div
    x-data="appToasts"
    x-on:app-toast.window="add($event.detail)"
    class="fixed z-50 bottom-4 right-4 left-4 sm:left-auto sm:w-80 flex flex-col gap-2 pointer-events-none"
    role="status"
    aria-live="polite"
>
    <template x-for="toast in toasts" :key="toast.id">
        <div
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="panel pointer-events-auto flex items-start gap-3 p-3.5"
        >
            <svg class="w-4 h-4 mt-1 shrink-0 text-[color:var(--teal-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-900 dark:text-white" x-text="toast.title"></p>
                <p x-show="toast.body" class="text-sm text-gray-600 dark:text-gray-300" x-text="toast.body"></p>
            </div>
            <button
                x-show="toast.actionLabel && toast.onAction"
                type="button"
                x-on:click="runAction(toast)"
                class="self-center shrink-0 px-2.5 py-1 rounded-lg text-sm font-semibold text-teal-700 hover:bg-teal-50 dark:text-teal-300 dark:hover:bg-teal-900/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 transition-colors"
                x-text="toast.actionLabel"
            ></button>
            <button
                type="button"
                x-on:click="dismiss(toast.id)"
                class="touch-target inline-flex items-center justify-center p-1 -m-1 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
                aria-label="Dismiss"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    </template>
</div>

<script>
    const SHOW_FOR_MS = 8000;
    // Action toasts (Undo) get a longer window: the point is that the user has
    // time to read the toast and decide before the action becomes permanent.
    const ACTION_SHOW_FOR_MS = 12000;

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('appToasts', () => ({
            toasts: [],
            nextId: 1,
            timers: new Map(),

            add({ title, body = '', actionLabel = '', onAction = null }) {
                const id = this.nextId++;
                const next = [...this.toasts, { id, title, body, actionLabel, onAction }];
                for (const dropped of next.slice(0, Math.max(0, next.length - 3))) {
                    clearTimeout(this.timers.get(dropped.id));
                    this.timers.delete(dropped.id);
                }
                this.toasts = next.slice(-3);
                this.timers.set(id, setTimeout(() => this.dismiss(id), actionLabel ? ACTION_SHOW_FOR_MS : SHOW_FOR_MS));
            },

            runAction(toast) {
                const action = toast.onAction;
                this.dismiss(toast.id);
                action?.();
            },

            dismiss(id) {
                clearTimeout(this.timers.get(id));
                this.timers.delete(id);
                this.toasts = this.toasts.filter(toast => toast.id !== id);
            }
        }));
    });
</script>
