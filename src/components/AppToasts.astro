---
// In-app reminders from src/lib/notifications.ts ("app-toast" window events), stacked
// in the bottom corner. They show even when browser notifications are blocked.
---

<div
    x-data="appToasts"
    x-on:app-toast.window="add($event.detail)"
    class="fixed z-50 bottom-4 right-4 left-4 sm:left-auto sm:w-80 flex flex-col gap-2 pointer-events-none"
    role="status"
    aria-live="polite"
>
    <template x-for="toast in toasts" :key="toast.id">
        <div
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="pointer-events-auto flex items-start gap-3 p-3.5 rounded-2xl bg-white/90 dark:bg-slate-800/90 backdrop-blur-xl shadow-lg ring-1 ring-black/5 dark:ring-white/10"
        >
            <span class="mt-0.5 grid place-items-center w-7 h-7 shrink-0 rounded-lg bg-teal-50 text-teal-700 dark:bg-teal-900/40 dark:text-teal-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-900 dark:text-white" x-text="toast.title"></p>
                <p class="text-sm text-gray-600 dark:text-gray-300" x-text="toast.body"></p>
            </div>
            <button
                type="button"
                x-on:click="dismiss(toast.id)"
                class="touch-target inline-flex items-center justify-center p-1 -m-1 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
                aria-label="Dismiss"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    </template>
</div>

<script>
    const SHOW_FOR_MS = 8000;

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('appToasts', () => ({
            toasts: [],
            nextId: 1,

            add({ title, body }) {
                const id = this.nextId++;
                this.toasts = [...this.toasts, { id, title, body }].slice(-3);
                setTimeout(() => this.dismiss(id), SHOW_FOR_MS);
            },

            dismiss(id) {
                this.toasts = this.toasts.filter(toast => toast.id !== id);
            }
        }));
    });
</script>
