<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('zenTodoList', () => ({
            get tasks() {
                return this.$store.todos.items.filter(item => !item.isCluster);
            },

            get currentTodo() {
                return this.$store.todos.nextTask;
            },

            get hasCurrentTodo() {
                return Boolean(this.currentTodo);
            },

            get hasTasks() {
                return this.tasks.length > 0;
            },

            get isAllTasksComplete() {
                return this.hasTasks && !this.currentTodo;
            },

            get currentClusterName() {
                const parentId = this.currentTodo?.parentId;
                return parentId ? this.$store.todos.find(parentId)?.todo ?? null : null;
            },

            // "position/total" of the current task within its cluster
            get currentClusterProgress() {
                const parentId = this.currentTodo?.parentId;
                if (!parentId) return '';
                const clusterTasks = this.tasks.filter(task => task.parentId === parentId);
                const position = clusterTasks.findIndex(task => task.id === this.currentTodo.id) + 1;
                return `${position}/${clusterTasks.length}`;
            },

            // The two tasks after this one, in the order Zen mode will show them
            get upcoming() {
                const todos = this.$store.todos;
                const current = this.currentTodo;
                return [...todos.openTasks]
                    .sort((a, b) => Number(Boolean(b.startedAt)) - Number(Boolean(a.startedAt)))
                    .filter(task => task.id !== current?.id && (!task.parentId || !todos.skippedClusters.includes(task.parentId)))
                    .slice(0, 2);
            },

            get completedCount() {
                return this.tasks.filter(task => task.completed).length;
            },

            get taskCompletionLabel() {
                return `Completed: ${this.completedCount}/${this.tasks.length}`;
            },

            get completionPercentage() {
                return this.hasTasks ? Math.round((this.completedCount / this.tasks.length) * 100) : 0;
            },

            completeCurrentTodo() {
                const current = this.currentTodo;
                if (!current) return;

                const isLastTask = !this.tasks.some(task => !task.completed && task.id !== current.id);
                this.$store.todos.toggleTodo(current.id);

                if (isLastTask) {
                    const isDarkMode = document.documentElement.classList.contains('dark');
                    window.jsConfetti.addConfetti({
                        confettiColors: isDarkMode 
                            ? ['#0d9488', '#14b8a6', '#2dd4bf', '#99f6e4', '#FFFFFF']
                            : ['#0d9488', '#14b8a6', '#2dd4bf', '#FFFFFF', '#F3F4F6'],
                        confettiNumber: 200
                    });
                }
            },
            
            skipTask() {
                if (this.currentTodo?.parentId) {
                    this.$store.todos.skipTaskToEndOfCluster(this.currentTodo.id);
                }
            },
            
            skipCluster() {
                if (this.currentTodo?.parentId) {
                    this.$store.todos.skipCluster(this.currentTodo.parentId);
                }
            }
        }));
    });
</script>

<style>
    .progress-bar {
        transition: width 0.5s ease-in-out;
    }

    /* Ambient background: three soft glows drifting slowly */
    .zen-orb { animation: zen-drift 14s ease-in-out infinite alternate; }
    .zen-orb-2 { animation-duration: 18s; animation-direction: alternate-reverse; }
    .zen-orb-3 { animation-duration: 22s; }
    @keyframes zen-drift {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(3rem, 2rem) scale(1.15); }
        100% { transform: translate(-2rem, 3rem) scale(0.95); }
    }
</style>

<!-- Zen Mode Component -->
<div
    x-data="zenTodoList"
    x-cloak
    class="relative isolate overflow-hidden w-full max-w-4xl mx-auto rounded-2xl bg-white/80 dark:bg-slate-800/70 backdrop-blur-sm shadow-sm ring-1 ring-black/5 dark:ring-white/10 p-6"
>
    <!-- Ambient background, turned on under Customize -->
    <div x-show="$store.settings.zenAmbient" x-transition.opacity.duration.700ms class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
        <span class="zen-orb absolute -top-24 -left-16 w-80 h-80 rounded-full bg-teal-400/25 blur-3xl"></span>
        <span class="zen-orb zen-orb-2 absolute -bottom-28 -right-10 w-96 h-96 rounded-full bg-indigo-400/20 blur-3xl"></span>
        <span class="zen-orb zen-orb-3 absolute top-1/3 left-1/2 w-64 h-64 rounded-full bg-fuchsia-400/10 blur-3xl"></span>
    </div>

    <!-- Customize: which extras Zen mode shows -->
    <div class="absolute top-4 right-4 z-20" x-data="{ open: false }" x-on:click.outside="open = false" x-on:keydown.escape="open = false">
        <button
            type="button"
            x-on:click="open = !open"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-900/5 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-white/10 transition-colors"
            x-bind:aria-expanded="open"
            aria-label="Customize Zen mode"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
            <span class="hidden sm:inline">Customize</span>
        </button>
        <div x-show="open" x-cloak x-transition.opacity class="absolute right-0 top-full mt-2 w-72 rounded-xl bg-white dark:bg-slate-800 shadow-xl ring-1 ring-black/10 dark:ring-white/10 p-2 text-left">
            <p class="px-2 pt-1 pb-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Show in Zen mode</p>
            <template x-for="option in $store.settings.zenOptions" :key="option.key">
                <label class="flex items-start gap-3 px-2 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer">
                    <input
                        type="checkbox"
                        class="mt-0.5 w-4 h-4 rounded border-gray-300 dark:border-slate-500 text-teal-600 focus:ring-teal-500 dark:bg-slate-700"
                        x-bind:checked="$store.settings[option.key]"
                        x-on:change="$store.settings.update({ [option.key]: $event.target.checked })"
                    />
                    <span>
                        <span class="block text-sm font-medium text-gray-900 dark:text-white" x-text="option.label"></span>
                        <span class="block text-xs text-gray-500 dark:text-gray-400" x-text="option.hint"></span>
                    </span>
                </label>
            </template>
        </div>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-8 text-gray-900 dark:text-white">Zen Mode</h1>

    <div class="flex flex-col items-center justify-center">
        <!-- Current Todo Display -->
        <div 
            x-show="!isAllTasksComplete" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class="w-full"
        >
            <div class="flex flex-col items-center space-y-6 p-8 rounded-lg shadow-inner transition-colors" x-bind:class="$store.settings.zenAmbient ? 'bg-white/50 dark:bg-slate-900/40 backdrop-blur-sm' : 'bg-gray-50 dark:bg-slate-700'">
                <template x-if="hasCurrentTodo">
                    <div 
                        class="flex flex-col items-center space-y-6"
                        x-transition:enter="transition ease-out duration-200 delay-150"
                        x-transition:enter-start="opacity-0 translate-y-4"
                        x-transition:enter-end="opacity-100 translate-y-0"
                    >
                        <!-- Show cluster if the task belongs to one -->
                        <div 
                            x-show="currentClusterName && $store.settings.zenShowCluster" 
                            class="text-sm px-3 py-1 bg-teal-100 dark:bg-teal-900/30 text-teal-800 dark:text-teal-300 rounded-full flex items-center gap-2"
                        >
                            <span x-text="currentClusterName"></span>
                            <!-- Position of this task within its cluster -->
                            <span 
                                class="text-xs px-1.5 py-0.5 bg-white dark:bg-slate-800 text-teal-700 dark:text-teal-400 rounded-full whitespace-nowrap"
                                x-text="currentClusterProgress"
                            ></span>
                        </div>
                        
                        <p 
                            class="text-2xl text-center text-gray-800 dark:text-gray-200" 
                            x-text="currentTodo?.todo"
                        ></p>
                        <span
                            x-show="currentTodo?.dueDate && $store.settings.zenShowDue"
                            class="-mt-3 text-xs font-medium px-2 py-0.5 rounded-md"
                            x-bind:class="currentTodo?.dueDate ? $dates.dueClass(currentTodo.dueDate) : ''"
                            x-text="currentTodo?.dueDate ? $dates.dueText(currentTodo.dueDate).replace(/^d/, 'D') : ''"
                        ></span>
                        <button 
                            @click="completeCurrentTodo"
                            aria-label="Mark current task as complete"
                            class="px-6 py-3 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors focus:ring-4 focus:ring-teal-200 dark:focus:ring-teal-900"
                        >
                            Complete
                        </button>
                    </div>
                </template>

                <template x-if="!hasTasks">
                    <div class="text-center py-8">
                        <p class="text-xl text-gray-500 dark:text-gray-400">No tasks to display</p>
                        <p class="text-gray-400 dark:text-gray-500 mt-2">Add some tasks to get started</p>
                    </div>
                </template>
            </div>
        </div>

        <!-- Task Management Buttons -->
        <div 
            x-show="hasCurrentTodo" 
            x-transition:enter="transition ease-out duration-300 delay-100"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            class="flex justify-center gap-3 mt-4"
        >
            <button 
                @click="skipTask"
                x-show="currentTodo?.parentId"
                aria-label="Skip this task for now"
                class="px-4 py-2 bg-white dark:bg-slate-700 text-teal-600 dark:text-teal-400 border border-teal-300 dark:border-teal-800 rounded-lg hover:bg-teal-50 dark:hover:bg-teal-900/30 transition-colors focus:ring-2 focus:ring-teal-200 dark:focus:ring-teal-900 flex items-center gap-2 text-sm"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061A1.125 1.125 0 0 1 3 16.811V8.69ZM12.75 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061a1.125 1.125 0 0 1-1.683-.977V8.69Z" />
                </svg>
                Skip Task
            </button>
            
            <button 
                @click="skipCluster"
                x-show="currentTodo?.parentId"
                aria-label="Skip entire cluster"
                class="px-4 py-2 bg-white dark:bg-slate-700 text-teal-600 dark:text-teal-400 border border-teal-300 dark:border-teal-800 rounded-lg hover:bg-teal-50 dark:hover:bg-teal-900/30 transition-colors focus:ring-2 focus:ring-teal-200 dark:focus:ring-teal-900 flex items-center gap-2 text-sm"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061A1.125 1.125 0 0 1 3 16.811V8.69ZM12.75 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061a1.125 1.125 0 0 1-1.683-.977V8.69Z" />
                </svg>
                Skip Cluster
            </button>
        </div>

        <!-- Focus timer -->
        <div x-show="$store.settings.zenShowTimer && hasCurrentTodo" x-cloak class="mt-6 flex items-center gap-3 px-4 py-2 rounded-full bg-white/70 dark:bg-slate-700/60 ring-1 ring-black/5 dark:ring-white/10">
            <span class="relative flex w-2 h-2" aria-hidden="true">
                <span x-show="$store.pomoState.isRunning" class="absolute inline-flex w-full h-full rounded-full bg-teal-400 opacity-75 animate-ping"></span>
                <span class="relative inline-flex w-2 h-2 rounded-full" x-bind:class="$store.pomoState.isRunning ? 'bg-teal-500' : 'bg-gray-400'"></span>
            </span>
            <span class="text-lg font-semibold tabular-nums text-gray-900 dark:text-white" x-text="`${$store.pomoState.digits.slice(0, 2)}:${$store.pomoState.digits.slice(2)}`"></span>
            <span class="text-sm text-gray-500 dark:text-gray-400" x-text="$store.pomoState.currentPresetName"></span>
            <button
                type="button"
                x-on:click="$store.pomoState.isRunning ? $store.pomoState.pauseTimer() : $store.pomoState.startFocus()"
                class="ml-1 px-3 py-1 text-sm font-semibold rounded-full bg-teal-600 text-white hover:bg-teal-700 transition-colors"
                x-text="$store.pomoState.isRunning ? 'Pause' : 'Focus'"
            ></button>
        </div>

        <!-- Up next -->
        <div x-show="$store.settings.zenShowNext && upcoming.length" x-cloak class="w-full mt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">Up next</p>
            <ol class="space-y-2">
                <template x-for="task in upcoming" :key="task.id">
                    <li class="flex items-center gap-3 rounded-lg px-3 py-2 bg-white/60 dark:bg-slate-700/40 ring-1 ring-black/5 dark:ring-white/5 text-sm text-gray-600 dark:text-gray-300">
                        <span class="w-1.5 h-1.5 rounded-full shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor(task.parentId)};`"></span>
                        <span class="min-w-0 truncate" x-text="task.todo"></span>
                        <span x-show="task.parentId" class="ml-auto shrink-0 text-xs text-gray-400 dark:text-gray-500" x-text="$store.todos.clusterName(task.parentId)"></span>
                    </li>
                </template>
            </ol>
        </div>

        <!-- All Tasks Complete Message -->
        <div 
            x-show="isAllTasksComplete" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            class="text-center py-8"
        >
            <p class="text-2xl text-gray-500 dark:text-gray-400 font-medium">All tasks complete!</p>
            <p class="text-gray-500 dark:text-gray-500 mt-2">Great job! Add more tasks or take a break.</p>
        </div>

        <!-- Progress Bar -->
        <div class="w-full mt-8" x-show="hasTasks && $store.settings.zenShowProgress">
            <div class="flex justify-between text-sm text-gray-600 dark:text-gray-400 mb-2">
                <span x-text="taskCompletionLabel"></span>
                <span x-text="completionPercentage + '%'"></span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
                <div 
                    class="bg-teal-500 h-2.5 rounded-full progress-bar" 
                    :style="`width: ${completionPercentage}%`"
                ></div>
            </div>
        </div>
    </div>

</div>