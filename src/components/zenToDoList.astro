<script>
    import { celebrate } from '../lib/confetti';
    import { estimateLabel } from '../lib/estimates';

    document.addEventListener('alpine:init', () => {
        Alpine.data('zenTodoList', () => ({
            get tasks() {
                return this.$store.todos.items.filter(item => !item.isCluster);
            },

            get currentTodo() {
                return this.$store.todos.nextTask;
            },

            get hasCurrentTodo() {
                return Boolean(this.currentTodo);
            },

            get hasTasks() {
                return this.tasks.length > 0;
            },

            get isAllTasksComplete() {
                return this.hasTasks && !this.currentTodo;
            },

            get currentClusterName() {
                const parentId = this.currentTodo?.parentId;
                return parentId ? this.$store.todos.find(parentId)?.todo ?? null : null;
            },

            // "position/total" of the current task within its cluster
            get currentClusterProgress() {
                const parentId = this.currentTodo?.parentId;
                if (!parentId) return '';
                const clusterTasks = this.tasks.filter(task => task.parentId === parentId);
                const position = clusterTasks.findIndex(task => task.id === this.currentTodo.id) + 1;
                return `${position}/${clusterTasks.length}`;
            },

            // "About 10 min · Biology (2/5)" (or "No estimate yet" when unestimated)
            get currentMeta() {
                const task = this.currentTodo;
                if (!task) return '';
                const parts = [estimateLabel(task.estimateMinutes)];
                if (this.currentClusterName && this.$store.settings.zenShowCluster) {
                    parts.push(`${this.currentClusterName} (${this.currentClusterProgress})`);
                }
                return parts.join(' · ');
            },

            // "Resume" only when the paused focus session is for this task. Else the button starts a new one.
            get focusLabel() {
                const pomo = this.$store.pomoState;
                if (pomo.isRunning) return 'Pause';
                const pausedHere = pomo.status === 'paused' && !pomo.isBreak && (pomo.focusTask?.id ?? '') === this.currentTodo?.id;
                return pausedHere ? 'Resume' : 'Begin focus';
            },

            toggleFocus() {
                const pomo = this.$store.pomoState;
                pomo.isRunning ? pomo.pauseTimer() : pomo.startFocus(this.currentTodo?.id);
            },

            // The two tasks after this one, in the order Zen mode will show them
            get upcoming() {
                const todos = this.$store.todos;
                const current = this.currentTodo;
                return todos.zenTaskOrder
                    .filter(task => task.id !== current?.id && (!task.parentId || !todos.skippedClusters.includes(task.parentId)))
                    .slice(0, 2);
            },

            get completedCount() {
                return this.tasks.filter(task => task.completed).length;
            },

            get taskCompletionLabel() {
                return `${this.completedCount} of ${this.tasks.length} done`;
            },

            get completionPercentage() {
                return this.hasTasks ? Math.round((this.completedCount / this.tasks.length) * 100) : 0;
            },

            completeCurrentTodo() {
                const current = this.currentTodo;
                if (!current) return;

                this.$store.todos.toggleTodo(current.id);
                // Confetti is for Zen mode only
                celebrate(this.$store.todos.milestoneOf(current));
            },
            
            skipTask() {
                if (this.currentTodo) {
                    this.$store.todos.skipTaskToEndOfCluster(this.currentTodo.id);
                }
            },
            
            skipCluster() {
                if (this.currentTodo?.parentId) {
                    this.$store.todos.skipCluster(this.currentTodo.parentId);
                }
            }
        }));
    });
</script>

<style>
    .progress-bar {
        transition: width 0.5s ease-in-out;
    }
</style>

<!-- Zen Mode Component. The wrapper in tabs.astro provides the shared task-and-quote
     card surface, with ZenBackdrop behind both when a background is chosen. -->
<div
    x-data="zenTodoList"
    x-cloak
    class="relative isolate overflow-hidden w-full max-w-4xl mx-auto rounded-2xl p-6"
    x-bind:class="$store.settings.zenBackground === 'desk' && 'pt-32'"
>
    <!-- The garden gets a small open vista above the frosted task surface, so its stones
         and pine stay visible instead of hiding behind the task or quote on tall screens. -->
    <div class="flex flex-col items-center justify-center">
        <!-- Current Todo Display: the next step on the left, the focus timer on the right -->
        <div 
            x-show="!isAllTasksComplete" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class="w-full"
        >
            <div class="p-6 sm:p-8 rounded-xl ring-1 ring-black/5 dark:ring-white/5 transition-colors" x-bind:class="$store.settings.zenBackground !== 'none' ? 'bg-white/60 dark:bg-slate-900/50 backdrop-blur-sm' : 'bg-gray-50 dark:bg-slate-700/40'">
                <template x-if="hasCurrentTodo">
                    <div 
                        class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
                        x-transition:enter="transition ease-out duration-200 delay-150"
                        x-transition:enter-start="opacity-0 translate-y-4"
                        x-transition:enter-end="opacity-100 translate-y-0"
                    >
                        <div class="min-w-0 flex flex-col items-center sm:items-start text-center sm:text-left space-y-4">
                            <p class="eyebrow">Your next step</p>
                            <p
                                x-ref="currentTaskTitle"
                                tabindex="-1"
                                class="-mt-2 editorial text-2xl sm:text-3xl font-normal tracking-tight text-gray-900 dark:text-gray-100 break-words max-w-full"
                                x-text="currentTodo?.todo"
                            ></p>
                            <!-- "About 10 min · Biology (2/5)" -->
                            <p x-show="currentMeta" class="-mt-2 text-sm text-gray-600 dark:text-gray-300" x-text="currentMeta"></p>
                            <span
                                x-show="currentTodo?.dueDate && $store.settings.zenShowDue"
                                class="text-xs font-medium px-2 py-0.5 rounded-md"
                                x-bind:class="currentTodo?.dueDate ? $dates.dueClass(currentTodo.dueDate) : ''"
                                x-text="currentTodo?.dueDate ? $dates.dueText(currentTodo.dueDate).replace(/^d/, 'D') : ''"
                            ></span>
                            <div class="flex flex-col items-center sm:items-start gap-2 pt-2">
                                <button type="button" x-on:click="toggleFocus" class="btn-primary touch-target px-6 py-2.5">
                                    <span x-text="focusLabel"></span>
                                    <span x-show="focusLabel === 'Begin focus'" aria-hidden="true">→</span>
                                </button>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Starting small counts.</p>
                            </div>
                            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                                <button
                                    type="button"
                                    x-on:click="completeCurrentTodo"
                                    aria-label="Mark current task as done"
                                    class="btn-secondary touch-target"
                                >
                                    Done
                                </button>
                                <button
                                    type="button"
                                    x-on:click="skipTask"
                                    aria-label="Not now: skip this task"
                                    class="btn-secondary touch-target"
                                >
                                    Not now
                                </button>
                                <button
                                    type="button"
                                    x-on:click="skipCluster"
                                    x-show="currentTodo?.parentId"
                                    aria-label="Skip this cluster of tasks"
                                    class="touch-target inline-flex items-center justify-center px-3 py-2 rounded-xl text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-900/5 dark:text-gray-300 dark:hover:text-white dark:hover:bg-white/10 transition-colors"
                                >
                                    Skip this cluster
                                </button>
                            </div>
                        </div>

                        <!-- Focus timer ring, at the length of the current phase -->
                        <div data-pomo-timer="zenmode" class="relative justify-self-center w-40 h-40 sm:w-44 sm:h-44">
                            <svg class="w-full h-full transition-opacity" x-bind:class="$store.pomoState.status === 'idle' && 'opacity-80'" viewBox="0 0 100 100" aria-hidden="true">
                                <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="5" class="text-gray-200 dark:text-slate-700" />
                                <circle
                                    cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"
                                    transform="rotate(-90 50 50)" stroke-dasharray="263.9"
                                    x-bind:stroke-dashoffset="263.9 - 263.9 * $store.pomoState.percentComplete / 100"
                                    x-bind:class="$store.pomoState.isRunning ? 'text-teal-600 dark:text-teal-400' : 'text-gray-500 dark:text-gray-400'"
                                />
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span class="text-3xl font-semibold tabular-nums tracking-tight text-gray-900 dark:text-white" x-text="`${$store.pomoState.digits.slice(0, 2)}:${$store.pomoState.digits.slice(2)}`"></span>
                                <span class="text-sm text-gray-500 dark:text-gray-400" x-text="$store.pomoState.phaseLabel"></span>
                            </div>
                        </div>
                    </div>
                </template>

                <template x-if="!hasTasks">
                    <div class="text-center py-8">
                        <p class="editorial text-2xl font-normal text-gray-700 dark:text-gray-300">No tasks yet. Add one to start.</p>
                        <button
                            type="button"
                            x-on:click="$dispatch('open-quick-add')"
                            class="btn-primary touch-target mt-4"
                        >
                            New task
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <!-- Up next -->
        <div x-show="$store.settings.zenShowNext && upcoming.length" x-cloak class="w-full mt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">Up next</p>
            <ol class="space-y-2">
                <template x-for="task in upcoming" :key="task.id">
                    <li class="flex items-center gap-3 rounded-lg px-3 py-2 bg-white/60 dark:bg-slate-700/40 ring-1 ring-black/5 dark:ring-white/5 text-sm text-gray-600 dark:text-gray-300">
                        <span class="w-1.5 h-1.5 rounded-full shrink-0" x-bind:style="`background-color: ${$store.todos.clusterColor(task.parentId)};`"></span>
                        <span class="min-w-0 truncate" x-text="task.todo"></span>
                        <span x-show="task.parentId" class="ml-auto shrink-0 text-xs text-gray-500 dark:text-gray-400" x-text="$store.todos.clusterName(task.parentId)"></span>
                    </li>
                </template>
            </ol>
        </div>

        <!-- All Tasks Complete Message -->
        <div 
            x-show="isAllTasksComplete" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            class="text-center py-8"
        >
            <p class="editorial text-2xl font-normal text-gray-700 dark:text-gray-300">That's everything for now.</p>
            <p class="text-gray-500 dark:text-gray-400 mt-2">Take a break, or add another task.</p>
            <button
                type="button"
                x-on:click="$dispatch('open-quick-add')"
                class="btn-primary touch-target mt-4"
            >
                New task
            </button>
        </div>

        <!-- Progress Bar -->
        <div class="w-full mt-8" x-show="hasTasks && $store.settings.zenShowProgress">
            <div class="flex justify-between text-sm text-gray-600 dark:text-gray-400 mb-2">
                <span x-text="taskCompletionLabel"></span>
                <span x-text="completionPercentage + '%'"></span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
                <div 
                    class="bg-teal-500 h-2 rounded-full progress-bar" 
                    :style="`width: ${completionPercentage}%`"
                ></div>
            </div>
        </div>
    </div>

</div>