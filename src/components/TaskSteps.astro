---
import BreakdownPanel from './BreakdownPanel.astro';

interface Props {
    taskId?: string; // Alpine expression; TaskRow provides task.id
    zen?: boolean;
}

const { taskId = 'task.id', zen = false } = Astro.props;
const box = 'rounded-xl border border-gray-200 bg-white/85 p-3 text-left dark:border-slate-600 dark:bg-slate-900/70';
const checkbox = 'h-5 w-5 shrink-0 rounded border-gray-400 text-teal-700 focus:ring-teal-500 dark:border-slate-500 dark:bg-slate-800';
const action = 'min-h-9 rounded-lg px-2 py-1 text-sm font-medium text-teal-800 hover:bg-teal-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 dark:text-teal-300 dark:hover:bg-slate-700';
---

<div x-data={`taskSteps(() => ${taskId})`} x-show="canShowSteps" x-cloak class:list={['min-w-0 space-y-2', zen ? 'w-full max-w-xl' : 'w-full']}>
    {zen ? (
        <div x-show="savedSteps.length" class={box} aria-live="polite">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
                <p x-ref="stepHeading" tabindex="-1" class="font-semibold text-gray-800 dark:text-gray-100" x-text="nextStep ? 'Next step' : 'All steps complete'"></p>
                <p class="text-gray-600 dark:text-gray-300" x-text="stepProgress"></p>
            </div>
            <label x-show="nextStep" class="mt-1 flex min-h-10 cursor-pointer items-center gap-3 text-gray-900 dark:text-gray-100">
                <input type="checkbox" class={checkbox} x-bind:checked="false" x-on:change="finishNextStep($event.currentTarget)" />
                <span class="min-w-0 flex-1 break-words" x-text="nextStep?.text"></span>
                <span x-show="nextStep?.minutes" class="shrink-0 text-xs text-gray-600 dark:text-gray-300" x-text="`${nextStep?.minutes} min`"></span>
            </label>
        </div>
    ) : (
        <details x-show="savedSteps.length" class={box}>
            <summary class="min-h-9 cursor-pointer py-1 text-sm font-semibold text-gray-800 dark:text-gray-100">
                <span x-text="stepProgress"></span>
            </summary>
            <p role="status" class="sr-only" x-text="stepProgress"></p>
            <ul class="space-y-1">
                <template x-for="step in savedSteps" x-bind:key="step.id">
                    <li>
                        <label class="flex min-h-9 cursor-pointer items-center gap-3 text-sm text-gray-900 dark:text-gray-100">
                            <input type="checkbox" class={checkbox} x-bind:checked="step.done" x-on:change="toggleSavedStep(step.id)" />
                            <span class="min-w-0 flex-1 break-words" x-text="step.text"></span>
                            <span x-show="step.minutes" class="shrink-0 text-xs text-gray-600 dark:text-gray-300" x-text="`${step.minutes} min`"></span>
                        </label>
                    </li>
                </template>
            </ul>
        </details>
    )}
    <div x-show="savedSteps.length" class="text-left">
        <button x-show="!confirming" type="button" x-ref="promote" x-on:click="showPromotion()" class={action}>Promote steps to cluster</button>
        <div x-show="confirming" x-on:keydown.escape.stop="hidePromotion()" class={box}>
            <p class="text-sm text-gray-700 dark:text-gray-200">Create a new cluster with a task for each step. Keep this task and checklist as they are.</p>
            <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" x-ref="promoteCancel" x-on:click="hidePromotion()" class={action}>Cancel</button>
                <button type="button" x-on:click="promote()" class="min-h-9 rounded-lg bg-teal-700 px-3 py-1 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500">Create cluster</button>
            </div>
        </div>
        <p x-show="promotionMessage" role="status" class="px-2 text-sm text-gray-700 dark:text-gray-200" x-text="promotionMessage"></p>
    </div>
    <BreakdownPanel taskId="stepTaskId" />
</div>

<script>
    import { cleanMinutes, cleanText } from '../lib/assist';
    import type { initAssistStore } from '../stores/assistStore';
    import type { Todo, TodoStep } from '../stores/todoStore';

    type StepTodos = {
        find(id: string): Todo | undefined;
        toggleStep(taskId: string, stepId: string): void;
        toggleTodo(id: string): void;
        createCluster(name: string): string;
        addTodo(text: string, fields: Partial<Todo>): string;
    };

    const todos = () => window.Alpine.store('todos') as unknown as StepTodos;
    const assist = () => window.Alpine.store('assist') as unknown as ReturnType<typeof initAssistStore>;

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('taskSteps', (activeTaskId: () => string | undefined) => ({
            confirming: false,
            promotionMessage: '',
            get stepTaskId() { return activeTaskId(); },
            get stepTask(): Todo | undefined { return this.stepTaskId ? todos().find(this.stepTaskId) : undefined; },
            get savedSteps(): TodoStep[] { return this.stepTask?.steps ?? []; },
            get canShowSteps(): boolean {
                const task = this.stepTask;
                if (!task || task.isCluster) return false;
                return Boolean(this.savedSteps.length || (!task.completed && task.todo.trim() && assist().aiStatus === 'ready' && assist().source === 'plus'));
            },
            get stepProgress(): string {
                return `${this.savedSteps.filter(step => step.done).length} of ${this.savedSteps.length} steps`;
            },
            get nextStep() { return this.savedSteps.find(step => !step.done); },
            init() {
                this.$watch('stepTaskId', () => {
                    this.confirming = false;
                    this.promotionMessage = '';
                });
            },
            toggleSavedStep(stepId: string) {
                if (this.stepTaskId) todos().toggleStep(this.stepTaskId, stepId);
            },
            finishNextStep(checkbox: HTMLInputElement) {
                const step = this.nextStep;
                if (!step) return;
                this.toggleSavedStep(step.id);
                checkbox.checked = false;
                if (!this.nextStep) this.$nextTick(() => this.$refs.stepHeading.focus());
            },
            showPromotion() {
                this.promotionMessage = '';
                this.confirming = true;
                this.$nextTick(() => this.$refs.promoteCancel.focus());
            },
            hidePromotion() {
                this.confirming = false;
                this.$nextTick(() => this.$refs.promote.focus());
            },
            promote() {
                const task = this.stepTask;
                if (!this.confirming || !task || task.isCluster) return;
                const steps = this.savedSteps
                    .map(step => ({ text: cleanText(step.text), minutes: cleanMinutes(step.minutes), completed: step.done }))
                    .filter(step => step.text);
                if (!steps.length) {
                    this.hidePromotion();
                    return;
                }
                const store = todos();
                const parentId = store.createCluster(task.todo);
                for (const { text, minutes, completed } of steps) {
                    const id = store.addTodo(text, { parentId, estimateMinutes: minutes });
                    if (completed) store.toggleTodo(id);
                }
                this.hidePromotion();
                this.promotionMessage = 'Cluster created. The original checklist is unchanged.';
            }
        }));
    });
</script>
