---
// A karesansui (dry landscape) garden in the brand's Paper, Mist and Pine.
// Keep the middle quiet for the task; the stones and planting frame its edges.
const rakeLines = Array.from({ length: 24 }, (_, i) => {
    const y = i * 34 - 60;
    return `M-100 ${y} C180 ${y - 70} 320 ${y + 100} 550 ${y + 64} S880 ${y - 40} 1100 ${y + 32}`;
});
const stoneRings = Array.from({ length: 7 }, (_, i) => ({ rx: 108 + i * 15, ry: 47 + i * 8 }));
const pineTufts = [
    [790, 70, 74, 24], [865, 98, 100, 30], [947, 53, 88, 28],
    [738, 112, 63, 21], [913, 151, 83, 24], [1010, 114, 96, 32]
];
---

<svg
    class="zen-garden absolute inset-0 w-full h-full stroke-none"
    aria-hidden="true"
    focusable="false"
    x-init="(still || paused) && $el.pauseAnimations()"
>
    <defs>
        <linearGradient id="zg-sand" x1="0" y1="0" x2="0.7" y2="1">
            <stop offset="0" class="[stop-color:#F7F5EF] dark:[stop-color:#172C2A]" />
            <stop offset="1" class="[stop-color:#E3E3DB] dark:[stop-color:#244642]" />
        </linearGradient>
        <linearGradient id="zg-stone" x1="0" y1="0" x2="0.8" y2="1">
            <stop offset="0" class="[stop-color:#606D66] dark:[stop-color:#547A75]" />
            <stop offset="1" class="[stop-color:#294540] dark:[stop-color:#0D1918]" />
        </linearGradient>
        <radialGradient id="zg-light">
            <stop offset="0" class="[stop-color:#D7B36A] dark:[stop-color:#DCE7DC]" stop-opacity="0.15" />
            <stop offset="1" class="[stop-color:#D7B36A] dark:[stop-color:#DCE7DC]" stop-opacity="0" />
        </radialGradient>
        <pattern id="zg-grain" width="29" height="23" patternUnits="userSpaceOnUse" class="fill-gray-600 dark:fill-gray-300">
            <circle cx="4" cy="6" r="0.7" />
            <circle cx="19" cy="17" r="0.6" />
        </pattern>
    </defs>

    <!-- The sand, rake lines, and light share the 1000x700 slice scaling of the other
         backgrounds, while separately anchored landmarks stay in the top vista on any card shape. -->
    <svg class="zen-garden-scene stroke-none" width="100%" height="100%" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice">
        <rect width="1000" height="700" fill="url(#zg-sand)" />
        <rect class="zen-garden-grain" width="1000" height="700" fill="url(#zg-grain)" opacity="0.1" />
        <g fill="none" class="stroke-gray-400/30 dark:stroke-slate-400/20" stroke-width="1.4">
            {rakeLines.map(d => <path d={d} />)}
        </g>
        <path d="M-20 40 Q300 70 610 22 T1020 34 L1020 -20 L-20 -20Z" class="fill-[#DCE7DC] dark:fill-[#0D1918]" />
        <path d="M-20 40 Q300 70 610 22 T1020 34" fill="none" class="stroke-gray-400/40 dark:stroke-slate-500/30" stroke-width="5" />
    </svg>

    <!-- An island of three weathered stones and moss, with concentric rake marks. -->
    <svg class="zen-garden-stones stroke-none" x="-3%" y="0" width="45%" height="128" viewBox="-225 -125 450 250">
    <g transform="rotate(-18)">
        <ellipse rx="214" ry="104" class="fill-gray-200 dark:fill-slate-700" />
        <g fill="none" class="stroke-gray-400/50 dark:stroke-slate-400/30" stroke-width="1.5">
            {stoneRings.map(({ rx, ry }) => <ellipse rx={rx} ry={ry} />)}
        </g>
        <ellipse cy="8" rx="106" ry="44" class="fill-[#9DAF99] dark:fill-[#294D43]" />
        <path d="M-101 5 Q-87 -24 -53 -20 Q-28 -45 5 -21 Q48 -35 86 -8 Q109 11 82 26 Q32 44 -21 29 Q-73 40 -101 5Z" class="fill-[#748B72] dark:fill-[#345C4C]" />
        <g class="fill-gray-900/15 dark:fill-slate-950/30">
            <ellipse cx="-34" cy="14" rx="48" ry="22" />
            <ellipse cx="28" cy="5" rx="38" ry="20" />
            <ellipse cx="69" cy="24" rx="24" ry="12" />
        </g>
        <g fill="url(#zg-stone)">
            <path d="M-83 3 L-74 -36 L-44 -67 L-15 -59 L7 -23 L2 7 Q-41 24 -83 3Z" />
            <path d="M-7 0 L3 -36 L30 -49 L53 -29 L61 5 Q30 20 -7 0Z" />
            <path d="M43 22 L52 -2 L75 -12 L91 5 L91 23 Q65 34 43 22Z" />
        </g>
        <g fill="none" class="stroke-gray-300/30 dark:stroke-slate-300/20" stroke-width="1.5">
            <path d="M-74 -36 L-44 -50 L-15 -59 M-44 -50 L-34 -12" />
            <path d="M3 -36 L26 -29 L30 -49 M26 -29 L39 2 M52 -2 L72 2 L75 -12" />
        </g>
    </g>
    </svg>

    <!-- Pine and a low garden wall sit at the far edge, not behind the text. -->
    <svg class="zen-garden-pine stroke-none" x="62%" y="0" width="42%" height="128" viewBox="650 0 400 250" preserveAspectRatio="xMaxYMin meet">
    <path d="M1050 246 Q937 217 935 134 Q922 85 862 72 M939 158 Q865 142 807 98 M935 134 Q992 95 1021 47" fill="none" class="stroke-gray-800 dark:stroke-slate-900" stroke-width="15" stroke-linecap="round" />
    <g class="fill-[#294D43] dark:fill-[#173F3A]">
        {pineTufts.map(([cx, cy, rx, ry]) => (
            <g>
                <ellipse cx={cx} cy={cy} rx={rx} ry={ry} />
                <ellipse cx={cx - rx * 0.3} cy={cy - 10} rx={rx * 0.65} ry={ry * 0.9} class="fill-[#496850] dark:fill-[#244C40]" />
                <path d={`M${cx - rx * 0.7} ${cy + 2} Q${cx} ${cy - ry * 0.5} ${cx + rx * 0.6} ${cy + 3}`} fill="none" class="stroke-[#748B72]/50 dark:stroke-[#547A75]/40" stroke-width="2" />
            </g>
        ))}
    </g>
    </svg>

    <!-- A few flat stepping stones lead out of frame. -->
    <svg class="zen-garden-steps stroke-none" x="42%" y="40" width="22%" height="88" viewBox="820 490 170 220" preserveAspectRatio="xMaxYMax meet">
    <g class="fill-gray-400/50 stroke-gray-500/25 dark:fill-slate-600/50 dark:stroke-slate-400/20" stroke-width="1.5">
        <path d="M846 710 Q835 686 856 672 L899 668 Q927 685 913 710Z" />
        <path d="M878 645 Q864 623 886 609 L924 612 Q947 628 927 648Z" />
        <path d="M904 585 Q894 568 914 556 L947 560 Q965 576 945 590Z" />
        <path d="M932 531 Q923 515 942 505 L969 510 Q983 525 967 537Z" />
    </g>
    </svg>

    <!-- Nested SVGs have their own SMIL clock: pause this on insertion too, before any
         Settings/tab event can sync it, including when selected under reduced motion. -->
    <svg class="stroke-none" width="100%" height="100%" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" x-init="(still || paused) && $el.pauseAnimations()">
    <ellipse cx="340" cy="220" rx="540" ry="380" fill="url(#zg-light)">
        <animateTransform attributeName="transform" type="translate" values="0 0; 45 20; 0 0" dur="60s" repeatCount="indefinite" />
    </ellipse>
    </svg>
</svg>
