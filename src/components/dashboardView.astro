---
---

<div
    x-data="{
        // Overall dashboard stats
        get activeTasks() {
            return $store.todos.items.filter(t => !t.isCluster && !t.completed).length;
        },
        get tasksCompleted() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            return $store.todos.items.filter(t => 
                !t.isCluster && 
                t.completed && 
                t.completedAt && // Make sure completedAt exists
                new Date(t.completedAt) >= today
            ).length;
        },
        get tasksByCluster() {
            // Group tasks by cluster
            const clusters = {};
            const tasks = $store.todos.items.filter(t => !t.isCluster && !t.completed);
            
            tasks.forEach(task => {
                const clusterId = task.parentId || 'unclustered';
                if (!clusters[clusterId]) {
                    clusters[clusterId] = [];
                }
                clusters[clusterId].push(task);
            });
            
            return clusters;
        },
        get clusterCount() {
            // Count all clusters, not just those with active tasks
            return $store.todos.clusters.length;
        },
        get mostPopulatedCluster() {
            let maxCount = 0;
            let clusterName = 'None';
            let clusterId = null;
            
            Object.entries(this.tasksByCluster).forEach(([id, tasks]) => {
                if (tasks.length > maxCount) {
                    maxCount = tasks.length;
                    clusterId = id;
                    // Find the cluster name
                    if (id === 'unclustered') {
                        clusterName = 'Unclustered';
                    } else {
                        const cluster = $store.todos.items.find(t => t.id === id);
                        clusterName = cluster ? cluster.todo : 'Unknown';
                    }
                }
            });
            
            return { name: clusterName, count: maxCount, id: clusterId };
        },
        get completionPercentage() {
            const totalTasks = this.activeTasks + this.tasksCompleted;
            return totalTasks > 0 ? Math.round((this.tasksCompleted / totalTasks) * 100) : 0;
        },
        get monthlyStats() {
            const now = new Date();
            const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
            return $store.todos.items.filter(t => 
                !t.isCluster && 
                t.completed && 
                t.completedAt && // Make sure completedAt exists
                new Date(t.completedAt) >= startOfMonth
            ).length;
        },
        get weeklyStats() {
            const now = new Date();
            const startOfWeek = new Date(now);
            startOfWeek.setDate(now.getDate() - now.getDay()); // Start of week (Sunday)
            startOfWeek.setHours(0, 0, 0, 0);
            
            return $store.todos.items.filter(t => 
                !t.isCluster && 
                t.completed && 
                t.completedAt && // Make sure completedAt exists
                new Date(t.completedAt) >= startOfWeek
            ).length;
        },
        
        // Cluster-specific dashboard
        selectedClusterId: null,
        
        get clusters() {
            return $store.todos.clusters;
        },

        get clusterName() {
            return $store.todos.find(this.selectedClusterId)?.todo ?? '';
        },
        
        get clusterTasks() {
            if (!this.selectedClusterId) return [];
            return $store.todos.items.filter(t => 
                !t.isCluster && 
                t.parentId === this.selectedClusterId
            );
        },
        
        get clusterCompletedTasks() {
            return this.clusterTasks.filter(t => t.completed).length;
        },
        
        get clusterActiveTasks() {
            return this.clusterTasks.filter(t => !t.completed).length;
        },
        
        get clusterCompletionPercentage() {
            const total = this.clusterTasks.length;
            return total > 0 ? Math.round((this.clusterCompletedTasks / total) * 100) : 0;
        },
        
        get recentlyCompletedTasks() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            return this.clusterTasks
                .filter(t => t.completed && t.completedAt && new Date(t.completedAt) >= today)
                .sort((a, b) => new Date(b.completedAt) - new Date(a.completedAt))
                .slice(0, 3); // Show only the 3 most recent
        },
        
        focusOnMostPopulatedCluster() {
            if (this.mostPopulatedCluster.id && this.mostPopulatedCluster.id !== 'unclustered') {
                this.selectedClusterId = this.mostPopulatedCluster.id;
            }
        }
    }"
>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Overall Dashboard -->
        <div>
            <h3 class="text-xl font-medium text-teal-800 dark:text-teal-300 mb-4">Today's Focus</h3>

            <!-- Active Tasks Summary -->
            <div class="mb-5">
                <p class="text-gray-700 dark:text-gray-300 mb-2">
                    You have <strong class="text-teal-700 dark:text-teal-400" x-text="activeTasks"></strong> active task(s) remaining.
                </p>
                <div class="flex items-center gap-3">
                    <div class="w-full bg-teal-100 dark:bg-teal-900 rounded-full h-2.5 overflow-hidden">
                        <div
                            class="bg-teal-500 h-2.5 rounded-full transition-all duration-500 ease-out"
                            :style="`width: ${completionPercentage}%`"
                        ></div>
                    </div>
                    <span class="text-sm font-medium text-teal-700 dark:text-teal-400" x-text="`${completionPercentage}%`"></span>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" x-show="activeTasks > 0 || tasksCompleted > 0">
                    <span x-text="tasksCompleted"></span> completed today
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" x-show="activeTasks === 0 && tasksCompleted === 0">
                    No active tasks. Time to add some or enjoy the calm!
                </p>
            </div>

            <!-- Task Distribution -->
            <div class="mb-5">
                <p class="text-gray-700 dark:text-gray-300 mb-2">
                    Your tasks are organized in <strong class="text-teal-700 dark:text-teal-400" x-text="clusterCount"></strong> cluster(s).
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400" x-show="mostPopulatedCluster.count > 0">
                    Most tasks in: <span class="font-medium text-teal-600 dark:text-teal-400" x-text="mostPopulatedCluster.name"></span>
                    (<span x-text="mostPopulatedCluster.count"></span> tasks)
                    <button 
                        @click="focusOnMostPopulatedCluster"
                        class="ml-2 text-xs px-2 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-400 hover:bg-teal-200 dark:hover:bg-teal-800/40 transition-colors"
                        x-show="mostPopulatedCluster.id && mostPopulatedCluster.id !== 'unclustered'"
                    >View</button>
                </p>
            </div>

            <!-- Completion Stats -->
            <div>
                <p class="text-gray-700 dark:text-gray-300 mb-2">
                    You've completed:
                </p>
                <div class="flex flex-col gap-1">
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        <span class="font-medium text-teal-600 dark:text-teal-400" x-text="tasksCompleted"></span> tasks today
                    </p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        <span class="font-medium text-teal-600 dark:text-teal-400" x-text="weeklyStats"></span> tasks this week
                    </p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        <span class="font-medium text-teal-600 dark:text-teal-400" x-text="monthlyStats"></span> tasks this month
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Cluster Dashboard -->
        <div>
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-medium text-teal-800 dark:text-teal-300">Cluster View</h3>
                <select 
                    @change="selectedClusterId = $event.target.value || null"
                    class="text-sm bg-white dark:bg-slate-700 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 rounded-md px-3 py-1.5 ml-4 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent"
                >
                    <option value="">Select a cluster</option>
                    <template x-for="cluster in clusters" :key="cluster.id">
                        <option 
                            :value="cluster.id"
                            :selected="cluster.id === selectedClusterId"
                            x-text="cluster.todo"
                        ></option>
                    </template>
                </select>
            </div>
            
            <div x-show="!selectedClusterId" class="text-center py-8 text-gray-500 dark:text-gray-400">
                <p>Select a cluster to view details</p>
            </div>
            
            <div x-show="selectedClusterId" class="space-y-6">
                <!-- Cluster Header -->
                <div class="flex items-center justify-between">
                    <h4 class="text-lg font-semibold text-gray-800 dark:text-white" x-text="clusterName"></h4>
                </div>
                
                <!-- Task Progress -->
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <p class="text-sm text-gray-700 dark:text-gray-300">
                            <span x-text="clusterActiveTasks"></span> active, <span x-text="clusterCompletedTasks"></span> completed
                        </p>
                        <span class="text-xs font-medium text-teal-700 dark:text-teal-400" x-text="`${clusterCompletionPercentage}%`"></span>
                    </div>
                    <div class="w-full bg-teal-100 dark:bg-teal-900 rounded-full h-2 overflow-hidden">
                        <div
                            class="bg-teal-500 h-2 rounded-full transition-all duration-500 ease-out"
                            :style="`width: ${clusterCompletionPercentage}%`"
                        ></div>
                    </div>
                </div>
                
                <!-- Recently Completed Tasks -->
                <div x-show="recentlyCompletedTasks.length > 0">
                    <h5 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Recently Completed</h5>
                    <ul class="space-y-1">
                        <template x-for="task in recentlyCompletedTasks" :key="task.id">
                            <li class="text-xs text-gray-600 dark:text-gray-400 flex items-center">
                                <svg class="h-3.5 w-3.5 text-teal-500 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span x-text="task.todo"></span>
                            </li>
                        </template>
                    </ul>
                </div>
                
                <!-- Task Distribution -->
                <div>
                    <h5 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Task Distribution</h5>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="bg-teal-50 dark:bg-teal-900/20 rounded-lg p-3 text-center">
                            <p class="text-xs text-gray-600 dark:text-gray-400">Active</p>
                            <p class="text-xl font-bold text-teal-600 dark:text-teal-400" x-text="clusterActiveTasks"></p>
                        </div>
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-3 text-center">
                            <p class="text-xs text-gray-600 dark:text-gray-400">Completed</p>
                            <p class="text-xl font-bold text-gray-600 dark:text-gray-400" x-text="clusterCompletedTasks"></p>
                        </div>
                    </div>
                </div>
                
                <!-- Actions -->
                <div class="flex justify-end">
                    <button 
                        @click="$dispatch('change-tab', { tab: 'taskmanager' })"
                        class="text-xs px-3 py-1.5 rounded-md bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-400 hover:bg-teal-200 dark:hover:bg-teal-800/40 transition-colors"
                    >Focus on Tasks</button>
                </div>
            </div>
        </div>
    </div>
</div>