---
// Optional 3-breath grounding transition before a focus session starts.
// Enabled via Settings > Timer ("Breathing start"), off by default.
// Respects prefers-reduced-motion with a static calm prompt and manual start.
import EnsoMark from './EnsoMark.astro';
---

<div
    x-data="breathingStart"
    x-on:overlay-opened.window="if ($store.pomoState.isBreathing && $event.detail.name !== 'breathing-start') { $event.detail.opener = returnFocus; returnFocus = null; $store.pomoState.cancelBreathing(); }"
    x-on:keydown.escape.window="if ($store.pomoState.isBreathing) $store.pomoState.cancelBreathing()"
    x-on:keydown.tab.window="if ($store.pomoState.isBreathing) trap($event)"
>
    <!-- Backdrop -->
    <div
        x-show="$store.pomoState.isBreathing"
        x-cloak
        x-transition.opacity.duration.200ms
        x-on:click="$store.pomoState.cancelBreathing()"
        class="fixed inset-0 z-50 bg-slate-900/35 backdrop-blur-sm"
        aria-hidden="true"
    ></div>

    <!-- Centered dialog -->
    <div
        x-show="$store.pomoState.isBreathing"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none"
    >
        <div
            x-show="$store.pomoState.isBreathing"
            x-transition:enter="transition ease-out duration-200 motion-reduce:transition-none"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-150 motion-reduce:transition-none"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            x-ref="panel"
            class="pointer-events-auto relative isolate overflow-hidden w-full max-w-sm rounded-2xl bg-white dark:bg-slate-900 p-7 sm:p-8 shadow-2xl ring-1 ring-black/5 dark:ring-white/10 text-center"
            role="dialog"
            aria-modal="true"
            aria-labelledby="breathing-start-title"
        >
            <span class="ripples text-teal-600 dark:text-teal-400" aria-hidden="true"></span>

            <p
                class="eyebrow"
                x-text="$store.pomoState.breathingReducedMotion
                    ? 'Before you begin'
                    : `Breath ${$store.pomoState.breathNumber} of ${$store.pomoState.breathCount}`"
            ></p>

            <!-- Breathing ensō ring -->
            <div class="relative mx-auto my-6 flex h-36 w-36 items-center justify-center" aria-hidden="true">
                <div
                    class="breathing-halo absolute inset-0 rounded-full bg-teal-100/80 dark:bg-teal-900/35"
                    x-bind:class="!$store.pomoState.breathingReducedMotion && ($store.pomoState.breathPhase === 'in' ? 'breathing-halo--in' : 'breathing-halo--out')"
                ></div>
                <div
                    class="breathing-mark relative flex h-24 w-24 items-center justify-center"
                    x-bind:class="!$store.pomoState.breathingReducedMotion && ($store.pomoState.breathPhase === 'in' ? 'breathing-mark--in' : 'breathing-mark--out')"
                >
                    <EnsoMark class="h-full w-full text-teal-700 dark:text-teal-300" />
                </div>
            </div>

            <h2
                id="breathing-start-title"
                class="editorial text-2xl sm:text-[1.75rem] font-normal tracking-tight text-gray-900 dark:text-white"
                aria-live="polite"
                x-text="$store.pomoState.breathPrompt"
            ></h2>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-300">Just this, for now.</p>

            <p
                x-show="$store.pomoState.activeTask"
                x-cloak
                class="mt-3 text-xs text-gray-500 dark:text-gray-400 truncate max-w-full"
                x-text="$store.pomoState.activeTask ? `Focusing on: ${$store.pomoState.activeTask.todo}` : ''"
            ></p>

            <!-- Quiet breath progress dots -->
            <div
                x-show="!$store.pomoState.breathingReducedMotion"
                class="mt-5 flex items-center justify-center gap-2"
                aria-hidden="true"
            >
                <template x-for="i in $store.pomoState.breathCount" :key="i">
                    <span
                        class="h-2 w-2 rounded-full transition-colors duration-300"
                        x-bind:class="i <= $store.pomoState.breathNumber ? 'bg-teal-600 dark:bg-teal-400' : 'bg-gray-200 dark:bg-slate-700'"
                    ></span>
                </template>
            </div>

            <!-- Controls -->
            <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
                <button
                    type="button"
                    x-ref="proceed"
                    x-on:click="$store.pomoState.skipBreathing()"
                    class="touch-target px-4 py-2"
                    x-bind:class="$store.pomoState.breathingReducedMotion ? 'btn-primary' : 'btn-secondary'"
                    x-text="$store.pomoState.breathingReducedMotion ? 'Begin focus' : 'Skip to focus'"
                ></button>
                <button
                    type="button"
                    x-on:click="$store.pomoState.cancelBreathing()"
                    class="touch-target inline-flex items-center justify-center rounded-lg px-3.5 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-900/5 dark:text-gray-300 dark:hover:text-white dark:hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
                >Cancel</button>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes breathing-halo-in {
        from { transform: scale(0.76); opacity: 0.45; }
        to { transform: scale(1); opacity: 0.9; }
    }
    @keyframes breathing-halo-out {
        from { transform: scale(1); opacity: 0.9; }
        to { transform: scale(0.76); opacity: 0.45; }
    }
    @keyframes breathing-mark-in {
        from { transform: scale(0.88); }
        to { transform: scale(1); }
    }
    @keyframes breathing-mark-out {
        from { transform: scale(1); }
        to { transform: scale(0.88); }
    }

    .breathing-halo--in {
        animation: breathing-halo-in 4s ease-in-out forwards;
    }
    .breathing-halo--out {
        animation: breathing-halo-out 4s ease-in-out forwards;
    }
    .breathing-mark--in {
        animation: breathing-mark-in 4s ease-in-out forwards;
    }
    .breathing-mark--out {
        animation: breathing-mark-out 4s ease-in-out forwards;
    }

    @media (prefers-reduced-motion: reduce) {
        .breathing-halo,
        .breathing-mark {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<script>
    import { trapFocus } from '../lib/focusTrap';

    document.addEventListener('alpine:init', () => {
        window.Alpine.data('breathingStart', () => ({
            returnFocus: null as HTMLElement | null,

            init() {
                this.$watch('$store.pomoState.isBreathing', (active: boolean) => {
                    if (active) {
                        const opened: { name: string; opener?: HTMLElement | null } = { name: 'breathing-start' };
                        window.dispatchEvent(new CustomEvent('overlay-opened', { detail: opened }));
                        this.returnFocus = opened.opener || (document.activeElement as HTMLElement | null);
                        this.$nextTick(() => (this.$refs.proceed as HTMLElement | undefined)?.focus());
                    } else {
                        if (this.returnFocus?.isConnected) this.returnFocus.focus();
                        this.returnFocus = null;
                    }
                });
            },

            trap(event: KeyboardEvent) {
                trapFocus(event, this.$refs.panel as HTMLElement);
            }
        }));
    });
</script>
