---
import data from '../data/site.json';
import { AREAS } from '../lib/nav';
import EnsoMark from './EnsoMark.astro';
import FooterLandscape from './FooterLandscape.astro';

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isAppPage = normalizedPath === '/' || normalizedPath === '/index.html';
const isPrinciples = normalizedPath === '/principles' || normalizedPath === '/principles.html';
const isRoadmap = normalizedPath === '/roadmap' || normalizedPath === '/roadmap.html';
---

<footer class="site-footer mt-auto w-full border-t border-gray-900/10 text-gray-900 dark:border-white/10 dark:text-gray-100" x-data>
  <div class="mx-auto grid w-full max-w-6xl gap-x-12 gap-y-8 px-6 pb-3 pt-10 sm:grid-cols-[1fr_auto_auto] sm:px-0 sm:pt-12">
    <div class="footer-intro">
      <a href="/" class="inline-flex min-h-11 items-center gap-2.5 rounded-sm text-sm font-medium tracking-tight" aria-label={`${data.siteName} home`}>
        <EnsoMark class="h-6 w-6" />
        <span>{data.siteName}</span>
      </a>
      <p class="editorial mt-4 max-w-sm text-[2rem] font-normal leading-[1.12] tracking-tight sm:text-4xl">
        A little space.<br />A next step.
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-gray-600 dark:text-gray-400">A calmer way from intention to action.</p>
    </div>

    <nav aria-label="Footer workspace" class="footer-workspace">
      <h2 class="eyebrow mb-2 text-gray-500 dark:text-gray-400">Your space</h2>
      <ul class="text-sm">
        {AREAS.map((area) => (
          <li>
            {isAppPage ? (
              <button type="button" @click={`$dispatch('change-area', { area: '${area.id}' })`} class="footer-link cursor-pointer">
                {area.label}
              </button>
            ) : (
              <a href={`/#${area.views[0]}`} class="footer-link">{area.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="About Zen Frame" class="footer-about">
      <h2 class="eyebrow mb-2 text-gray-500 dark:text-gray-400">A thoughtful approach</h2>
      <ul class="text-sm">
        <li><a href="/principles" aria-current={isPrinciples ? 'page' : undefined} class="footer-link">Calm design principles</a></li>
        <li><a href="/roadmap" aria-current={isRoadmap ? 'page' : undefined} class="footer-link">Roadmap</a></li>
        <li><button type="button" @click="$dispatch('open-feedback')" class="footer-link cursor-pointer">Send feedback</button></li>
        <li>
          <a href="https://github.com/Corbin-tech/Zen-Frame" target="_blank" rel="noopener noreferrer" class="footer-link gap-1.5">
            Star on GitHub <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="footer-landscape pointer-events-none mx-auto w-full max-w-[100rem] overflow-hidden" aria-hidden="true">
    <FooterLandscape />
  </div>

  <div class="border-t border-gray-900/10 px-6 dark:border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 text-xs leading-relaxed text-gray-600 dark:text-gray-400">
      <p>&copy; {new Date().getFullYear()} {data.siteName} by {data.owner}</p>
      <p class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-warmth-deep dark:bg-warmth" aria-hidden="true"></span>One at a time. At your pace.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: linear-gradient(180deg, transparent, rgb(220 231 220 / 0.28)); }
  :global(.dark) .site-footer { background: linear-gradient(180deg, transparent, rgb(23 63 58 / 0.2)); }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 2px;
    text-align: left;
    text-underline-offset: 4px;
  }
  .footer-link:hover, .footer-link[aria-current='page'] { text-decoration: underline; }
  @media (min-width: 640px) {
    .site-footer > div:first-child { width: calc(100% - 3rem); }
  }
  @media (max-width: 639px) {
    .site-footer > div:first-child { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .footer-intro { grid-column: 1 / -1; }
  }
</style>
