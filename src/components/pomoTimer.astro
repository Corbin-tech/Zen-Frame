---
import TimerFaces from './TimerFaces.astro';

// Minute ticks inside the classic ring
const ringTicks = Array.from({ length: 60 }, (_, m) => {
    const angle = m * Math.PI / 30;
    const inner = m % 5 ? 37.5 : 36;
    return {
        x1: 50 + Math.sin(angle) * inner, y1: 50 - Math.cos(angle) * inner,
        x2: 50 + Math.sin(angle) * 39, y2: 50 - Math.cos(angle) * 39,
        major: m % 5 === 0
    };
});

const panel = 'rounded-2xl bg-white/80 dark:bg-slate-800/70 backdrop-blur-sm shadow-sm ring-1 ring-black/5 dark:ring-white/10';
const segmented = 'inline-flex flex-wrap p-1 rounded-xl bg-gray-900/[0.04] dark:bg-white/[0.06] ring-1 ring-black/5 dark:ring-white/10';
const segment = 'px-3 py-1.5 rounded-lg text-sm font-medium transition-all';
const segmentOn = 'bg-white text-gray-900 shadow-sm ring-1 ring-black/5 dark:bg-white/[0.14] dark:text-white dark:ring-white/10';
const segmentOff = 'text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200';
---

<div
    x-data="{
        baseTitle: document.title,
        get today() {
            const key = this.$dates.toDateKey();
            const sessions = this.$store.pomoState.sessions.filter(session => this.$dates.toDateKey(new Date(session.completedAt)) === key);
            return { count: sessions.length, minutes: sessions.reduce((sum, session) => sum + session.minutes, 0) };
        }
    }"
    x-effect="document.title = $store.pomoState.isRunning ? `${$store.pomoState.digits.slice(0, 2)}:${$store.pomoState.digits.slice(2)} · ${$store.pomoState.isBreak ? 'Break' : 'Focus'} · ${baseTitle}` : baseTitle"
    x-cloak
    class="space-y-6"
>
    <!-- Header -->
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-sm font-medium text-teal-700 dark:text-teal-400">Pomodoro</p>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Focus, then rest</h1>
            <p class="mt-1 text-gray-500 dark:text-gray-400">Work in timed stretches with short breaks between them.</p>
        </div>
        <!-- Length of a work stretch and its break -->
        <div class={segmented} role="group" aria-label="Timer length">
            <button type="button" x-on:click="$store.pomoState.preset !== 'pomodoro' && (!$store.pomoState.started || confirm('Change the timer length? The current timer will start over.')) && $store.pomoState.setPreset('pomodoro')" class={segment} x-bind:class={`$store.pomoState.preset === 'pomodoro' ? '${segmentOn}' : '${segmentOff}'`} x-bind:aria-pressed="$store.pomoState.preset === 'pomodoro'">25 / 5</button>
            <button type="button" x-on:click="$store.pomoState.preset !== 'long' && (!$store.pomoState.started || confirm('Change the timer length? The current timer will start over.')) && $store.pomoState.setPreset('long')" class={segment} x-bind:class={`$store.pomoState.preset === 'long' ? '${segmentOn}' : '${segmentOff}'`} x-bind:aria-pressed="$store.pomoState.preset === 'long'">50 / 10</button>
        </div>
    </header>

    <!-- Timer Display -->
    <div class={`${panel} p-6 sm:p-8 flex flex-col items-center justify-center`}>
        <!-- Focus or break -->
        <div class={`${segmented} mb-6`} role="group" aria-label="Mode">
            <button type="button" x-on:click="$store.pomoState.isBreak && $store.pomoState.toggleBreak()" class={segment} x-bind:class={`!$store.pomoState.isBreak ? '${segmentOn}' : '${segmentOff}'`} x-bind:aria-pressed="!$store.pomoState.isBreak">Focus</button>
            <button type="button" x-on:click="!$store.pomoState.isBreak && $store.pomoState.toggleBreak()" class={segment} x-bind:class={`$store.pomoState.isBreak ? '${segmentOn}' : '${segmentOff}'`} x-bind:aria-pressed="$store.pomoState.isBreak">Break</button>
        </div>

        
        <!-- Timer Circle: the classic face. The others are in TimerFaces.astro, picked in Settings. -->
        <template x-if="$store.settings.timerStyle === 'classic'">
        <div class="relative w-72 h-72 mb-8">
            <!-- Halo that breathes behind the ring while the timer runs -->
            <div
                class="absolute inset-3 rounded-full bg-teal-400/35 dark:bg-teal-400/30 blur-3xl transition-opacity duration-700"
                :class="$store.pomoState.isRunning ? 'opacity-100 classic-breathe' : 'opacity-0'"
                aria-hidden="true"
            ></div>

            <svg class="relative w-full h-full overflow-visible"
                viewBox="0 0 100 100"
                role="progressbar"
                aria-label="Pomodoro progress"
                aria-valuemin="0"
                aria-valuemax="100"
                :aria-valuenow="Math.round($store.pomoState.percentComplete)">
                <defs>
                    <linearGradient id="classic-progress" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="currentColor" class="text-teal-300" />
                        <stop offset="1" stop-color="currentColor" class="text-teal-600" />
                    </linearGradient>
                    <filter id="classic-glow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="2" result="near" />
                        <feGaussianBlur stdDeviation="5" result="far" />
                        <feMerge><feMergeNode in="far" /><feMergeNode in="near" /></feMerge>
                    </filter>
                    <filter id="classic-head-glow" x="-300%" y="-300%" width="700%" height="700%">
                        <feGaussianBlur stdDeviation="2.5" />
                    </filter>
                </defs>

                <!-- Inner disc and minute ticks -->
                <circle cx="50" cy="50" r="40.5" fill="currentColor" class="text-white/50 dark:text-slate-900/20" />
                <g stroke="currentColor" stroke-linecap="round" class="text-gray-300 dark:text-slate-600">
                    {ringTicks.map(tick => <line x1={tick.x1} y1={tick.y1} x2={tick.x2} y2={tick.y2} stroke-width={tick.major ? 0.8 : 0.35} />)}
                </g>

                <!-- Track -->
                <circle
                    cx="50" cy="50" r="45"
                    fill="transparent"
                    stroke="currentColor"
                    stroke-width="6"
                    class="text-gray-200 dark:text-slate-700"
                />

                <g transform="rotate(-90 50 50)">
                    <!-- Glow under the progress arc -->
                    <circle
                        cx="50" cy="50" r="45"
                        fill="transparent"
                        stroke="currentColor"
                        stroke-width="8"
                        stroke-linecap="round"
                        stroke-dasharray="282.74"
                        filter="url(#classic-glow)"
                        class="text-teal-400 transition-opacity duration-500"
                        :stroke-dashoffset="282.74 - (282.74 * $store.pomoState.percentComplete) / 100"
                        :opacity="$store.pomoState.isRunning ? 1 : 0"
                    />
                    <!-- Progress Circle -->
                    <circle
                        cx="50" cy="50" r="45"
                        fill="transparent"
                        stroke-width="6"
                        stroke-linecap="round"
                        stroke-dasharray="282.74"
                        :stroke-dashoffset="282.74 - (282.74 * $store.pomoState.percentComplete) / 100"
                        :stroke="$store.pomoState.isRunning ? 'url(#classic-progress)' : 'currentColor'"
                        class="text-gray-500 dark:text-gray-400"
                    />
                </g>

                <!-- Bright head at the leading edge of the arc -->
                <g :transform="`rotate(${3.6 * $store.pomoState.percentComplete} 50 50)`">
                    <circle cx="50" cy="5" r="4" fill="currentColor" class="text-teal-300" filter="url(#classic-head-glow)" :opacity="$store.pomoState.isRunning ? 1 : 0" />
                    <circle cx="50" cy="5" r="2.1" fill="currentColor" :class="$store.pomoState.isRunning ? 'text-white' : 'text-gray-100 dark:text-gray-300'" />
                </g>
            </svg>
            
            <!-- Timer Text -->
            <div class="absolute top-0 left-0 w-full h-full flex flex-col items-center justify-center">
                <div
                    class="text-6xl font-mono font-bold tabular-nums text-gray-800 dark:text-white transition-[text-shadow] duration-500"
                    :class="$store.pomoState.isRunning && 'classic-text-glow'"
                >
                    <span class="transition-[color] duration-300 ease-in-out" x-text="Math.floor($store.pomoState.timeLeft / 60).toString().padStart(2, '0')"></span><span class="transition-[color] duration-300 ease-in-out" :class="$store.pomoState.isRunning && $store.pomoState.timeLeft % 2 && 'opacity-40'">:</span><span class="transition-[color] duration-300 ease-in-out" x-text="($store.pomoState.timeLeft % 60).toString().padStart(2, '0')"></span>
                </div>
                <div class="mt-1 text-md font-medium text-gray-600 dark:text-gray-300 transition-[color] duration-300 ease-in-out" x-text="$store.pomoState.currentPresetName"></div>
            </div>
        </div>
        </template>
        <TimerFaces />
        
        <!-- Timer Controls -->
        <div class="flex justify-center gap-3">
            <button
              @click="$store.pomoState.isRunning ? $store.pomoState.pauseTimer() : $store.pomoState.startTimer()"
              class="min-w-[7rem] px-6 py-2.5 text-base font-semibold text-white bg-teal-600 hover:bg-teal-700 rounded-lg shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-800 transition-colors"
            >
              <span x-text="$store.pomoState.status === 'running' ? 'Pause' : $store.pomoState.status === 'paused' ? 'Resume' : 'Start'"></span>
            </button>
            
            <button 
                type="button"
                @click="if (confirm('Are you sure you want to reset the current timer?')) { $store.pomoState.resetTimer() }"
                x-bind:disabled="!$store.pomoState.started"
                class="inline-flex items-center px-4 py-2.5 text-sm font-medium rounded-lg ring-1 bg-white text-gray-700 ring-black/10 hover:bg-gray-50 dark:bg-slate-800 dark:text-gray-200 dark:ring-white/10 dark:hover:bg-slate-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 disabled:opacity-40 disabled:pointer-events-none"
            >
                <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Reset
                </div>
            </button>
        </div>

        <p class="mt-4 hidden sm:block text-xs text-gray-500 dark:text-gray-400">
            Press <kbd class="px-1.5 py-0.5 rounded font-sans font-medium ring-1 ring-black/10 dark:ring-white/15">Space</kbd> to start or pause
        </p>

        <!-- Focus finished today -->
        <p class="mt-6 pt-4 w-full text-center text-sm text-gray-600 dark:text-gray-300 border-t border-black/5 dark:border-white/10"
            x-text="today.count ? `${today.count} focus ${today.count === 1 ? 'session' : 'sessions'} today · ${$dates.formatDuration(today.minutes)}` : 'No focus sessions finished yet today'"></p>
    </div>
</div>

<style is:global>
    .classic-breathe { animation: classic-breathe 4s ease-in-out infinite; }
    @keyframes classic-breathe {
        0%, 100% { transform: scale(0.94); opacity: 0.7; }
        50% { transform: scale(1.04); opacity: 1; }
    }
    .classic-text-glow { text-shadow: 0 0 22px rgb(var(--accent-400) / 0.55); }
    @media (prefers-reduced-motion: reduce) {
        .classic-breathe { animation: none; }
    }
</style>

<script>
    document.addEventListener('alpine:init', () => {
        // One card of the flip face. Each change of value flips the top flap down to show it.
        Alpine.data('flipCard', () => ({
            current: '',
            previous: '',
            flipping: false,
            timeout: null,

            flipTo(value) {
                if (value === this.current) return;
                if (!this.current) {
                    this.current = value;
                    return;
                }
                this.previous = this.current;
                this.current = value;
                this.flipping = true;
                // Restart the flap animation, even if the last flip hasn't finished
                this.$el.classList.remove('tf-flipping');
                this.$el.offsetWidth;
                this.$el.classList.add('tf-flipping');
                clearTimeout(this.timeout);
                this.timeout = setTimeout(() => {
                    this.flipping = false;
                    this.$el.classList.remove('tf-flipping');
                }, 600);
            }
        }));
    });
</script>
