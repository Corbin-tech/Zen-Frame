new file mode 100644
index 0000000..b0a1672
--- /dev/null
+++ b/src/lib/assist/prompts.ts
@@ -0,0 +1,93 @@
+
+// Prompts and JSON Schemas for the on-device model. The schema goes in `responseConstraint`,
+// so the model can only answer in this shape. sanitize.ts still checks every answer.
+//
+// Tone rules for every prompt, chosen for ADHD and autistic users:
+// - Literal, concrete wording. No idioms, jokes, or vague verbs like "handle" or "deal with".
+// - Each step starts with a physical verb and names one thing to do.
+// - No judgment or motivational filler.
+
+export const SYSTEM_PROMPT = [
+  "You help people with ADHD and autism turn tasks into clear, concrete actions.",
+  "Write in plain, literal language. Start each item with a verb. One action per item.",
+  "Do not add advice, encouragement, or commentary. Answer only in the requested JSON."
+].join(" ");
+
+interface Level {
+  min: number;
+  max: number;
+}
+
+export function breakdownPrompt(task: string, level: Level, context: string): string {
+  const count = level.min === level.max ? `${level.min}` : `between ${level.min} and ${level.max}`;
+  return [
+    `Split this task into ${count} steps, in the order they are done.`,
+    "Give each step a realistic estimate in minutes.",
+    context ? `It belongs to a group called "${context}".` : "",
+    `Task: ${task}`
+  ].filter(Boolean).join("\n");
+}
+
+export function compilePrompt(dump: string): string {
+  return [
+    "This is a brain dump: unsorted thoughts, worries, and to-dos.",
+    "Pull out every actionable task. Rewrite each as a short action that starts with a verb.",
+    "Group related tasks into a few clusters with short names (1 to 3 words).",
+    "Skip feelings and notes that have no action. Give each task an estimate in minutes.",
+    "Brain dump:",
+    dump
+  ].join("\n");
+}
+
+export function estimatePrompt(task: string): string {
+  return [
+    "Estimate how long this task takes a person who gets distracted easily, including setup and switching time.",
+    "Give a best guess plus a low and high value, all in minutes.",
+    `Task: ${task}`
+  ].join("\n");
+}
+
+const minutes = { type: "integer", minimum: 1, maximum: 480 };
+const item = {
+  type: "object",
+  properties: { text: { type: "string", maxLength: 200 }, minutes },
+  required: ["text", "minutes"],
+  additionalProperties: false
+};
+
+export function breakdownSchema(level: Level) {
+  return {
+    type: "object",
+    properties: { steps: { type: "array", items: item, minItems: level.min, maxItems: level.max } },
+    required: ["steps"],
+    additionalProperties: false
+  };
+}
+
+export const COMPILE_SCHEMA = {
+  type: "object",
+  properties: {
+    clusters: {
+      type: "array",
+      maxItems: 12,
+      items: {
+        type: "object",
+        properties: {
+          name: { type: "string", maxLength: 60 },
+          tasks: { type: "array", items: item, minItems: 1, maxItems: 25 }
+        },
+        required: ["name", "tasks"],
+        additionalProperties: false
+      }
+    }
+  },
+  required: ["clusters"],
+  additionalProperties: false
+};
+
+export const ESTIMATE_SCHEMA = {
+  type: "object",
+  properties: { minutes, low: minutes, high: minutes },
+  required: ["minutes", "low", "high"],
+  additionalProperties: false
+};
diff --git a/src/lib/assist/sanitize.ts b/src/lib/assist/sanitize.ts
new file mode 100644
index 0000000..9c08fe5
--- /dev/null
+++ b/src/lib/assist/sanitize.ts
@@ -0,0 +1,75 @@
+import type { BreakdownResult, CompileResult, EstimateResult, StepSuggestion } from "./types";
+
+// Model output is untrusted input, just like an imported backup. Everything a provider returns
+// goes through these before the UI shows it or the store saves it. Templates must still render
+// it with x-text, never x-html.
+
+const MAX_TEXT = 200;
+const MAX_STEPS = 12;
+const MAX_CLUSTERS = 12;
+const MAX_TASKS_PER_CLUSTER = 25;
+export const MAX_MINUTES = 8 * 60;
+
+// Trims, collapses whitespace, strips control characters and list markers, and caps the length
+export function cleanText(value: unknown, max = MAX_TEXT): string {
+  if (typeof value !== "string") return "";
+  return value
+    .replace(/[\u0000-\u001f\u007f]/g, " ")
+    .replace(/^\s*(?:[-*•]|\d+[.)])\s+/, "")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, max);
+}
+
+export function cleanMinutes(value: unknown): number | null {
+  const minutes = typeof value === "number" ? value : Number.parseFloat(String(value));
+  if (!Number.isFinite(minutes) || minutes <= 0) return null;
+  return Math.min(MAX_MINUTES, Math.max(1, Math.round(minutes)));
+}
+
+function parse(raw: unknown): unknown {
+  if (typeof raw !== "string") return raw;
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+}
+
+function cleanSteps(list: unknown, cap: number): StepSuggestion[] {
+  if (!Array.isArray(list)) return [];
+  return list
+    .map(item => typeof item === "string"
+      ? { text: cleanText(item), minutes: null }
+      : { text: cleanText(item?.text), minutes: cleanMinutes(item?.minutes) })
+    .filter(step => step.text)
+    .slice(0, cap);
+}
+
+export function cleanBreakdown(raw: unknown): BreakdownResult {
+  const data = parse(raw) as { steps?: unknown } | null;
+  return { steps: cleanSteps(data?.steps, MAX_STEPS) };
+}
+
+export function cleanCompile(raw: unknown): CompileResult {
+  const data = parse(raw) as { clusters?: unknown } | null;
+  const clusters = Array.isArray(data?.clusters) ? data.clusters : [];
+  return {
+    clusters: clusters
+      .map(cluster => ({
+        name: cleanText(cluster?.name, 60) || "Tasks",
+        tasks: cleanSteps(cluster?.tasks, MAX_TASKS_PER_CLUSTER)
+      }))
+      .filter(cluster => cluster.tasks.length)
+      .slice(0, MAX_CLUSTERS)
+  };
+}
+
+export function cleanEstimate(raw: unknown): EstimateResult | null {
+  const data = parse(raw) as { minutes?: unknown; low?: unknown; high?: unknown } | null;
+  const minutes = cleanMinutes(data?.minutes);
+  if (!minutes) return null;
+  const low = Math.min(minutes, cleanMinutes(data?.low) ?? minutes);
+  const high = Math.max(minutes, cleanMinutes(data?.high) ?? minutes);
+  return { minutes, low, high };
+}
diff --git a/src/lib/assist/types.ts b/src/lib/assist/types.ts
