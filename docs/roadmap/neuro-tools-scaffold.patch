@@ -0,0 +1,16 @@
+import { createChromeProvider } from "./chromeProvider";
+import { createLocalProvider } from "./localProvider";
+import type { AssistProvider, ProviderStatus } from "./types";
+
+export * from "./types";
+
+// Picks the provider: Chrome's on-device model only when it's already on the device,
+// otherwise the rules. Never starts a model download. Both keep every word on the device.
+// A paid cloud provider can slot in here later behind the same interface (docs/neuro-tools-plan.md).
+export async function pickProvider(): Promise<{ provider: AssistProvider; chromeStatus: ProviderStatus }> {
+  const chrome = createChromeProvider();
+  const chromeStatus = await chrome.status();
+  return { provider: chromeStatus === "ready" ? chrome : createLocalProvider(), chromeStatus };
+}
+
+export { createChromeProvider, createLocalProvider };
diff --git a/src/lib/assist/localProvider.ts b/src/lib/assist/localProvider.ts
new file mode 100644
index 0000000..255dac3
--- /dev/null
+++ b/src/lib/assist/localProvider.ts
@@ -0,0 +1,106 @@
+import { cleanText } from "./sanitize";
+import { detailLevel, type AssistProvider, type CompiledCluster, type EstimateResult, type StepSuggestion } from "./types";
+
+// The offline fallback: plain rules, no model. It runs in every browser, including Firefox,
+// Safari, and phones, where Chrome's built-in model is missing. Brain dump and Estimate work
+// well from rules; Breakdown can only give a generic structure, so the UI should say so.
+
+// Keyword buckets for grouping brain-dump lines. First match wins; the rest go to "Other".
+const CLUSTER_KEYWORDS: Array<[string, RegExp]> = [
+  ["Work", /\b(work|boss|meeting|report|deadline|client|email|slack|project|presentation|invoice)\b/i],
+  ["School", /\b(class|homework|essay|study|exam|assignment|lecture|professor|quiz)\b/i],
+  ["Home", /\b(clean|laundry|dishes|vacuum|tidy|trash|bed|kitchen|bathroom|fix|repair)\b/i],
+  ["Errands", /\b(buy|shop|groceries|pick up|drop off|return|store|post office|pharmacy)\b/i],
+  ["Health", /\b(doctor|dentist|meds?|medicine|therapy|gym|workout|walk|sleep|appointment)\b/i],
+  ["Money", /\b(pay|bill|rent|bank|budget|tax|taxes|refund|subscription)\b/i],
+  ["People", /\b(call|text|mom|dad|friend|birthday|gift|reply|message|visit)\b/i]
+];
+
+// Rough minutes for common kinds of task, checked in order
+const MINUTE_HINTS: Array<[RegExp, number]> = [
+  [/\b(text|reply|message|book|schedule|order)\b/i, 10],
+  [/\b(email|call|pay|bill)\b/i, 15],
+  [/\b(dishes|tidy|trash|laundry|pick up|drop off)\b/i, 20],
+  [/\b(groceries|shop|clean|cook|workout|gym)\b/i, 45],
+  [/\b(essay|report|presentation|study|homework|taxes)\b/i, 90]
+];
+const DEFAULT_MINUTES = 25;
+
+// Lines that describe a feeling rather than an action
+const NOT_ACTIONABLE = /^(i feel|i'm (so )?(tired|stressed|anxious|worried)|ugh|why|maybe someday)\b/i;
+
+export function guessMinutes(task: string): number {
+  return MINUTE_HINTS.find(([pattern]) => pattern.test(task))?.[1] ?? DEFAULT_MINUTES;
+}
+
+export function rangeFor(minutes: number): EstimateResult {
+  // People with ADHD tend to underestimate, so the range leans long
+  return { minutes, low: Math.max(1, Math.round(minutes * 0.75)), high: Math.round(minutes * 1.75) };
+}
+
+// Splits on new lines, bullets, semicolons, and sentence ends, then on "and then"
+export function splitDump(dump: string): string[] {
+  return dump
+    .split(/\n|;|(?<=[.!?])\s+|\s+(?:and then|then|also)\s+/i)
+    .map(line => cleanText(line)
+      .replace(/^(?:i\s+)?(?:really\s+)?(?:need to|have to|gotta|must|should)\s+/i, "")
+      .replace(/[.!]+$/, ""))
+    .map(line => line.charAt(0).toUpperCase() + line.slice(1))
+    .filter(line => line.length > 2 && !NOT_ACTIONABLE.test(line));
+}
+
+const GENERIC_STEPS = [
+  "Get everything you need for this in one place",
+  "Do the first small part",
+  "Do the main part",
+  "Check the result",
+  "Put things away",
+  "Set a timer for 5 minutes and clear your space",
+  "Write down where you stopped",
+  "Take a 2-minute break",
+  "Do the last part",
+  "Mark it done"
+];
+
+// Generic structure by level: the order matters, so the short levels keep the key steps
+const STEP_ORDER: Record<string, number[]> = {
+  few: [1, 2, 3],
+  some: [0, 1, 2, 3],
+  five: [0, 1, 2, 3, 4],
+  many: [5, 0, 1, 6, 7, 2, 8, 3, 4, 9]
+};
+
+export function createLocalProvider(): AssistProvider {
+  return {
+    id: "rules",
+
+    async status() {
+      return "ready";
+    },
+
+    async breakdown(task, levelId) {
+      const level = detailLevel(levelId);
+      const total = guessMinutes(task);
+      const order = STEP_ORDER[level.id].slice(0, level.max);
+      const steps: StepSuggestion[] = order.map(index => ({
+        text: GENERIC_STEPS[index],
+        minutes: Math.max(2, Math.round(total / order.length))
+      }));
+      return { steps };
+    },
+
+    async compile(dump) {
+      const groups = new Map<string, CompiledCluster>();
+      for (const text of splitDump(dump)) {
+        const name = CLUSTER_KEYWORDS.find(([, pattern]) => pattern.test(text))?.[0] ?? "Other";
+        if (!groups.has(name)) groups.set(name, { name, tasks: [] });
+        groups.get(name).tasks.push({ text, minutes: guessMinutes(text) });
+      }
+      return { clusters: [...groups.values()] };
+    },
+
+    async estimate(task) {
+      return rangeFor(guessMinutes(task));
+    }
+  };
+}
